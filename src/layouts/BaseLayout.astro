---
/**
 * Carcasa comună a tuturor paginilor (CLAUDE.md §4, §6, §9).
 * Ordinea: SkipLink → Header (navbar fix, transparent) → <main id="continut"> → Footer →
 * BaraActiuni → Cursor. În <head>, CapPagina pune clasele de mișcare înainte de primul paint.
 * <main> și <footer> au data-tema-sectiune="light"; secțiunile închise din pagini își declară
 * tema (Hero, Sectiune ton="inchis"), ca navbar-ul să-și schimbe culoarea deasupra lor.
 * Intro-ul cu semnătura (IntroSemnatura) apare o dată pe sesiune, pe orice pagină de intrare
 * (CapPagina în modul „automat”; /stil/ folosește „manual”). Fără JS și la mișcare redusă nu apare.
 */
import '../styles/global.css';
import Breadcrumbs, { type Firimitura } from '../components/Breadcrumbs.astro';
import BaraActiuni from '../components/BaraActiuni.astro';
import CapPagina from '../components/CapPagina.astro';
import Cursor from '../components/Cursor.astro';
import IntroSemnatura from '../components/IntroSemnatura.astro';
import DraftBadge from '../components/DraftBadge.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLdBirou from '../components/JsonLdBirou.astro';
import Seo from '../components/Seo.astro';
import SkipLink from '../components/SkipLink.astro';
import type { Locale } from '../i18n';
import { getBirou } from '../lib/continut';
import type { ImagineOg } from '../lib/og';
import { culoare } from '../lib/tokens';
// Preload doar pentru fontul de text, subsetul latin (folosit la primul paint de orice pagină).
import fontTextLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import { url } from '../lib/url';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Pagina conține text neaprobat: în preview apare eticheta „Text propus – în curs de validare”. */
  draft?: boolean;
  breadcrumbs?: Firimitura[];
  /** Pagină care nu se indexează în niciun mod (ex. 404). */
  noindex?: boolean;
  /** og:image, dacă nu e cea implicită (ex. fotografia din hero pe Acasă). */
  imagineOg?: ImagineOg;
  /**
   * Tema navbar-ului la încărcare: cea a secțiunii de sus a paginii (ex. „dark” pe Acasă, peste
   * hero). Corectă de la primul paint, fără să aștepte JS; apoi o actualizează tema-navbar.ts.
   */
  temaNavbar?: 'light' | 'dark';
  /** Pornirea intro-ului: o dată pe sesiune (implicit) sau doar manual (ghidul /stil/). */
  intro?: 'automat' | 'manual';
}

const { locale, title, description, draft = false, breadcrumbs, noindex = false, imagineOg, temaNavbar = 'light', intro = 'automat' } = Astro.props;
const birou = await getBirou();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <CapPagina intro={intro} />
    <meta name="theme-color" content={culoare('c-brand-900')} />
    <link rel="preload" href={fontTextLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <Seo
      locale={locale}
      title={title}
      description={description}
      numeSite={birou.denumire}
      notar={birou.notar}
      noindex={noindex}
      imagine={imagineOg}
    />
    <JsonLdBirou birou={birou} />
    {/* Date structurate și alte elemente specifice paginii (ex. <JsonLd slot="head" />). */}
    <slot name="head" />
  </head>
  <body>
    <IntroSemnatura />
    <SkipLink locale={locale} />
    <Header locale={locale} birou={birou} tema={temaNavbar} />
    <main id="continut" tabindex="-1" data-tema-sectiune="light">
      {
        (breadcrumbs || draft) && (
          <div class="container carcasa__sus">
            {breadcrumbs && <Breadcrumbs locale={locale} elemente={breadcrumbs} />}
            <DraftBadge locale={locale} draft={draft} />
          </div>
        )
      }
      <slot />
    </main>
    <Footer locale={locale} birou={birou} />
    <BaraActiuni locale={locale} birou={birou} />
    <Cursor />
  </body>
</html>

<script>
  import { INTEROGARE_MISCARE } from '../scripts/miscare-interogare';

  /*
   * Mișcarea (GSAP) se încarcă doar când e permisă: la mișcare redusă nu se descarcă deloc.
   * Dacă preferința se schimbă cu pagina deschisă, se încarcă atunci.
   */
  const miscare = matchMedia(INTEROGARE_MISCARE);
  let incarcata = false;
  const incarca = () => {
    if (incarcata || !miscare.matches) return;
    incarcata = true;
    void import('../scripts/miscare').then((m) => m.pornesteMiscarea());
  };
  incarca();
  miscare.addEventListener('change', incarca);
</script>
