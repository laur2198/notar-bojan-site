---
/**
 * Carcasa comună a tuturor paginilor (CLAUDE.md §4, §6, §9).
 * Ordinea: SkipLink → Header → <main id="continut"> → Footer → BaraActiuni.
 */
import '../styles/global.css';
import Breadcrumbs, { type Firimitura } from '../components/Breadcrumbs.astro';
import BaraActiuni from '../components/BaraActiuni.astro';
import DraftBadge from '../components/DraftBadge.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import SkipLink from '../components/SkipLink.astro';
import type { Locale } from '../i18n';
import { getBirou } from '../lib/continut';
import { culoare } from '../lib/tokens';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Pagina conține text neaprobat: în preview apare eticheta „Text propus – în curs de validare”. */
  draft?: boolean;
  breadcrumbs?: Firimitura[];
}

const { locale, title, description, draft = false, breadcrumbs } = Astro.props;
const birou = await getBirou();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={culoare('c-brown-800')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo locale={locale} title={title} description={description} numeSite={birou.denumire} />
  </head>
  <body>
    <SkipLink locale={locale} />
    <Header locale={locale} birou={birou} />
    <main id="continut" tabindex="-1">
      {
        (breadcrumbs || draft) && (
          <div class="container carcasa__sus">
            {breadcrumbs && <Breadcrumbs locale={locale} elemente={breadcrumbs} />}
            <DraftBadge locale={locale} draft={draft} />
          </div>
        )
      }
      <slot />
    </main>
    <Footer locale={locale} birou={birou} />
    <BaraActiuni locale={locale} birou={birou} />
  </body>
</html>
