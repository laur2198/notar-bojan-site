---
/**
 * /confidentialitate/ (V4): AntetPagina simplă (fără fotografie, fundal viu discret; lead = data
 * actualizării), cuprinsul generat din titlurile h2 (sticky pe desktop) și textul în coloana de
 * lectură, cu titlurile pe --fs-titlu. Fără CtaFinal. Nota de lucru de la început (blockquote-ul „Text propus…”) apare doar în
 * preview; în producție nu apare deloc în HTML (ContinutMarcat `faraNotaDeLucru`).
 */
import { getEntry, render } from 'astro:content';
import AntetPagina from '../components/AntetPagina.astro';
import ContinutMarcat from '../components/ContinutMarcat.astro';
import DraftBadge from '../components/DraftBadge.astro';
import SectiunePagina from '../components/SectiunePagina.astro';
import { caleLogica, formateazaZiLuna, t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { areMarcaj, estePreview } from '../lib/continut';
import { url } from '../lib/url';

const locale = 'ro';
const pagina = await getEntry('pagini', 'ro/confidentialitate');
if (!pagina) throw new Error('Lipsește src/content/pagini/ro/confidentialitate.md.');
const { Content, headings } = await render(pagina);
const cuprins = headings.filter((h) => h.depth === 2);

const actualizat = pagina.data.actualizat;
const dataAfisata =
  actualizat && !areMarcaj(actualizat) ? `${formateazaZiLuna(locale, actualizat)} ${actualizat.slice(0, 4)}` : actualizat;
const firimituri = [{ eticheta: t(locale, 'breadcrumbs.acasa'), href: url(caleLogica('acasa', locale)) }, { eticheta: pagina.data.titlu }];
---

<BaseLayout locale={locale} title={t(locale, 'pagina.seoTitlu', { titlu: pagina.data.titlu })} description={pagina.data.seoDescriere}>
  <AntetPagina
    locale={locale}
    titlu={pagina.data.titlu}
    lead={dataAfisata ? t(locale, 'doc.actualizat', { data: dataAfisata }) : undefined}
    breadcrumbs={firimituri}
    intensitate="discret"
  >
    <DraftBadge locale={locale} intrare={pagina} />
  </AntetPagina>

  <SectiunePagina eticheta={pagina.data.titlu}>
    <div class="document__grila">
      {
        cuprins.length > 0 && (
          <nav class="cuprins" aria-labelledby="cuprins-titlu">
            <h2 id="cuprins-titlu" class="cuprins__titlu">{t(locale, 'doc.cuprins')}</h2>
            <ol class="cuprins__lista">
              {cuprins.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="continut-articol document__text">
        <ContinutMarcat faraNotaDeLucru={!estePreview}><Content /></ContinutMarcat>
      </div>
    </div>
  </SectiunePagina>
</BaseLayout>

<style>
  .document__grila {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 64rem) {
    .document__grila {
      grid-template-columns: 18rem minmax(0, 1fr);
      align-items: start;
      gap: var(--space-6);
    }

    .cuprins {
      position: sticky;
      top: calc(var(--h-antet) + var(--space-3));
    }
  }

  /* Cuprinsul: paper-2, linia roșie sus (ca CasetaDosar). */
  .cuprins {
    padding: var(--space-3);
    background: var(--c-paper-2);
    border-top: 3px solid var(--c-rosu);
    border-radius: var(--radius);
  }

  .cuprins__titlu {
    font-size: var(--fs-base);
  }

  .cuprins__lista {
    display: grid;
    gap: 0;
    margin-top: var(--space-1);
    padding-left: var(--space-3);
  }

  .cuprins__lista li {
    max-width: none;
  }

  .cuprins__lista a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--fs-sm);
  }
</style>
