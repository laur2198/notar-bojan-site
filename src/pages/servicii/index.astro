---
/**
 * /servicii/ (V4): AntetPagina (lead-ul trimite la Ordinul MJ nr. 177/C/2024, fără sume: CLAUDE.md
 * §3.3–3.4, text din i18n), toate serviciile în ListaNumerotata (varianta mare, cu fotografiile și
 * etichetele lor, ca pe Acasă) și CtaFinal.
 */
import { getCollection, getEntry } from 'astro:content';
import AntetPagina from '../../components/AntetPagina.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import DraftBadge from '../../components/DraftBadge.astro';
import ListaNumerotata from '../../components/ListaNumerotata.astro';
import SectiunePagina from '../../components/SectiunePagina.astro';
import { cale, caleLogica, t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { esteDraft, getBirou } from '../../lib/continut';
import { url } from '../../lib/url';

const locale = 'ro';
const [acasa, birou] = await Promise.all([getEntry('acasa', 'ro/acasa'), getBirou()]);
if (!acasa) throw new Error('Lipsește src/content/pagini/ro/acasa.yaml.');

const servicii = (await getCollection('servicii')).sort((a, b) => a.data.ordine - b.data.ordine);
const titlu = t(locale, 'servicii.titlu');
const firimituri = [{ eticheta: t(locale, 'breadcrumbs.acasa'), href: url(caleLogica('acasa', locale)) }, { eticheta: titlu }];
---

<BaseLayout locale={locale} title={t(locale, 'servicii.seoTitlu')} description={t(locale, 'servicii.seoDescriere')}>
  <AntetPagina locale={locale} titlu={titlu} lead={t(locale, 'servicii.intro')} breadcrumbs={firimituri}>
    <DraftBadge locale={locale} draft={servicii.some((s) => esteDraft(s))} />
  </AntetPagina>

  <SectiunePagina viu={2} eticheta={titlu}>
    {/* Serviciile sunt primul nivel de conținut sub h1, deci titlurile lor sunt h2. */}
    <ListaNumerotata
      locale={locale}
      varianta="mare"
      nivel="h2"
      prefix="serviciu"
      elemente={servicii.map(({ data: s }) => ({
        titlu: s.titlu,
        text: s.rezumat,
        href: `${cale('servicii', locale)}${s.slug}/`,
        etichete: s.etichete,
        imagine: s.imagine,
        imagineAlt: s.imagineAlt,
        provizorie: s.fotoProvizorie,
      }))}
    />
  </SectiunePagina>

  <CtaFinal locale={locale} birou={birou} titlu={acasa.data.final.titlu} subtitlu={acasa.data.final.text} />
</BaseLayout>
