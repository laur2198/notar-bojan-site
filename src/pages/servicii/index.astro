---
/**
 * /servicii/ – Servicii: toate serviciile (grila de pe Acasă) și CTA.
 * Fără onorarii, sume sau tabele de prețuri (CLAUDE.md §3.3, Codul deontologic): lead-ul paginii
 * spune doar că onorariile se stabilesc conform Ordinului MJ nr. 177/C/2024 (text din i18n).
 */
import { getCollection, getEntry } from 'astro:content';
import BandaTitlu from '../../components/BandaTitlu.astro';
import DraftBadge from '../../components/DraftBadge.astro';
import GrilaServicii from '../../components/GrilaServicii.astro';
import SectiuneCta from '../../components/SectiuneCta.astro';
import Sectiune from '../../components/Sectiune.astro';
import { t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { esteDraft, getBirou, marcheazaPlaceholder } from '../../lib/continut';

const locale = 'ro';
const [acasa, birou] = await Promise.all([getEntry('acasa', 'ro/acasa'), getBirou()]);
if (!acasa) throw new Error('Lipsește src/content/pagini/ro/acasa.yaml.');

const servicii = (await getCollection('servicii')).sort((a, b) => a.data.ordine - b.data.ordine);
const carduri = servicii.map((s) => s.data);
---

<BaseLayout locale={locale} title={t(locale, 'servicii.seoTitlu')} description={t(locale, 'servicii.seoDescriere')}>
  <BandaTitlu locale={locale} titlu={t(locale, 'servicii.titlu')} leadHtml={marcheazaPlaceholder(t(locale, 'servicii.intro'))}>
    <DraftBadge locale={locale} draft={servicii.some((s) => esteDraft(s))} />
  </BandaTitlu>

  <Sectiune>
    {/* Cardurile sunt primul nivel de conținut sub h1, deci titlurile lor sunt h2. */}
    <GrilaServicii locale={locale} servicii={carduri} nivel="h2" />
  </Sectiune>

  <SectiuneCta locale={locale} birou={birou} titlu={acasa.data.final.titlu} text={acasa.data.final.text} />
</BaseLayout>
