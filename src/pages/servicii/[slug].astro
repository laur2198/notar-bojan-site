---
/**
 * /servicii/[slug]/ – pagina unui serviciu (etapa 4). Câte o pagină pentru fiecare fișier din
 * src/content/servicii/ro/ (un serviciu nou adăugat din CMS primește automat pagină).
 *
 * Structura (V4): AntetPagina (breadcrumbs, h1, lead = „pentru cine”, fotografia serviciului);
 * conținutul (Ce este / Cum decurge / Bine de știut) în coloana de lectură, cu fundal viu discret,
 * și caseta „Pregătiți dosarul” în coloana laterală, sticky pe desktop, sub conținut pe mobil;
 * „Alte servicii” în ListaNumerotata; CtaFinal. JSON-LD: BreadcrumbList și Service (neschimbate).
 *
 * TODO: întrebările din faq/ro.yaml care privesc serviciul nu se leagă automat. Dacă biroul
 * vrea, se poate adăuga în schema serviciilor un câmp opțional cu întrebările alese manual.
 */
import { getCollection, getEntry, render } from 'astro:content';
import AntetPagina from '../../components/AntetPagina.astro';
import ContinutMarcat from '../../components/ContinutMarcat.astro';
import CasetaDosar from '../../components/CasetaDosar.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import DraftBadge from '../../components/DraftBadge.astro';
import JsonLd from '../../components/JsonLd.astro';
import ListaNumerotata from '../../components/ListaNumerotata.astro';
import SectiunePagina from '../../components/SectiunePagina.astro';
import { cale, caleLogica, t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBirou } from '../../lib/continut';
import { breadcrumbList, idBirou, serviciu as serviciuJsonLd } from '../../lib/jsonld';
import { cheieTitluSeo, serviciiVecine } from '../../lib/servicii';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const servicii = await getCollection('servicii');
  return servicii.map((intrare) => ({ params: { slug: intrare.data.slug }, props: { intrare } }));
}

const locale = 'ro';
const { intrare } = Astro.props;
const s = intrare.data;
const { Content } = await render(intrare);
const [birou, acasa, toate] = await Promise.all([getBirou(), getEntry('acasa', 'ro/acasa'), getCollection('servicii')]);
if (!acasa) throw new Error('Lipsește src/content/pagini/ro/acasa.yaml.');

const caleServicii = caleLogica('servicii', locale);
const caleaPaginii = `${caleServicii}${s.slug}/`;
const vecine = serviciiVecine(
  toate.map((x) => x.data),
  s.slug,
);

// Breadcrumbs: căi cu bază pentru linkuri; adrese absolute pentru JSON-LD.
const site = Astro.site ?? new URL(Astro.url.origin);
const absolut = (cale: string) => new URL(url(cale), site).href;
const firimituri = [
  { eticheta: t(locale, 'breadcrumbs.acasa'), cale: caleLogica('acasa', locale) },
  { eticheta: t(locale, 'servicii.titlu'), cale: caleServicii },
  { eticheta: s.titlu, cale: caleaPaginii },
];
const jsonld = [
  breadcrumbList(firimituri.map((f) => ({ nume: f.eticheta, url: absolut(f.cale) }))),
  serviciuJsonLd({
    nume: s.titlu,
    descriere: s.rezumat,
    url: absolut(caleaPaginii),
    idBirou: idBirou(absolut(caleLogica('acasa', locale))),
    zona: birou.adresa.oras,
  }),
];
---

<BaseLayout locale={locale} title={t(locale, cheieTitluSeo(s.titlu), { titlu: s.titlu })} description={s.rezumat}>
  <JsonLd date={jsonld} slot="head" />
  <AntetPagina
    locale={locale}
    titlu={s.titlu}
    lead={s.pentruCine}
    breadcrumbs={firimituri.map((f, i) => ({ eticheta: f.eticheta, href: i < firimituri.length - 1 ? url(f.cale) : undefined }))}
    fotografie
    imagine={s.imagine}
    imagineAlt={s.imagineAlt}
    provizorie={s.fotoProvizorie}
  >
    <DraftBadge locale={locale} intrare={intrare} />
  </AntetPagina>

  <SectiunePagina viu={3} eticheta={s.titlu}>
    <div class="serviciu__grila">
      <div class="serviciu__continut continut-articol">
        <ContinutMarcat><Content /></ContinutMarcat>
      </div>
      <div class="serviciu__caseta" data-caseta-dosar>
        <CasetaDosar
          locale={locale}
          birou={birou}
          durata={s.durata}
          onorariu={s.onorariu}
          acte={s.acteNecesare}
          subiectEmail={s.subiectEmail}
        />
      </div>
    </div>
  </SectiunePagina>

  {
    vecine.length > 0 && (
      <SectiunePagina id="alte-servicii" ton="paper-2" titlu={t(locale, 'servicii.altele')}>
        <ListaNumerotata
          locale={locale}
          prefix="alte"
          elemente={vecine.map((v) => ({
            titlu: v.titlu,
            text: v.rezumat,
            href: `${cale('servicii', locale)}${v.slug}/`,
            imagine: v.imagine,
            imagineAlt: v.imagineAlt,
            provizorie: v.fotoProvizorie,
          }))}
        />
      </SectiunePagina>
    )
  }

  <CtaFinal locale={locale} birou={birou} titlu={acasa.data.final.titlu} subtitlu={acasa.data.final.text} />
</BaseLayout>

<style>
  .serviciu__grila {
    display: grid;
    gap: var(--space-5);
  }

  /*
   * Desktop: conținutul în coloana de lectură, caseta în coloana laterală, lipită sub navbar
   * (sticky) cât timp conținutul e mai lung decât ea. Sub prag, caseta trece sub conținut.
   */
  @media (min-width: 64rem) {
    .serviciu__grila {
      grid-template-columns: minmax(0, var(--measure)) minmax(20rem, 24rem);
      justify-content: space-between;
      align-items: start;
      gap: var(--space-6);
    }

    .serviciu__caseta {
      position: sticky;
      top: calc(var(--h-antet) + var(--space-3));
    }
  }
</style>
