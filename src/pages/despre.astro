---
/**
 * /despre/ (V4): AntetPagina cu fotografia paginii (placeholder-ul componentei Fotografie până vine
 * cea reală), textul din pagini/ro/despre.md în coloana de lectură (titlurile pe --fs-titlu), pe
 * fundal viu discret, și CtaFinal. „Cum lucrăm” rămâne textul din Markdown: pagina nu are pașii în
 * conținut, deci nu se folosește componenta cu pași de pe Acasă (nu se adaugă pași noi).
 */
import { getEntry, render } from 'astro:content';
import AntetPagina from '../components/AntetPagina.astro';
import ContinutMarcat from '../components/ContinutMarcat.astro';
import CtaFinal from '../components/CtaFinal.astro';
import DraftBadge from '../components/DraftBadge.astro';
import SectiunePagina from '../components/SectiunePagina.astro';
import { caleLogica, t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBirou } from '../lib/continut';
import { url } from '../lib/url';

const locale = 'ro';
const [pagina, acasa, birou] = await Promise.all([getEntry('pagini', 'ro/despre'), getEntry('acasa', 'ro/acasa'), getBirou()]);
if (!pagina || !acasa) throw new Error('Lipsesc pagini/ro/despre.md sau pagini/ro/acasa.yaml.');
const { Content } = await render(pagina);
const firimituri = [{ eticheta: t(locale, 'breadcrumbs.acasa'), href: url(caleLogica('acasa', locale)) }, { eticheta: pagina.data.titlu }];
---

<BaseLayout locale={locale} title={t(locale, 'pagina.seoTitlu', { titlu: pagina.data.titlu })} description={pagina.data.seoDescriere}>
  <AntetPagina
    locale={locale}
    titlu={pagina.data.titlu}
    breadcrumbs={firimituri}
    fotografie
    imagine={pagina.data.imagine}
    imagineAlt={pagina.data.imagineAlt}
  >
    <DraftBadge locale={locale} intrare={pagina} />
  </AntetPagina>

  <SectiunePagina viu={3} eticheta={pagina.data.titlu}>
    <div class="continut-articol">
      <ContinutMarcat><Content /></ContinutMarcat>
    </div>
  </SectiunePagina>

  <CtaFinal locale={locale} birou={birou} titlu={acasa.data.final.titlu} subtitlu={acasa.data.final.text} />
</BaseLayout>
