---
/**
 * /recenzii/ (V4): AntetPagina, ratingul agregat (doar dacă e completat: cifra mare, stelele roșii,
 * textul vizibil), toate recenziile reale de pe Google din recenzii.yaml, de la cea mai nouă, ca
 * citate cu linii între ele, linkul spre profilul Google și CtaFinal. Cu lista goală:
 * un mesaj neutru și linkul. Fără JSON-LD Review: recenziile Google nu se marchează ca proprii.
 * Nu se generează niciodată recenzii (CLAUDE.md §3.4, §7).
 */
import { getEntry } from 'astro:content';
import AntetPagina from '../components/AntetPagina.astro';
import Buton from '../components/Buton.astro';
import CardRating from '../components/CardRating.astro';
import CardRecenzie from '../components/CardRecenzie.astro';
import CtaFinal from '../components/CtaFinal.astro';
import DraftBadge from '../components/DraftBadge.astro';
import SectiunePagina from '../components/SectiunePagina.astro';
import { caleLogica, t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { linkExtern } from '../lib/contact';
import { getBirou } from '../lib/continut';
import { url } from '../lib/url';

const locale = 'ro';
const [recenzii, acasa, birou] = await Promise.all([getEntry('recenzii', 'recenzii'), getEntry('acasa', 'ro/acasa'), getBirou()]);
if (!recenzii || !acasa) throw new Error('Lipsesc recenzii/recenzii.yaml sau pagini/ro/acasa.yaml.');
const lista = [...recenzii.data.lista].sort((a, b) => b.data.localeCompare(a.data));
const profil = linkExtern(birou.googleProfilUrl, '');
const titlu = t(locale, 'recenzii.titluPagina');
const firimituri = [{ eticheta: t(locale, 'breadcrumbs.acasa'), href: url(caleLogica('acasa', locale)) }, { eticheta: titlu }];
// Ratingul agregat apare doar dacă e completat; altfel butonul de mai jos e suficient.
const areRating = birou.rating !== null && birou.numarRecenzii !== null;
---

<BaseLayout locale={locale} title={t(locale, 'pagina.seoTitlu', { titlu })} description={t(locale, 'recenzii.seoDescriere')}>
  <AntetPagina locale={locale} titlu={titlu} lead={acasa.data.recenzii.intro} breadcrumbs={firimituri} />

  <SectiunePagina viu={2} eticheta={titlu}>
    <div class="recenzii">
      {areRating && <CardRating locale={locale} birou={birou} />}
      {
        lista.length > 0 ? (
          <ul class="recenzii__lista" role="list">
            {lista.map((r) => (
              <li>
                <CardRecenzie locale={locale} {...r} complet />
              </li>
            ))}
          </ul>
        ) : (
          <div class="recenzii__gol">
            <DraftBadge locale={locale} draft text={t(locale, 'recenzii.inAsteptare')} />
            <p>{t(locale, 'recenzii.goale')}</p>
          </div>
        )
      }
      <Buton
        text={t(locale, 'recenzii.vedetiToate')}
        href={profil.valid ? profil.href : undefined}
        dezactivat={!profil.valid}
        target={profil.valid ? '_blank' : undefined}
        rel={profil.valid ? 'noopener noreferrer' : undefined}
        textSr={profil.valid ? t(locale, 'link.filaNoua') : `(${t(locale, 'link.indisponibil')})`}
      />
    </div>
  </SectiunePagina>

  <CtaFinal locale={locale} birou={birou} titlu={acasa.data.final.titlu} subtitlu={acasa.data.final.text} />
</BaseLayout>

<style>
  .recenzii {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: 52rem;
  }

  /* Recenziile: citate una sub alta, cu linii între ele (fără carduri). */
  .recenzii__lista {
    display: grid;
    width: 100%;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-line);
  }

  .recenzii__lista > li {
    max-width: none;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--c-line);
  }

  .recenzii__gol {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    color: var(--c-muted);
  }
</style>
