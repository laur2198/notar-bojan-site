---
/**
 * /stil/ – ghid de stil intern (noindex, exclus din sitemap), generat doar în preview: în
 * producție nu există (getStaticPaths întoarce o listă goală).
 *
 * Design v2, V1 (CLAUDE.md §5): arată DOAR fundația din prototip (docs/design-v2/prototip-acasa.html):
 * tokenurile de culoare cu contrastele lor, scara tipografică (cu wordmark-ul gigant), granulația,
 * semnătura, intro-ul (pornit doar din buton sau cu #intro) și helperii de mișcare.
 * Secțiunile paginii Acasă nu se portează aici.
 *
 * Culorile și mărimile se citesc din src/styles/tokens.css (src/lib/tokens.ts), deci rapoartele de
 * contrast și mărimile în px sunt calculate din valorile reale, la fiecare build. Build-ul eșuează
 * dacă o pereche pică WCAG AA, inclusiv în cazul cel mai defavorabil al granulației.
 */
import type { GetStaticPaths } from 'astro';
import '../styles/global.css';
import CapPagina from '../components/CapPagina.astro';
import IntroSemnatura from '../components/IntroSemnatura.astro';
import Semnatura from '../components/Semnatura.astro';
import WordmarkGigant from '../components/WordmarkGigant.astro';
import { formateazaRaport, PRAG_AA, raportContrast, treceAA, type Uz } from '../lib/contrast';
import { estePreview, getBirou } from '../lib/continut';
import { culoare, culori, marimePx, numarToken } from '../lib/tokens';

export const getStaticPaths = (() => (estePreview ? [{ params: { stil: 'stil' } }] : [])) satisfies GetStaticPaths;

const birou = await getBirou();

const MARK_FUNDAL = '#FFF1B8'; // mark.todo din global.css
/** Opacitatea granulației: zgomot negru, alfa maxim .06 (tokens.css, --granulatie). */
const GRANULATIE = 0.06;

/** Amestec sRGB, ca `color-mix(in srgb, a, b p%)` din CSS. */
const amesteca = (a: string, b: string, p: number) =>
  '#' +
  [1, 3, 5]
    .map((i) => Math.round(parseInt(a.slice(i, i + 2), 16) * (1 - p) + parseInt(b.slice(i, i + 2), 16) * p))
    .map((v) => v.toString(16).padStart(2, '0'))
    .join('')
    .toUpperCase();

/** O culoare sub pixelul cel mai închis al granulației (negru la opacitatea maximă). */
const subGranulatie = (h: string) => amesteca(h, '#000000', GRANULATIE);

const hex = (token: string) => {
  if (token === 'mark') return MARK_FUNDAL;
  // Alb 90% peste fundalul închis (subtitlul din hero).
  if (token === 'hero-subtitlu') return amesteca(culoare('c-ink'), culoare('c-paper'), 0.9);
  const tokenCuloare = culori[token];
  if (!tokenCuloare) throw new Error(`Tokenul --${token} lipsește din tokens.css.`);
  return tokenCuloare.hex;
};

const numeCuloare = (token: string) =>
  token === 'mark' ? 'mark.todo' : token === 'hero-subtitlu' ? 'paper 90% pe ink' : `--${token}`;

interface Pereche {
  fata: string;
  fundal: string;
  uz: Uz;
  folosire: string;
  nota?: string;
}

const perechi: Pereche[] = [
  { fata: 'c-ink', fundal: 'c-paper', uz: 'text', folosire: 'Text principal și titluri; linkuri; textul butonului secundar și al celui inversat' },
  { fata: 'c-ink', fundal: 'c-paper-2', uz: 'text', folosire: 'Text pe secțiunile alternante și în footer; butonul secundar și cel inversat la hover' },
  { fata: 'c-muted', fundal: 'c-paper', uz: 'text', folosire: 'Text secundar, lead-uri, rezumate; „Închis” (cerc gol, nu culoare)' },
  { fata: 'c-muted', fundal: 'c-paper-2', uz: 'text', folosire: 'Text secundar pe secțiunile alternante și în footer; „Închis” în bandă' },
  { fata: 'c-paper', fundal: 'c-ink', uz: 'text', folosire: 'Text pe secțiunile închise; textul butonului primar' },
  { fata: 'c-paper', fundal: 'c-ink-2', uz: 'text', folosire: 'Textul butonului primar la hover' },
  { fata: 'hero-subtitlu', fundal: 'c-ink', uz: 'text', folosire: 'Subtitlul din hero' },
  { fata: 'c-muted-dark', fundal: 'c-ink', uz: 'text', folosire: 'Text secundar („stins”) pe închis; „Închis” și butonul inactiv pe închis' },
  { fata: 'c-ink', fundal: 'mark', uz: 'text', folosire: 'Marcaj «DE COMPLETAT» (doar în preview)' },
  { fata: 'c-ink', fundal: 'c-paper', uz: 'ui', folosire: 'Contur de focus, conturul butonului secundar, iconițe' },
  { fata: 'c-ink', fundal: 'c-paper-2', uz: 'ui', folosire: 'Contur de focus și iconițe pe secțiunile alternante' },
  { fata: 'c-paper', fundal: 'c-ink', uz: 'ui', folosire: 'Contur de focus pe închis; conturul butonului cu contur deschis' },
  { fata: 'c-muted', fundal: 'c-paper', uz: 'ui', folosire: 'Conturul punctat al butonului inactiv și al marcajului' },
  { fata: 'c-muted-dark', fundal: 'c-ink', uz: 'ui', folosire: 'Conturul butonului inactiv pe închis' },
  {
    fata: 'c-line',
    fundal: 'c-paper',
    uz: 'decorativ',
    folosire: 'Borduri și separatoare pe deschis',
    nota: 'Doar decorativ: nu delimitează câmpuri de formular sau butoane.',
  },
  {
    fata: 'c-line-dark',
    fundal: 'c-ink',
    uz: 'decorativ',
    folosire: 'Borduri și separatoare pe închis',
    nota: 'Doar decorativ.',
  },
];

const ETICHETA_UZ: Record<Uz, string> = {
  text: 'Text normal',
  'text-mare': 'Text mare',
  ui: 'Element de interfață',
  decorativ: 'Decorativ',
};

/*
 * Cazul cel mai defavorabil al granulației: stratul închide cu până la 6% pixelii, independent,
 * deci fie fundalul, fie culoarea din față poate fi mai închisă. Se ia raportul cel mai mic.
 */
const randuri = perechi.map((p) => {
  const fata = hex(p.fata);
  const fundal = hex(p.fundal);
  const raport = raportContrast(fata, fundal);
  const cuGranulatie = Math.min(raport, raportContrast(subGranulatie(fata), fundal), raportContrast(fata, subGranulatie(fundal)));
  return { ...p, raport, cuGranulatie, trece: treceAA(cuGranulatie, p.uz) };
});

const picate = randuri.filter((r) => !r.trece);
if (picate.length > 0) {
  throw new Error(
    `Perechi care pică WCAG AA: ${picate.map((r) => `${r.fata} pe ${r.fundal} (${r.cuGranulatie.toFixed(2)} cu granulație)`).join(', ')}`,
  );
}

/* Scara tipografică: mărimile evaluate din tokens.css la trei lățimi. */
const LATIMI = [375, 1280, 1920] as const;

interface TreaptaScara {
  nume: string;
  token: string;
  clasa: string;
  din: string;
  text: string;
}

const scara: TreaptaScara[] = [
  { nume: 'Frază mare', token: 'fs-statement', clasa: 'scara-statement', din: 'sticky-el', text: 'Un dosar complet înseamnă o singură vizită.' },
  { nume: 'Titlu principal (h1)', token: 'fs-h1', clasa: 'scara-h1', din: 'hero__h1', text: 'Acte notariale pregătite din timp.' },
  { nume: 'Titlu de secțiune', token: 'fs-titlu', clasa: 'scara-titlu', din: 'serv__titlu, faq__titlu', text: 'Succesiune și moștenire' },
  { nume: 'Titlu h2', token: 'fs-h2', clasa: 'scara-h2', din: 'slogan__text, cta__text', text: 'Aveți alte întrebări? Scrieți-ne.' },
  { nume: 'Titlu h3, text mare', token: 'fs-h3', clasa: 'scara-h3', din: 'faq__btn, nav__logo', text: 'Ce act de identitate trebuie să am la mine?' },
  { nume: 'Text de bază', token: 'fs-base', clasa: 'scara-base', din: 'body', text: 'Știința își păstrează însemnătatea: ușa biroului din Brașov se deschide la nouă.' },
  { nume: 'Note, meniu, butoane', token: 'fs-sm', clasa: 'scara-sm', din: '–', text: 'Lista finală v-o confirmăm după verificarea actelor.' },
  { nume: 'Etichetele barei de jos (mobil)', token: 'fs-xs', clasa: 'scara-xs', din: '–', text: 'Sunați · Programare' },
];

const k = numarToken('wordmark-k');

const DIACRITICE = 'ăâîșțĂÂÎȘȚ';
const virgula = ['ș', 'ț', 'Ș', 'Ț'].every((c) => DIACRITICE.includes(c));
const faraSedila = !/[şţŞŢ]/.test(DIACRITICE);
const coduri = [...'șȘțȚ'].map((c) => `U+${c.codePointAt(0)!.toString(16).toUpperCase().padStart(4, '0')}`);

const fonturi = [
  { nume: 'Funnel Display', variabila: '--font-display', clasa: 'font-display', uz: 'h1, h2, frazele mari, wordmark-ul', grosimi: [500, 600] },
  { nume: 'Geist', variabila: '--font-sans', clasa: 'font-sans', uz: 'text, butoane, h3–h4', grosimi: [400, 500, 600] },
  { nume: 'Geist Mono', variabila: '--font-mono', clasa: 'font-mono', uz: 'etichete mono decorative (numerotare, coduri)', grosimi: [400, 500] },
];
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <CapPagina intro="manual" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ghid de stil (uz intern) – {birou.notar}</title>
  </head>
  <body>
    <IntroSemnatura />
    <main class="container stil">
      <h1>Ghid de stil</h1>
      <p class="lead">
        Fundația vizuală a design-ului v2, după prototipul aprobat (<code>docs/design-v2/prototip-acasa.html</code>):
        tokenurile, scara tipografică, granulația, semnătura, intro-ul și mișcarea la scroll. Pagină internă: nu este
        indexată și nu apare în sitemap. Contrastele și mărimile sunt calculate la build din <code>src/styles/tokens.css</code>.
      </p>

      <section aria-labelledby="paleta">
        <h2 id="paleta">Paleta</h2>
        <p>
          Monocromă. Nicio informație nu e purtată doar de culoare: starea „Deschis / Închis” are text și formă
          (disc plin / cerc gol). Singura culoare din afara paletei e galbenul marcajului «DE COMPLETAT», doar în preview.
        </p>
        <ul class="paleta" role="list">
          {
            Object.entries(culori).map(([nume, { hex: valoare, comentariu }]) => (
              <li class="culoare">
                <span class="mostra" style={`background-color: var(--${nume})`} aria-hidden="true" />
                <span class="culoare-text">
                  <code>--{nume}</code>
                  <span class="hex">{valoare}</span>
                  {comentariu && <span class="nota">{comentariu}</span>}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="contrast">
        <h2 id="contrast">Perechi text / fundal folosite</h2>
        <p>
          Praguri WCAG 2.1 AA: {PRAG_AA.text}:1 pentru text normal, {PRAG_AA['text-mare']}:1 pentru text mare și pentru
          elemente de interfață. Coloana „Cu granulație” e cazul cel mai defavorabil: un pixel al stratului de zgomot
          închide fundalul sau culoarea din față cu {GRANULATIE * 100}%. Pragul se aplică acestei coloane. Rapoartele sunt
          trunchiate, nu rotunjite.
        </p>
        <div class="tabel-wrap" role="region" aria-labelledby="titlu-tabel-contrast" tabindex="0">
          <table>
            <caption id="titlu-tabel-contrast" class="sr-only">
              Raportul de contrast pentru fiecare pereche de culori folosită pe site
            </caption>
            <thead>
              <tr>
                <th scope="col">Exemplu</th>
                <th scope="col">Culoare / fundal</th>
                <th scope="col">Folosire</th>
                <th scope="col">Uz</th>
                <th scope="col">Raport</th>
                <th scope="col">Cu granulație</th>
                <th scope="col">AA</th>
              </tr>
            </thead>
            <tbody>
              {
                randuri.map((r) => (
                  <tr>
                    <td>
                      <span class="exemplu" style={`color: ${hex(r.fata)}; background-color: ${hex(r.fundal)}`}>
                        {r.uz === 'decorativ' || r.uz === 'ui' ? (
                          <span class="exemplu-linie" style={`background-color: ${hex(r.fata)}`} aria-hidden="true" />
                        ) : (
                          'Aa Șț'
                        )}
                      </span>
                    </td>
                    <td>
                      <code>{numeCuloare(r.fata)}</code> pe <code>{numeCuloare(r.fundal)}</code>
                    </td>
                    <td>
                      {r.folosire}
                      {r.nota && <span class="nota nota--atentie">{r.nota}</span>}
                    </td>
                    <td>{ETICHETA_UZ[r.uz]}</td>
                    <td class="numar">{formateazaRaport(r.raport)}</td>
                    <td class="numar">{formateazaRaport(r.cuGranulatie)}</td>
                    <td>{r.uz === 'decorativ' ? 'Fără prag' : r.trece ? 'Trece' : 'Pică'}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section aria-labelledby="tipografie">
        <h2 id="tipografie">Scara tipografică</h2>
        <p>
          Textul de bază crește fluid cu lățimea ecranului, între 18 și 24 px (<code>--fs-base</code>, în rem: respectă
          mărimea de font aleasă în browser). Titlurile sunt multipli ai lui, cu plafoanele din prototip.
        </p>

        <h3>Fonturi</h3>
        <ul class="fonturi" role="list">
          {
            fonturi.map((f) => (
              <li class="font">
                <p class="font__nume">
                  {f.nume} <code>{f.variabila}</code>
                </p>
                <p class="nota">{f.uz}</p>
                <p class:list={['font__mostra', f.clasa]}>
                  {f.grosimi.map((g) => (
                    <span style={`font-weight: ${g}`}>
                      {g} Șțăâî ȘȚĂÂÎ
                    </span>
                  ))}
                </p>
              </li>
            ))
          }
        </ul>

        <h3>Trepte</h3>
        <div class="tabel-wrap" role="region" aria-labelledby="titlu-tabel-scara" tabindex="0">
          <table>
            <caption id="titlu-tabel-scara" class="sr-only">Mărimile tokenurilor de font, în px, la trei lățimi de ecran</caption>
            <thead>
              <tr>
                <th scope="col">Treaptă</th>
                <th scope="col">Token</th>
                <th scope="col">Din prototip</th>
                {LATIMI.map((l) => <th scope="col">{l} px</th>)}
              </tr>
            </thead>
            <tbody>
              {
                scara.map((s) => (
                  <tr>
                    <td>{s.nume}</td>
                    <td>
                      <code>--{s.token}</code>
                    </td>
                    <td>
                      <code>{s.din}</code>
                    </td>
                    {LATIMI.map((l) => (
                      <td class="numar">{marimePx(s.token, l)}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <dl class="scara">
          {
            scara.map((s) => (
              <div class="scara-rand">
                <dt>
                  {s.nume} <code>--{s.token}</code>
                </dt>
                <dd class={s.clasa}>{s.text}</dd>
              </div>
            ))
          }
        </dl>

        <h3>Wordmark-ul gigant</h3>
        <p>
          Funnel Display 600, <code>letter-spacing: -0.055em</code>, <code>line-height: .82</code>. Mărimea = lățimea
          containerului / {k} (<code>--wordmark-k</code>, lățimea textului în em, măsurată cu fontul încărcat). Doar
          CSS, prin container queries.
        </p>
        <div class="wordmark-demo" data-wordmark-container>
          <WordmarkGigant text={birou.notar} />
        </div>

        <h3>Diacritice</h3>
        <p class="diacritice font-display">{DIACRITICE}</p>
        <p class="diacritice">{DIACRITICE}</p>
        <p class="nota">
          Verificare la build: {virgula && faraSedila ? 'ș și ț sunt cu virgulă' : 'EROARE: diacritice cu sedilă'} (
          {coduri.join(', ')}), nu cu sedilă (U+015F, U+0163). Toate trei fonturile au aceste glife (latin-ext).
        </p>
      </section>

      <section aria-labelledby="granulatie">
        <h2 id="granulatie">Granulația</h2>
        <p>
          Zgomot <code>feTurbulence</code> din prototip, opacitate .06, ca strat fix peste toată pagina, inclusiv peste
          aceasta. Static: fără animație, la nicio setare (WCAG 2.2.2). Nu interceptează clicuri și nu apare la
          tipărire sau în modul de contrast ridicat. Mostrele de mai jos sunt mărite de 4 ori, ca textura să se vadă.
        </p>
        <div class="granulatie-mostre">
          <figure class="granulatie-mostra">
            <div class="granulatie-marita" aria-hidden="true"></div>
            <figcaption>Pe <code>--c-paper</code>, mărit 4×</figcaption>
          </figure>
          <figure class="granulatie-mostra">
            <div class="granulatie-marita granulatie-marita--inchis" aria-hidden="true"></div>
            <figcaption>Pe <code>--c-ink</code>, mărit 4× (zgomotul e negru: pe închis abia se vede, ca în prototip)</figcaption>
          </figure>
        </div>
      </section>

      <section aria-labelledby="semnatura">
        <h2 id="semnatura">Semnătura</h2>
        <p>
          O singură linie cu <code>stroke</code>, culoarea din text (<code>currentColor</code>). Desenul: fiecare traseu
          are <code>pathLength="100"</code> și se desenează prin <code>stroke-dashoffset</code>, pe rând, de la stânga la
          dreapta, cu un singur progres pe tot gestul (aceeași metodă ca în prototip). Fără JS și cu mișcare redusă,
          semnătura apare direct desenată.
        </p>
        <div class="semnaturi">
          <div class="semnatura-panou">
            <Semnatura id="stil-deschis" />
          </div>
          <div class="semnatura-panou semnatura-panou--inchis pe-inchis">
            <Semnatura id="stil-inchis" />
          </div>
        </div>
        <button type="button" class="btn btn--secundar" data-reda-semnatura hidden>Redă desenul</button>
      </section>

      <section aria-labelledby="intro">
        <h2 id="intro">Intro-ul</h2>
        <p>
          Ecran complet <code>--c-ink</code>, semnătura în <code>--c-paper</code> se desenează în 1,8 s; după o pauză de
          0,4 s ecranul urcă în 1 s. O dată pe sesiune; orice clic, tastă, rotiță sau atingere îl sare. Nu apare deloc cu
          mișcare redusă sau fără JS. Pe această pagină pornește doar din buton (sau cu <code>#intro</code> în adresă).
        </p>
        <button type="button" class="btn btn--secundar" data-reda-intro hidden>Redă intro-ul</button>
        <p class="nota" data-stare-intro aria-live="polite"></p>
      </section>

      <section aria-labelledby="miscare">
        <h2 id="miscare">Mișcarea la scroll</h2>
        <p>
          GSAP + ScrollTrigger + SplitText din npm, derulare nativă (fără Lenis). Helperii pe data-atribute, mai jos. Cu
          mișcare redusă sau fără JS, totul e vizibil din prima, nemișcat.
        </p>
        <div class="demo-miscare">
          <p class="nota"><code>data-reveal</code> pe un titlu (aria-label pe titlu, rândurile aria-hidden):</p>
          <h3 class="demo-reveal" data-reveal>Acte notariale pregătite din timp, ca la birou să veniți doar pentru semnare.</h3>
          <p class="nota"><code>data-reveal</code> pe un paragraf (copie sr-only a textului, rândurile aria-hidden):</p>
          <p class="demo-reveal-p" data-reveal>
            Pregătim dosarul înainte de programare, ca vizita la birou să fie cât mai scurtă. Verificăm actele și vă spunem
            din timp ce lipsește.
          </p>
          <p class="nota"><code>data-divider</code>:</p>
          <div class="demo-divider" data-divider aria-hidden="true"></div>
          <p class="nota"><code>data-parallax="12"</code> (blocul gri se deplasează în cadrul lui la scroll):</p>
          <div class="demo-parallax-cadru" aria-hidden="true">
            <div class="demo-parallax" data-parallax="12">
              <span>Fotografie – de completat</span>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<script>
  import { deseneazaSemnatura, pregatesteSemnatura } from '../scripts/desen-semnatura';

  /*
   * Semnăturile se desenează o dată, la prima intrare în ecran, și la „Redă desenul”. La mișcare
   * redusă nu se animă deloc (rămân desenate, starea din HTML) și butonul rămâne ascuns.
   */
  const svguri = [...document.querySelectorAll<SVGSVGElement>('.semnaturi [data-semnatura]')];
  const buton = document.querySelector<HTMLButtonElement>('[data-reda-semnatura]');
  const miscareRedusa = matchMedia('(prefers-reduced-motion: reduce)');
  const opriri = new Map<SVGSVGElement, () => void>();

  const deseneaza = (svg: SVGSVGElement) => {
    opriri.get(svg)?.();
    opriri.set(svg, deseneazaSemnatura(svg, 3500));
  };

  if (!miscareRedusa.matches && 'IntersectionObserver' in window) {
    for (const svg of svguri) pregatesteSemnatura(svg);
    const observator = new IntersectionObserver(
      (intrari) => {
        for (const intrare of intrari) {
          if (!intrare.isIntersecting) continue;
          observator.unobserve(intrare.target);
          deseneaza(intrare.target as SVGSVGElement);
        }
      },
      { threshold: 0.4 },
    );
    for (const svg of svguri) observator.observe(svg);
    if (buton) {
      buton.hidden = false;
      buton.addEventListener('click', () => svguri.forEach(deseneaza));
    }
  }

  // Dacă utilizatorul activează mișcarea redusă cât pagina e deschisă: totul desenat, fără buton.
  miscareRedusa.addEventListener('change', (e) => {
    if (!e.matches) return;
    opriri.forEach((opreste) => opreste());
    if (buton) buton.hidden = true;
  });
</script>

<script>
  import { pornesteMiscarea } from '../scripts/miscare';
  import { EVENIMENT_GATA, ruleazaIntro } from '../scripts/intro-semnatura';

  pornesteMiscarea();

  // „Redă intro-ul”: vizibil doar cu mișcare permisă (la mișcare redusă intro-ul nu există).
  const butonIntro = document.querySelector<HTMLButtonElement>('[data-reda-intro]');
  const stare = document.querySelector<HTMLElement>('[data-stare-intro]');
  const redus = matchMedia('(prefers-reduced-motion: reduce)');
  const actualizeazaButon = () => {
    if (butonIntro) butonIntro.hidden = redus.matches;
  };
  actualizeazaButon();
  redus.addEventListener('change', actualizeazaButon);
  butonIntro?.addEventListener('click', () => {
    if (stare) stare.textContent = '';
    ruleazaIntro();
  });
  document.addEventListener(EVENIMENT_GATA, () => {
    if (stare) stare.textContent = 'Evenimentul intro-gata a fost emis.';
  });
</script>

