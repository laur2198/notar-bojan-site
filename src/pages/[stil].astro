---
/**
 * /stil/ – ghid de stil intern (noindex, exclus din sitemap), generat doar în preview: în
 * producție nu există (getStaticPaths întoarce o listă goală).
 *
 * Design v2 (CLAUDE.md §5; paleta caldă din V3b): arată DOAR fundația din prototip (docs/design-v2/prototip-acasa.html):
 * tokenurile de culoare cu contrastele lor (inclusiv fundalul viu), scara tipografică (cu
 * wordmark-ul gigant), granulația, fundalul viu și helperii de mișcare. Semnătura și intro-ul au
 * fost scoase în V3d, la cererea clientei.
 * Secțiunile paginii Acasă nu se portează aici.
 *
 * Culorile și mărimile se citesc din src/styles/tokens.css (src/lib/tokens.ts), deci rapoartele de
 * contrast și mărimile în px sunt calculate din valorile reale, la fiecare build. Build-ul eșuează
 * dacă o pereche pică WCAG AA, inclusiv în cazul cel mai defavorabil al granulației.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Buton from '../components/Buton.astro';
import CasetaDosar from '../components/CasetaDosar.astro';
import CtaFinal from '../components/CtaFinal.astro';
import FundalViu from '../components/FundalViu.astro';
import ListaIntrebari from '../components/ListaIntrebari.astro';
import ListaNumerotata from '../components/ListaNumerotata.astro';
import Shutter from '../components/Shutter.astro';
import WordmarkGigant from '../components/WordmarkGigant.astro';
import { contrastCuGranulatie, formateazaRaport, GRANULATIE, PRAG_AA, raportContrast, treceAA, type Uz } from '../lib/contrast';
import { compusMaxim, INTENSITATI, type Intensitate } from '../lib/fundal-viu';
import { estePreview, getBirou } from '../lib/continut';
import { culoare, culori, marimePx, numarToken } from '../lib/tokens';
import { url } from '../lib/url';

export const getStaticPaths = (() => (estePreview ? [{ params: { stil: 'stil' } }] : [])) satisfies GetStaticPaths;

const birou = await getBirou();

const MARK_FUNDAL = culoare('c-marcaj'); // mark.todo din global.css

/*
 * Pseudo-tokenuri pentru fundaluri compuse:
 *   viu-{intensitate}-{fond} punctul cel mai saturat al fundalului viu peste --c-paper, --c-paper-2
 *                            sau --c-paper-rosu: centrul petei celei mai închise (petele nu se
 *                            suprapun; src/lib/fundal-viu.ts).
 */
const hex = (token: string) => {
  if (token === 'mark') return MARK_FUNDAL;
  const viu = token.match(/^viu-(puternic|discret)-(c-paper(?:-2|-rosu)?)$/);
  if (viu) return compusMaxim(viu[1] as Intensitate, culoare(viu[2]!));
  const tokenCuloare = culori[token];
  if (!tokenCuloare) throw new Error(`Tokenul --${token} lipsește din tokens.css.`);
  return tokenCuloare.hex;
};

const numeCuloare = (token: string) => {
  if (token === 'mark') return 'mark.todo';
  const viu = token.match(/^viu-(puternic|discret)-(c-paper(?:-2|-rosu)?)$/);
  if (viu) return `fundal viu ${viu[1]} (maxim) pe --${viu[2]}`;
  return `--${token}`;
};

interface Pereche {
  fata: string;
  fundal: string;
  uz: Uz;
  folosire: string;
  nota?: string;
}

const perechiViu: Pereche[] = INTENSITATI.flatMap((i) =>
  (i === 'discret' ? ['c-paper', 'c-paper-2', 'c-paper-rosu'] : ['c-paper', 'c-paper-2']).flatMap((fond) => [
    { fata: 'c-ink', fundal: `viu-${i}-${fond}`, uz: 'text' as Uz, folosire: `Text principal peste fundalul viu ${i}, în punctul cel mai saturat` },
    { fata: 'c-muted', fundal: `viu-${i}-${fond}`, uz: 'text' as Uz, folosire: `Text secundar peste fundalul viu ${i}` },
    { fata: 'c-rosu', fundal: `viu-${i}-${fond}`, uz: 'text' as Uz, folosire: `Cifrele 01–0N, iconițele și focusul peste fundalul viu ${i}` },
  ]),
);

const perechi: Pereche[] = [
  { fata: 'c-ink', fundal: 'c-paper', uz: 'text', folosire: 'Text principal și titluri (maro); linkuri; butonul contur' },
  { fata: 'c-ink', fundal: 'c-paper-2', uz: 'text', folosire: 'Text pe secțiunile alternante (gri cald)' },
  { fata: 'c-ink', fundal: 'c-paper-rosu', uz: 'text', folosire: 'Text pe secțiunea Servicii (roz pal)' },
  { fata: 'c-ink', fundal: 'c-rosu-50', uz: 'text', folosire: 'Butonul contur la hover' },
  { fata: 'c-wordmark', fundal: 'c-paper', uz: 'text', folosire: 'Numele biroului: navbar, wordmark-ul gigant din hero și rândul de deasupra lui' },
  { fata: 'c-wordmark', fundal: 'c-paper-2', uz: 'text', folosire: 'Numele biroului pe gri cald' },
  { fata: 'c-muted', fundal: 'c-paper', uz: 'text', folosire: 'Text secundar, lead-uri, rezumate; „Închis” (cerc gol, nu culoare)' },
  { fata: 'c-muted', fundal: 'c-paper-2', uz: 'text', folosire: 'Text secundar pe secțiunile alternante' },
  { fata: 'c-muted', fundal: 'c-paper-rosu', uz: 'text', folosire: 'Rezumatele serviciilor (roz pal)' },
  { fata: 'c-slogan-stins', fundal: 'c-paper-2', uz: 'text', folosire: 'Sloganul din „Cum lucrăm” înainte să „se aprindă” (trece în --c-ink)' },
  { fata: 'c-slogan-stins', fundal: 'viu-discret-c-paper-2', uz: 'text', folosire: 'Sloganul stins peste fundalul viu discret din „Cum lucrăm”' },
  { fata: 'c-paper', fundal: 'c-rosu', uz: 'text', folosire: 'Textul butonului plin; bula cursorului' },
  { fata: 'c-paper', fundal: 'c-rosu-hover', uz: 'text', folosire: 'Butonul plin la hover; butonul contur pe roșu, la hover' },
  { fata: 'c-rosu', fundal: 'c-paper', uz: 'text', folosire: 'Cifrele 01–0N (mono, text mic); textul butonului alb de pe roșu viu' },
  { fata: 'c-rosu', fundal: 'c-paper-2', uz: 'text', folosire: 'Roșul pe secțiunile alternante' },
  { fata: 'c-rosu', fundal: 'c-paper-rosu', uz: 'text', folosire: 'Cifrele serviciilor pe roz pal' },
  { fata: 'c-rosu', fundal: 'c-rosu-50', uz: 'text', folosire: 'Butonul alb de pe roșu viu, la hover; placeholderul fotografiilor din galerie' },
  { fata: 'c-paper', fundal: 'c-suprafata-rosie', uz: 'text', folosire: 'Text pe roșu viu: frazele din galerie, CtaFinal' },
  { fata: 'c-rosu-200', fundal: 'c-suprafata-rosie', uz: 'text', folosire: 'Text secundar pe roșu viu: al doilea rând al frazelor, subtitlul din CtaFinal' },
  { fata: 'c-paper', fundal: 'c-suprafata-maro', uz: 'text', folosire: 'Text pe maro: subsolul, meniul compact (linkurile, wordmark-ul)' },
  { fata: 'c-suprafata-maro', fundal: 'c-paper', uz: 'text', folosire: 'Butonul alb de pe maro (subsol, meniul compact)' },
  { fata: 'c-suprafata-maro', fundal: 'c-rosu-50', uz: 'text', folosire: 'Butonul alb de pe maro, la hover' },
  { fata: 'c-maro-300', fundal: 'c-suprafata-maro', uz: 'text', folosire: 'Text secundar pe maro: titlurile coloanelor și rândul legal din subsol, butonul inactiv' },
  { fata: 'c-paper', fundal: 'c-linie-maro', uz: 'text', folosire: 'Butonul contur de pe maro, la hover; nota din meniul compact' },
  { fata: 'c-ink', fundal: 'mark', uz: 'text', folosire: 'Marcaj «DE COMPLETAT» (doar în preview)' },
  ...perechiViu,
  { fata: 'c-rosu', fundal: 'c-paper', uz: 'ui', folosire: 'Contur de focus, linia de sub h1, dividerele, săgețile, iconița WhatsApp, linia .sub la hover' },
  { fata: 'c-rosu', fundal: 'c-paper-2', uz: 'ui', folosire: 'Contur de focus și iconița +/− pe secțiunile alternante' },
  { fata: 'c-ink', fundal: 'c-paper', uz: 'ui', folosire: 'Conturul butonului contur, al telefonului și al butonului „Meniu”' },
  { fata: 'c-paper', fundal: 'c-suprafata-maro', uz: 'ui', folosire: 'Contur de focus pe maro; conturul butonului contur' },
  { fata: 'c-paper', fundal: 'c-suprafata-rosie', uz: 'ui', folosire: 'Contur de focus pe roșu viu; conturul butonului contur din CtaFinal' },
  { fata: 'c-muted', fundal: 'c-paper', uz: 'ui', folosire: 'Conturul punctat al butonului inactiv și al marcajului' },
  { fata: 'c-maro-300', fundal: 'c-suprafata-maro', uz: 'ui', folosire: 'Conturul butonului inactiv pe maro' },
  {
    fata: 'c-line',
    fundal: 'c-paper',
    uz: 'decorativ',
    folosire: 'Borduri și separatoare pe deschis',
    nota: 'Doar decorativ: nu delimitează câmpuri de formular sau butoane.',
  },
  {
    fata: 'c-linie-maro',
    fundal: 'c-suprafata-maro',
    uz: 'decorativ',
    folosire: 'Borduri și separatoare pe maro (subsol, meniul compact)',
    nota: 'Doar decorativ.',
  },
  {
    fata: 'c-rosu-200',
    fundal: 'c-suprafata-maro',
    uz: 'decorativ',
    folosire: 'Banda de 8 px de pe marginea de sus a subsolului (maroul nu atinge CtaFinal-ul roșu viu)',
    nota: 'Doar decorativ.',
  },
];

const ETICHETA_UZ: Record<Uz, string> = {
  text: 'Text normal',
  'text-mare': 'Text mare',
  ui: 'Element de interfață',
  decorativ: 'Decorativ',
};

/*
 * Cazul cel mai defavorabil al granulației: stratul închide cu până la 6% pixelii, independent,
 * deci fie fundalul, fie culoarea din față poate fi mai închisă. Se ia raportul cel mai mic.
 */
const randuri = perechi.map((p) => {
  const fata = hex(p.fata);
  const fundal = hex(p.fundal);
  const raport = raportContrast(fata, fundal);
  const cuGranulatie = contrastCuGranulatie(fata, fundal);
  return { ...p, raport, cuGranulatie, trece: treceAA(cuGranulatie, p.uz) };
});

const picate = randuri.filter((r) => !r.trece);
if (picate.length > 0) {
  throw new Error(
    `Perechi care pică WCAG AA: ${picate.map((r) => `${r.fata} pe ${r.fundal} (${r.cuGranulatie.toFixed(2)} cu granulație)`).join(', ')}`,
  );
}

/* Scara tipografică: mărimile evaluate din tokens.css la trei lățimi. */
const LATIMI = [375, 1280, 1920] as const;

interface TreaptaScara {
  nume: string;
  token: string;
  clasa: string;
  din: string;
  text: string;
}

const scara: TreaptaScara[] = [
  { nume: 'Frază mare', token: 'fs-statement', clasa: 'scara-statement', din: 'sticky-el', text: 'Un dosar complet înseamnă mai puține drumuri la birou.' },
  { nume: 'Titlu principal (h1)', token: 'fs-h1', clasa: 'scara-h1', din: 'hero__h1', text: 'Acte notariale pregătite din timp.' },
  { nume: 'Titlu de secțiune', token: 'fs-titlu', clasa: 'scara-titlu', din: 'lista-nr__titlu, faq__titlu', text: 'Succesiune și moștenire' },
  { nume: 'Titlu h2', token: 'fs-h2', clasa: 'scara-h2', din: 'slogan__text, cta__text', text: 'Aveți alte întrebări? Scrieți-ne.' },
  { nume: 'Titlu h3, text mare', token: 'fs-h3', clasa: 'scara-h3', din: 'faq__btn, nav__logo', text: 'Ce act de identitate trebuie să am la mine?' },
  { nume: 'Text de bază', token: 'fs-base', clasa: 'scara-base', din: 'body', text: 'Știința își păstrează însemnătatea: ușa biroului din Brașov se deschide la nouă.' },
  { nume: 'Note, meniu, butoane', token: 'fs-sm', clasa: 'scara-sm', din: '–', text: 'Lista finală v-o confirmăm după verificarea actelor.' },
  { nume: 'Etichetele barei de jos (mobil)', token: 'fs-xs', clasa: 'scara-xs', din: '–', text: 'Sunați · Programare' },
];

const k = numarToken('wordmark-k');

const DIACRITICE = 'ăâîșțĂÂÎȘȚ';
const virgula = ['ș', 'ț', 'Ș', 'Ț'].every((c) => DIACRITICE.includes(c));
const faraSedila = !/[şţŞŢ]/.test(DIACRITICE);
const coduri = [...'șȘțȚ'].map((c) => `U+${c.codePointAt(0)!.toString(16).toUpperCase().padStart(4, '0')}`);

const fonturi = [
  { nume: 'Funnel Display', variabila: '--font-display', clasa: 'font-display', uz: 'h1, h2, frazele mari, wordmark-ul', grosimi: [500, 600] },
  { nume: 'Geist', variabila: '--font-sans', clasa: 'font-sans', uz: 'text, butoane, h3–h4', grosimi: [400, 500, 600] },
  { nume: 'Geist Mono', variabila: '--font-mono', clasa: 'font-mono', uz: 'etichete mono decorative (numerotare, coduri)', grosimi: [400, 500] },
];
---

<BaseLayout
  locale="ro"
  title={`Ghid de stil (uz intern) – ${birou.denumire}`}
  description="Ghidul de stil intern al site-ului: tokenuri, tipografie, componente."
  noindex
>
    <div class="container stil">
      <h1>Ghid de stil</h1>
      <p class="lead">
        Fundația vizuală a design-ului v2, după prototipul aprobat (<code>docs/design-v2/prototip-acasa.html</code>):
        tokenurile, scara tipografică, granulația, fundalul viu și mișcarea la scroll. Pagină internă: nu este
        indexată și nu apare în sitemap. Contrastele și mărimile sunt calculate la build din <code>src/styles/tokens.css</code>.
      </p>

      <section aria-labelledby="paleta">
        <h2 id="paleta">Paleta</h2>
        <p>
          V5–V6: alb ~50%, roșu ~25–30% (acțiunile, accentele, galeria cu frazele și CtaFinal), maro pentru
          text, pentru numele biroului și pentru suprafețele închise (subsolul, meniul compact), gri cald. Nicio informație nu e purtată doar de culoare: starea „Deschis / Închis” are text și formă
          (disc plin / cerc gol), în ink / muted. Singura culoare din afara paletei e galbenul marcajului «DE COMPLETAT»,
          doar în preview.
        </p>
        <ul class="paleta" role="list">
          {
            Object.entries(culori).map(([nume, { hex: valoare, comentariu }]) => (
              <li class="culoare">
                <span class="mostra" style={`background-color: var(--${nume})`} aria-hidden="true" />
                <span class="culoare-text">
                  <code>--{nume}</code>
                  <span class="hex">{valoare}</span>
                  {comentariu && <span class="nota">{comentariu}</span>}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="contrast">
        <h2 id="contrast">Perechi text / fundal folosite</h2>
        <p>
          Praguri WCAG 2.1 AA: {PRAG_AA.text}:1 pentru text normal, {PRAG_AA['text-mare']}:1 pentru text mare și pentru
          elemente de interfață. Coloana „Cu granulație” e cazul cel mai defavorabil: un pixel al stratului de zgomot
          închide fundalul sau culoarea din față cu {GRANULATIE * 100}%. Pragul se aplică acestei coloane. Rapoartele sunt
          trunchiate, nu rotunjite.
        </p>
        <div class="tabel-wrap" role="region" aria-labelledby="titlu-tabel-contrast" tabindex="0">
          <table>
            <caption id="titlu-tabel-contrast" class="sr-only">
              Raportul de contrast pentru fiecare pereche de culori folosită pe site
            </caption>
            <thead>
              <tr>
                <th scope="col">Exemplu</th>
                <th scope="col">Culoare / fundal</th>
                <th scope="col">Folosire</th>
                <th scope="col">Uz</th>
                <th scope="col">Raport</th>
                <th scope="col">Cu granulație</th>
                <th scope="col">AA</th>
              </tr>
            </thead>
            <tbody>
              {
                randuri.map((r) => (
                  <tr>
                    <td>
                      <span class="exemplu" style={`color: ${hex(r.fata)}; background-color: ${hex(r.fundal)}`}>
                        {r.uz === 'decorativ' || r.uz === 'ui' ? (
                          <span class="exemplu-linie" style={`background-color: ${hex(r.fata)}`} aria-hidden="true" />
                        ) : (
                          'Aa Șț'
                        )}
                      </span>
                    </td>
                    <td>
                      <code>{numeCuloare(r.fata)}</code> pe <code>{numeCuloare(r.fundal)}</code>
                    </td>
                    <td>
                      {r.folosire}
                      {r.nota && <span class="nota nota--atentie">{r.nota}</span>}
                    </td>
                    <td>{ETICHETA_UZ[r.uz]}</td>
                    <td class="numar">{formateazaRaport(r.raport)}</td>
                    <td class="numar">{formateazaRaport(r.cuGranulatie)}</td>
                    <td>{r.uz === 'decorativ' ? 'Fără prag' : r.trece ? 'Trece' : 'Pică'}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section aria-labelledby="tipografie">
        <h2 id="tipografie">Scara tipografică</h2>
        <p>
          Textul de bază e fix: 18 px, 19 px de la 1600 px lățime (<code>--fs-base</code>, în rem: respectă mărimea de
          font aleasă în browser). Titlurile cresc cu lățimea între plafoane în rem (V3b, varianta luminoasă).
        </p>

        <h3>Fonturi</h3>
        <ul class="fonturi" role="list">
          {
            fonturi.map((f) => (
              <li class="font">
                <p class="font__nume">
                  {f.nume} <code>{f.variabila}</code>
                </p>
                <p class="nota">{f.uz}</p>
                <p class:list={['font__mostra', f.clasa]}>
                  {f.grosimi.map((g) => (
                    <span style={`font-weight: ${g}`}>
                      {g} Șțăâî ȘȚĂÂÎ
                    </span>
                  ))}
                </p>
              </li>
            ))
          }
        </ul>

        <h3>Trepte</h3>
        <div class="tabel-wrap" role="region" aria-labelledby="titlu-tabel-scara" tabindex="0">
          <table>
            <caption id="titlu-tabel-scara" class="sr-only">Mărimile tokenurilor de font, în px, la trei lățimi de ecran</caption>
            <thead>
              <tr>
                <th scope="col">Treaptă</th>
                <th scope="col">Token</th>
                <th scope="col">Din prototip</th>
                {LATIMI.map((l) => <th scope="col">{l} px</th>)}
              </tr>
            </thead>
            <tbody>
              {
                scara.map((s) => (
                  <tr>
                    <td>{s.nume}</td>
                    <td>
                      <code>--{s.token}</code>
                    </td>
                    <td>
                      <code>{s.din}</code>
                    </td>
                    {LATIMI.map((l) => (
                      <td class="numar">{marimePx(s.token, l)}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <dl class="scara">
          {
            scara.map((s) => (
              <div class="scara-rand">
                <dt>
                  {s.nume} <code>--{s.token}</code>
                </dt>
                <dd class={s.clasa}>{s.text}</dd>
              </div>
            ))
          }
        </dl>

        <h3>Wordmark-ul gigant</h3>
        <p>
          Funnel Display 600, <code>letter-spacing: -0.055em</code>, <code>line-height: .82</code>. Mărimea = lățimea
          containerului / {k} (<code>--wordmark-k</code>, lățimea textului în em, măsurată cu fontul încărcat). Doar
          CSS, prin container queries.
        </p>
        <div class="wordmark-demo" data-wordmark-container>
          <WordmarkGigant text={birou.notar} />
        </div>

        <h3>Diacritice</h3>
        <p class="diacritice font-display">{DIACRITICE}</p>
        <p class="diacritice">{DIACRITICE}</p>
        <p class="nota">
          Verificare la build: {virgula && faraSedila ? 'ș și ț sunt cu virgulă' : 'EROARE: diacritice cu sedilă'} (
          {coduri.join(', ')}), nu cu sedilă (U+015F, U+0163). Toate trei fonturile au aceste glife (latin-ext).
        </p>
      </section>

      <section aria-labelledby="granulatie">
        <h2 id="granulatie">Granulația</h2>
        <p>
          Zgomot <code>feTurbulence</code> din prototip, opacitate .06, ca strat fix peste toată pagina, inclusiv peste
          aceasta. Static: fără animație, la nicio setare (WCAG 2.2.2). Nu interceptează clicuri și nu apare la
          tipărire sau în modul de contrast ridicat. Mostrele de mai jos sunt mărite de 4 ori, ca textura să se vadă.
        </p>
        <div class="granulatie-mostre">
          <figure class="granulatie-mostra">
            <div class="granulatie-marita" aria-hidden="true"></div>
            <figcaption>Pe <code>--c-paper</code>, mărit 4×</figcaption>
          </figure>
          <figure class="granulatie-mostra">
            <div class="granulatie-marita granulatie-marita--inchis" data-tema-sectiune="dark" aria-hidden="true"></div>
            <figcaption>Pe <code>--c-suprafata-maro</code>, mărit 4× (zgomotul e negru: pe închis abia se vede, ca în prototip)</figcaption>
          </figure>
        </div>
      </section>

      <section aria-labelledby="fundal-viu">
        <h2 id="fundal-viu">Fundalul viu</h2>
        <p>
          <code>FundalViu.astro</code>: 3 pete difuze (V5: roșu, coral, piersică), fără blur, mișcate doar de scroll și, pe
          hero, de cursor; statice la mișcare redusă și fără JS. Opacitățile sunt tokenuri <code>--viu-*</code>, la maximul
          care trece; contrastul textului e verificat în tabelul de mai sus, în centrul petei celei mai închise (petele nu se
          suprapun). Mostrele: puternic pe alb, discret pe gri cald și discret pe roz pal (Servicii).
        </p>
        <div class="demo-viu-grila">
          {
            ([['puternic', 'paper'], ['discret', 'paper-2'], ['discret', 'paper-rosu']] as const).map(([intensitate, fond], i) => (
              <div class:list={['demo-viu', `demo-viu--${fond}`]}>
