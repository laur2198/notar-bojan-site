---
/** Pagină temporară (etapa 2): verifică carcasa. Etapa 6 o înlocuiește cu pagina Acasă în engleză. */
import { getEntry } from 'astro:content';
import StareProgram from '../../components/StareProgram.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { esteDraft, getBirou } from '../../lib/continut';

const acasa = await getEntry('acasa', 'en/acasa');
if (!acasa) throw new Error('Lipsește src/content/pagini/en/acasa.yaml.');
const birou = await getBirou();
---

<BaseLayout locale="en" title={acasa.data.seo.titlu} description={acasa.data.seo.descriere} draft={esteDraft(acasa)}>
  <div class="container temporar">
    <h1>{acasa.data.hero.titlu}</h1>
    <StareProgram locale="en" program={birou.program} zileLibere={birou.zileLibere} />
  </div>
</BaseLayout>

<style>
  .temporar {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-7);
  }
</style>
