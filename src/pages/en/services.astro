---
/**
 * /en/services/ (etapa 6): prezentare generală, fără pagini individuale (CLAUDE.md §6). Aceeași
 * structură ca /servicii/: bandă de titlu, grila de carduri (GrilaServicii) și CTA. Fără onorarii
 * sau sume (CLAUDE.md §3.3): sub grilă, doar nota generală cu trimiterea la Ordinul MJ nr. 177/C/2024
 * (`servicii.intro` din i18n, același text ca lead-ul de pe /servicii/).
 *
 * Fiecare card are ancora `id={slugRo}` (ținta cardurilor de pe /en/) și linkul secundar
 * „Details in Romanian” spre /servicii/{slugRo}/, cu hreflang="ro".
 */
import { getCollection, getEntry } from 'astro:content';
import BandaTitlu from '../../components/BandaTitlu.astro';
import DraftBadge from '../../components/DraftBadge.astro';
import GrilaServicii from '../../components/GrilaServicii.astro';
import SectiuneCta from '../../components/SectiuneCta.astro';
import Sectiune from '../../components/Sectiune.astro';
import { cale, t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBirou, marcheazaPlaceholder } from '../../lib/continut';

const locale = 'en';
const [serviciiEn, acasa, birou, serviciiRo] = await Promise.all([
  getEntry('serviciiEn', 'servicii'),
  getEntry('acasa', 'en/acasa'),
  getBirou(),
  getCollection('servicii'),
]);
if (!serviciiEn || !acasa) throw new Error('Lipsesc servicii-en/servicii.yaml sau pagini/en/acasa.yaml.');

// Fiecare card trimite la pagina RO a serviciului: slugul trebuie să existe.
const sluguriRo = new Set(serviciiRo.map((s) => s.data.slug));
const lipsa = serviciiEn.data.lista.filter((s) => !sluguriRo.has(s.slugRo)).map((s) => s.slugRo);
if (lipsa.length) {
  throw new Error(`servicii-en/servicii.yaml: slugRo fără pagină în src/content/servicii/ro/: ${lipsa.join(', ')}`);
}

// Fotografia cardului vine din serviciul românesc; textul alternativ e cel englez.
const dateRo = new Map(serviciiRo.map((s) => [s.data.slug, s.data]));
const carduri = serviciiEn.data.lista.map((s) => ({
  slug: s.slugRo,
  id: s.slugRo,
  titlu: s.titlu,
  rezumat: s.text,
  imagine: dateRo.get(s.slugRo)?.imagine,
  imagineAlt: s.imagineAlt ?? '',
  fotoProvizorie: dateRo.get(s.slugRo)?.fotoProvizorie,
  linkRo: `${cale('servicii', 'ro')}${s.slugRo}/`,
}));
---

<BaseLayout locale={locale} title={t(locale, 'servicii.seoTitlu')} description={t(locale, 'servicii.seoDescriere')}>
  <BandaTitlu locale={locale} titlu={t(locale, 'servicii.titlu')} leadHtml={marcheazaPlaceholder(serviciiEn.data.intro)}>
    <DraftBadge locale={locale} intrare={serviciiEn} />
  </BandaTitlu>

  <Sectiune>
    {/* Cardurile sunt primul nivel de conținut sub h1, deci titlurile lor sunt h2. */}
    <GrilaServicii locale={locale} servicii={carduri} nivel="h2" />
    <p class="nota-norme">{t(locale, 'servicii.intro')}</p>
  </Sectiune>

  <SectiuneCta locale={locale} birou={birou} titlu={acasa.data.final.titlu} text={acasa.data.final.text} />
</BaseLayout>

<style>
  .nota-norme {
    margin-top: var(--space-4);
    color: var(--c-muted);
  }
</style>
