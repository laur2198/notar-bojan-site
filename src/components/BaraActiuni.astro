---
/**
 * Bara fixă de jos, doar sub 768 px (CLAUDE.md §4): patru acțiuni egale, cu
 * iconiță (ink) și etichetă dedesubt: Sunați, WhatsApp (filă nouă), Programare și
 * Locație (Google Maps). Programul rămâne pe Acasă, la ancora #program.
 * Respectă `env(safe-area-inset-bottom)`; spațiul de sub conținut e rezervat în
 * global.css (`--inaltime-bara`).
 *
 * Linkurile încă necompletate (doar în preview) rămân vizibile, fără `href`,
 * cu `aria-disabled="true"`.
 */
import { cale, t, type Locale } from '../i18n';
import { linkExtern, linkTelefon, linkWhatsapp, type LinkContact } from '../lib/contact';
import type { Birou } from '../lib/continut';
import Iconita from './Iconita.astro';

interface Props {
  locale: Locale;
  birou: Birou;
}

const { locale, birou } = Astro.props;

interface Actiune {
  iconita: 'telefon' | 'whatsapp' | 'calendar' | 'pin';
  eticheta: string;
  link: LinkContact;
  extern?: boolean;
}

const intern = (href: string, text: string): LinkContact => ({ href, text, valid: true });

const actiuni: Actiune[] = [
  { iconita: 'telefon', eticheta: t(locale, 'actiune.suna'), link: linkTelefon(birou) },
  { iconita: 'whatsapp', eticheta: t(locale, 'whatsapp.nume'), link: linkWhatsapp(birou, locale), extern: true },
  {
    iconita: 'calendar',
    eticheta: t(locale, 'actiune.programareScurt'),
    link: intern(cale('programare', locale), ''),
  },
  {
    iconita: 'pin',
    eticheta: t(locale, 'bara.locatie'),
    link: linkExtern(birou.googleMapsUrl, ''),
    extern: true,
  },
];
---

<nav class="bara-actiuni" aria-label={t(locale, 'actiune.bara')}>
  <ul role="list">
    {
      actiuni.map((a) => (
        <li>
          {a.link.valid ? (
            <a
              class="bara-actiuni__link"
              href={a.link.href}
              {...(a.extern && { target: '_blank', rel: 'noopener noreferrer' })}
            >
              <Iconita nume={a.iconita} />
              <span class="bara-actiuni__eticheta">{a.eticheta}</span>
              {a.extern && <span class="sr-only"> {t(locale, 'link.filaNoua')}</span>}
            </a>
          ) : (
            <a class="bara-actiuni__link" role="link" aria-disabled="true">
              <Iconita nume={a.iconita} />
              <span class="bara-actiuni__eticheta">{a.eticheta}</span>
              <span class="sr-only"> ({t(locale, 'link.indisponibil')})</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .bara-actiuni {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 30;
    padding: calc(var(--space-1) / 2) max(calc(var(--space-1) / 2), env(safe-area-inset-right, 0px))
      calc(var(--space-1) / 2 + env(safe-area-inset-bottom, 0px)) max(calc(var(--space-1) / 2), env(safe-area-inset-left, 0px));
    background: var(--c-paper);
    border-top: 1px solid var(--c-line);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 0;
    list-style: none;
  }

  li {
    max-width: none;
  }

  .bara-actiuni__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(var(--space-1) / 2);
    min-height: 56px;
    color: var(--c-ink);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .bara-actiuni__link:hover {
    color: var(--c-ink);
    background: var(--c-paper-2);
  }

  .bara-actiuni__link :global(.iconita) {
    width: 24px;
    height: 24px;
    color: var(--c-ink);
  }

  .bara-actiuni__eticheta {
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
  }

  .bara-actiuni__link[aria-disabled='true'] {
    color: var(--c-muted);
    cursor: not-allowed;
  }

  .bara-actiuni__link[aria-disabled='true'] :global(.iconita) {
    color: var(--c-muted);
    stroke-dasharray: 3 2;
  }

  @media (min-width: 48rem) {
    .bara-actiuni {
      display: none;
    }
  }
</style>
