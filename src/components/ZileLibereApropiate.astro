---
/**
 * Zilele libere apropiate (CLAUDE.md §8), extrase din vechea bandă de informații: calculate în
 * browser (Europe/Bucharest) din `zileLibere`; fără JS sau fără zile apropiate, ascunse (programul
 * săptămânal rămâne complet). Bordura din stânga, nu doar culoarea, marchează nota. Doar tokenuri.
 */
import { t, type Locale } from '../i18n';
import type { Birou } from '../lib/continut';
import { ziLiberaPentru } from '../lib/program';

interface Props {
  locale: Locale;
  birou: Birou;
}

const { locale, birou } = Astro.props;
const date = JSON.stringify({
  zileLibere: birou.zileLibere.map((z) => ziLiberaPentru(z, locale)),
  sablon: t(locale, 'program.inchisPe'),
  locale,
});
---

<div class="zile-libere" data-zile-libere-apropiate={date} hidden></div>

<script>
  import { formateazaZiLuna, type Locale } from '../i18n';
  import { scrieCuFragmentRo, zileLibereApropiate, type ZiLibera } from '../lib/program';

  for (const el of document.querySelectorAll<HTMLElement>('[data-zile-libere-apropiate]')) {
    const { zileLibere, sablon, locale } = JSON.parse(el.dataset.zileLibereApropiate ?? '{}') as {
      zileLibere: ZiLibera[];
      sablon: string;
      locale: Locale;
    };
    const apropiate = zileLibereApropiate(new Date(), zileLibere);
    if (apropiate.length === 0) continue;
    for (const zi of apropiate) {
      const p = document.createElement('p');
      scrieCuFragmentRo(p, sablon.replace('{data}', formateazaZiLuna(locale, zi.data)).replace('{motiv}', zi.motiv), zi.motivRo ? zi.motiv : undefined);
      el.append(p);
    }
    el.hidden = false;
  }
</script>

<style>
  .zile-libere {
    display: grid;
    gap: calc(var(--space-1) / 2);
    padding: var(--space-1) var(--space-2);
    border-left: 3px solid var(--c-rosu);
    background: var(--c-paper-2);
    border-radius: var(--radius);
    font-weight: 600;
  }

  .zile-libere[hidden] {
    display: none;
  }
</style>
