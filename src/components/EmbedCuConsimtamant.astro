---
/**
 * Fațadă cu consimțământ pentru un iframe extern (ex. calendarul de programări Google),
 * conform CLAUDE.md §3.1: la încărcarea paginii NU se încarcă nimic de la Google. Se afișează
 * un text de informare și butonul „Afișați calendarul aici”; abia la click se creează iframe-ul.
 * Fără JS rămâne un link care deschide calendarul într-o filă nouă.
 *
 * NEFOLOSITĂ deocamdată (etapa 5): /programare/ deschide calendarul prin link. Folosire, dacă
 * biroul cere calendarul încorporat (vezi README):
 *   <EmbedCuConsimtamant locale="ro" src={birou.programareUrl} />
 */
import { t, type Locale } from '../i18n';
import { linkExtern } from '../lib/contact';
import Iconita from './Iconita.astro';
import LinkExtern from './LinkExtern.astro';

interface Props {
  locale: Locale;
  /** Adresa https a conținutului încorporat. */
  src: string;
  /** Titlul iframe-ului (pentru cititoarele de ecran). */
  titlu?: string;
  /** Înălțimea iframe-ului, în px. */
  inaltime?: number;
}

const { locale, src, titlu = t(locale, 'embed.titluIframe'), inaltime = 700 } = Astro.props;
const link = linkExtern(src, '');
---

<div class="embed" data-embed={link.valid ? link.href : undefined} data-titlu={titlu} data-inaltime={inaltime}>
  <p class="embed__info">{t(locale, 'embed.info')}</p>
  <div class="embed__actiuni">
    <button type="button" class="btn btn--primar embed__buton" hidden={!link.valid}>{t(locale, 'embed.afiseaza')}</button>
    <LinkExtern locale={locale} link={link} class="btn btn--secundar">
      <Iconita nume="extern" />
      {t(locale, 'embed.deschide')}
    </LinkExtern>
  </div>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-embed]')) {
    const buton = el.querySelector<HTMLButtonElement>('.embed__buton');
    buton?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = el.dataset.embed!;
      iframe.title = el.dataset.titlu ?? '';
      iframe.height = el.dataset.inaltime ?? '700';
      iframe.loading = 'lazy';
      iframe.className = 'embed__iframe';
      el.replaceChildren(iframe);
      iframe.focus();
    });
  }
</script>

<style>
  .embed {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--c-gray-50);
    border: 1px solid var(--c-gray-200);
    border-radius: var(--radius-lg);
  }

  .embed__info {
    color: var(--c-gray-600);
  }

  .embed__actiuni {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .embed :global(.embed__iframe) {
    width: 100%;
    border: 0;
    border-radius: var(--radius);
  }
</style>
