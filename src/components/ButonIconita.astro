---
/**
 * Buton-iconiță pătrat (prototip, `.nav__wa`): min. 48×48 (CLAUDE.md §4), transparent, contur 1 px
 * și iconiță în culoarea textului (tema navbar-ului). Hover: fundalul de hover al temei.
 * Numele accesibil vine din `eticheta` (aria-label), ex. „Sunați: 0268 123 456”.
 * Dacă linkul nu e gata (date «DE COMPLETAT», doar în preview), butonul rămâne vizibil,
 * fără `href` și cu `aria-disabled="true"`.
 * `extern` (WhatsApp): se deschide într-o filă nouă (target="_blank", rel="noopener"), iar
 * eticheta o anunță.
 */
import { t, type Locale } from '../i18n';
import type { LinkContact } from '../lib/contact';
import Iconita from './Iconita.astro';

interface Props {
  locale: Locale;
  iconita: 'telefon' | 'email' | 'whatsapp';
  link: LinkContact;
  eticheta: string;
  extern?: boolean;
}

const { locale, iconita, link, eticheta, extern = false } = Astro.props;
const etichetaActiva = extern ? `${eticheta} ${t(locale, 'link.filaNoua')}` : eticheta;
const indisponibil = `${eticheta} (${t(locale, 'link.indisponibil')})`;
---

{
  link.valid ? (
    <a
      class="buton-iconita"
      href={link.href}
      aria-label={etichetaActiva}
      {...(extern && { target: '_blank', rel: 'noopener' })}
    >
      <Iconita nume={iconita} />
    </a>
  ) : (
    <a class="buton-iconita" role="link" aria-disabled="true" aria-label={indisponibil}>
      <Iconita nume={iconita} />
    </a>
  )
}

<style>
  .buton-iconita {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: max(48px, 2.6em);
    height: max(48px, 2.6em);
    background: transparent;
    color: inherit;
    border: 1px solid currentColor;
    border-radius: var(--radius);
    transition: background-color 0.2s ease;
  }

  .buton-iconita :global(.iconita) {
    width: 1.15em;
    height: 1.15em;
  }

  .buton-iconita:hover {
    background: var(--buton-contur-hover);
    color: inherit;
  }

  .buton-iconita:focus-visible {
    outline-color: var(--buton-focus);
  }

  .buton-iconita[aria-disabled='true'] {
    color: var(--buton-dezactivat);
    border-style: dashed;
    cursor: not-allowed;
  }

  .buton-iconita[aria-disabled='true']:hover {
    background: transparent;
  }
</style>
