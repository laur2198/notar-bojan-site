---
/**
 * Subsolul din prototip (`.footer-wrap`; CLAUDE.md §5; V3b): fundal --c-brand-900 (temă închisă),
 * titlurile și rândul legal în --c-brand-300, linkurile în alb. Intră „de sub
 * conținut”: interiorul urcă (yPercent -25 → 0) și un strat #120A05 se estompează (0.35 → 0), cu
 * scrub, pe intervalul clamp(top bottom) → clamp(top top). Mișcarea o face src/scripts/miscare.ts
 * ([data-footer]), doar cu mișcare permisă; altfel subsolul e static. Când s-a oprit, textul e fix.
 *
 * Patru coloane (2 pe tabletă, 1 pe mobil): Navigare | Contact | Adresă | Program, cu datele din
 * src/content/setari/birou.yaml; marcajele «DE COMPLETAT» rămân marcate (doar în preview).
 * Rândul legal: © an + denumirea oficială, Politica de confidențialitate, CIF. Apoi o linie și
 * wordmark-ul gigant (decorativ), cu spațiu dedesubt pentru descendentul lui „ț”.
 */
import { cale, esteInAltaLimba, t, type CheieRuta, type CheieUI, type Locale } from '../i18n';
import { linkEmail, linkExtern, linkTelefon, linkWhatsapp, type LinkContact } from '../lib/contact';
import { marcheazaPlaceholder, type Birou } from '../lib/continut';
import ProgramSaptamana from './ProgramSaptamana.astro';
import { imparteDenumirea } from '../lib/denumire';
import WordmarkGigant from './WordmarkGigant.astro';

interface Props {
  locale: Locale;
  birou: Birou;
}

const { locale, birou } = Astro.props;
const an = new Date().getFullYear();

/** Recenziile și „Despre” nu au pagină EN (CLAUDE.md §6), deci nu apar în subsolul EN. */
const NAVIGARE: Record<Locale, { cheie: CheieRuta; eticheta: CheieUI }[]> = {
  ro: [
    { cheie: 'servicii', eticheta: 'nav.servicii' },
    { cheie: 'programare', eticheta: 'nav.programare' },
    { cheie: 'faq', eticheta: 'nav.faq' },
    { cheie: 'recenzii', eticheta: 'nav.recenzii' },
    { cheie: 'despre', eticheta: 'nav.despre' },
    { cheie: 'contact', eticheta: 'nav.contact' },
  ],
  en: [
    { cheie: 'servicii', eticheta: 'nav.servicii' },
    { cheie: 'programare', eticheta: 'nav.programare' },
    { cheie: 'faq', eticheta: 'nav.faq' },
    { cheie: 'contact', eticheta: 'nav.contact' },
  ],
};

const navigare = NAVIGARE[locale].map(({ cheie, eticheta }) => ({ href: cale(cheie, locale), text: t(locale, eticheta) }));

interface Contact {
  eticheta: string;
  link: LinkContact;
  /** Textul vizibil; implicit cel al linkului. */
  text?: string;
  extern?: boolean;
}

const contacte: Contact[] = [
  { eticheta: t(locale, 'contact.telefon'), link: linkTelefon(birou) },
  { eticheta: t(locale, 'contact.email'), link: linkEmail(birou.email) },
  { eticheta: t(locale, 'whatsapp.nume'), link: linkWhatsapp(birou, locale), text: t(locale, 'whatsapp.nume'), extern: true },
];

const harta = linkExtern(birou.googleMapsUrl, t(locale, 'harta.deschide'));
const confidentialitate = {
  href: cale('confidentialitate', locale),
  text: t(locale, 'nav.confidentialitate'),
  altaLimba: esteInAltaLimba('confidentialitate', locale),
};
const { strada, codPostal, oras, judet } = birou.adresa;
---

<footer class="subsol pe-inchis" data-tema-sectiune="dark" data-footer>
  <div class="subsol__interior" data-footer-interior>
    <div class="container">
      <div class="subsol__coloane">
        <nav class="subsol__coloana" aria-labelledby="subsol-navigare">
          <h2 id="subsol-navigare" class="subsol__titlu">{t(locale, 'subsol.navigare')}</h2>
          <ul class="subsol__lista" role="list">
            {
              navigare.map((l) => (
                <li>
                  <a class="sub subsol__link" href={l.href}>
                    {l.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <section class="subsol__coloana" aria-labelledby="subsol-contact">
          <h2 id="subsol-contact" class="subsol__titlu">{t(locale, 'subsol.contact')}</h2>
          <ul class="subsol__lista" role="list">
            {
              contacte.map((c) => (
                <li>
                  {c.link.valid ? (
                    <a
                      class="sub subsol__link subsol__rupe"
                      href={c.link.href}
                      {...(c.extern && { target: '_blank', rel: 'noopener noreferrer' })}
                    >
                      <span class="sr-only">{c.eticheta}: </span>
                      {c.text ?? c.link.text}
                      {c.extern && <span class="sr-only"> {t(locale, 'link.filaNoua')}</span>}
                    </a>
                  ) : (
                    <span class="subsol__text subsol__rupe">
                      {c.eticheta}: <Fragment set:html={marcheazaPlaceholder(c.link.text)} />
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
        </section>

        <section class="subsol__coloana" aria-labelledby="subsol-adresa">
          <h2 id="subsol-adresa" class="subsol__titlu">{t(locale, 'subsol.adresa')}</h2>
          <address class="subsol__adresa">
            <span set:html={marcheazaPlaceholder(strada)} /><br />
            <span set:html={marcheazaPlaceholder(codPostal)} />
            {oras}, {t(locale, 'contact.judet', { judet })}
          </address>
          {
            harta.valid && (
              <a class="sub subsol__link" href={harta.href} target="_blank" rel="noopener noreferrer">
                {harta.text}
                <span class="sr-only"> {t(locale, 'link.filaNoua')}</span>
              </a>
            )
          }
        </section>

        <section class="subsol__coloana" aria-labelledby="subsol-program">
          <h2 id="subsol-program" class="subsol__titlu">{t(locale, 'program.titlu')}</h2>
          <ProgramSaptamana locale={locale} program={birou.program} simplu compact />
        </section>
      </div>

      <div class="subsol__legal">
        <p>{t(locale, 'subsol.copyright', { an, denumire: birou.denumire })}</p>
        <p>
          <a class="sub subsol__link" href={confidentialitate.href} hreflang={confidentialitate.altaLimba ? 'ro' : undefined}>
            {confidentialitate.text}
          </a>
        </p>
        {birou.cif && <p set:html={marcheazaPlaceholder(t(locale, 'subsol.cif', { cif: birou.cif }))} />}
        {/* Atribuirea cerută de licența Vecteezy Free pentru mâinile din semnătură (docs/licente.md). */}
        <p>
          {t(locale, 'subsol.atribuire')}{' '}
          <a class="sub subsol__link" href="https://www.vecteezy.com" target="_blank" rel="noopener noreferrer">
            Vecteezy.com<span class="sr-only"> {t(locale, 'link.filaNoua')}</span>
          </a>
        </p>
      </div>
      <div class="subsol__linie" aria-hidden="true"></div>
      <WordmarkGigant
        text={birou.notar}
        sus={imparteDenumirea(birou.denumire, birou.notar).sus}
        eticheta={birou.denumire}
        latime="62"
        class="subsol__wordmark"
      />
    </div>
  </div>
  <div class="subsol__strat" data-footer-strat aria-hidden="true"></div>
</footer>

<style>
  .subsol {
    position: relative;
    overflow: hidden;
    background: var(--c-brand-900);
    color: var(--c-paper);
  }

  .subsol__interior {
    position: relative;
    padding-top: var(--section-y);
  }

  .subsol__coloane {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
  }

  @media (min-width: 40rem) {
    .subsol__coloane {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .subsol__coloane {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .subsol__coloana {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  .subsol__titlu {
    margin-bottom: calc(var(--space-1) / 2);
    /* Bej pe maro închis: 7.9:1. */
    color: var(--c-brand-300);
    font-family: var(--font-sans);
    font-size: var(--fs-base);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .subsol__lista {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .subsol__lista li {
    max-width: none;
  }

  .subsol__link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-weight: 500;
  }

  .subsol__text {
    display: inline-block;
    padding-block: calc(var(--space-1) * 0.75);
  }

  .subsol__rupe {
    overflow-wrap: anywhere;
  }

  .subsol__adresa {
    font-style: normal;
  }

  .subsol__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-4);
    padding-bottom: 0.3em;
    color: var(--c-brand-300);
  }

  .subsol__legal p {
    max-width: none;
  }

  .subsol__legal .subsol__link {
    color: var(--c-brand-300);
    font-weight: 400;
  }

  .subsol__linie {
    height: 1px;
    background: var(--c-brand-300);
  }

  /* Wordmark-ul gigant: spațiu dedesubt, ca descendentul lui „ț” să nu fie tăiat. */
  .subsol :global(.subsol__wordmark) {
    --wordmark-sus-sus: 1.5em;
    padding-bottom: var(--space-3);
    color: var(--c-paper);
  }

  .subsol__strat {
    position: absolute;
    inset: 0;
    background: #120a05;
    opacity: 0;
    pointer-events: none;
  }
</style>
