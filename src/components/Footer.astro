---
/**
 * Subsolul (structură după referința aleasă de clientă): deschis la culoare, aerisit.
 * Fundal paper-2, linie line sus. Patru coloane pe desktop (2 pe tabletă, 1 pe mobil):
 * wordmark + denumirea completă | Contact | Program | Linkuri. Dedesubt, după o linie,
 * „© an denumire” și „Politica de confidențialitate”.
 * Fundalul e deschis, deci focusul e --c-ink (fără `.pe-inchis`).
 */
import { cale, esteInAltaLimba, t, type CheieRuta, type CheieUI, type Locale } from '../i18n';
import { linkEmail, linkTelefon } from '../lib/contact';
import { marcheazaPlaceholder, type Birou } from '../lib/continut';
import Iconita from './Iconita.astro';
import ProgramSaptamana from './ProgramSaptamana.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
  birou: Birou;
}

const { locale, birou } = Astro.props;
const telefon = linkTelefon(birou);
const email = linkEmail(birou.email);
const an = new Date().getFullYear();

/** Recenziile nu au pagină EN (CLAUDE.md §6), deci nu apar în subsolul EN. */
const LINKURI: Record<Locale, { cheie: CheieRuta; eticheta: CheieUI }[]> = {
  ro: [
    { cheie: 'servicii', eticheta: 'nav.servicii' },
    { cheie: 'programare', eticheta: 'nav.programare' },
    { cheie: 'recenzii', eticheta: 'nav.recenzii' },
    { cheie: 'faq', eticheta: 'nav.faq' },
    { cheie: 'contact', eticheta: 'nav.contact' },
  ],
  en: [
    { cheie: 'servicii', eticheta: 'nav.servicii' },
    { cheie: 'programare', eticheta: 'nav.programare' },
    { cheie: 'faq', eticheta: 'nav.faq' },
    { cheie: 'contact', eticheta: 'nav.contact' },
  ],
};

const linkuri = LINKURI[locale].map(({ cheie, eticheta }) => ({ href: cale(cheie, locale), text: t(locale, eticheta) }));
const confidentialitate = {
  href: cale('confidentialitate', locale),
  text: t(locale, 'nav.confidentialitate'),
  altaLimba: esteInAltaLimba('confidentialitate', locale),
};
const { strada, codPostal, oras, judet } = birou.adresa;
---

<footer class="subsol">
  <div class="container">
    <div class="subsol__grila">
      <div class="subsol__coloana">
        <Wordmark locale={locale} birou={birou} />
        <p class="subsol__denumire">{birou.denumire}</p>
      </div>

      <section class="subsol__coloana" aria-labelledby="subsol-contact">
        <h2 id="subsol-contact" class="subsol__titlu">{t(locale, 'subsol.contact')}</h2>
        <ul class="subsol__lista" role="list">
          <li class="subsol__rand">
            <Iconita nume="pin" class="subsol__iconita" />
            <address>
              <span class="sr-only">{t(locale, 'contact.adresa')}: </span>
              <span set:html={marcheazaPlaceholder(strada)} /><br />
              <span set:html={marcheazaPlaceholder(codPostal)} />
              {oras}, {t(locale, 'contact.judet', { judet })}
            </address>
          </li>
          <li class="subsol__rand">
            <Iconita nume="telefon" class="subsol__iconita" />
            {
              telefon.valid ? (
                <a class="subsol__link" href={telefon.href}>
                  <span class="sr-only">{t(locale, 'contact.telefon')}: </span>
                  {telefon.text}
                </a>
              ) : (
                <span>
                  <span class="sr-only">{t(locale, 'contact.telefon')}: </span>
                  <Fragment set:html={marcheazaPlaceholder(telefon.text)} />
                </span>
              )
            }
          </li>
          <li class="subsol__rand">
            <Iconita nume="email" class="subsol__iconita" />
            {
              email.valid ? (
                <a class="subsol__link subsol__email" href={email.href}>
                  <span class="sr-only">{t(locale, 'contact.email')}: </span>
                  {email.text}
                </a>
              ) : (
                <span class="subsol__email">
                  <span class="sr-only">{t(locale, 'contact.email')}: </span>
                  <Fragment set:html={marcheazaPlaceholder(email.text)} />
                </span>
              )
            }
          </li>
        </ul>
      </section>

      <section class="subsol__coloana" aria-labelledby="subsol-program">
        <h2 id="subsol-program" class="subsol__titlu">{t(locale, 'program.titlu')}</h2>
        <ProgramSaptamana locale={locale} program={birou.program} simplu compact />
      </section>

      <nav class="subsol__coloana" aria-labelledby="subsol-linkuri">
        <h2 id="subsol-linkuri" class="subsol__titlu">{t(locale, 'subsol.linkuri')}</h2>
        <ul class="subsol__lista" role="list">
          {
            linkuri.map((l) => (
              <li>
                <a class="subsol__link" href={l.href}>
                  {l.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="subsol__final">
      <p>{t(locale, 'subsol.copyright', { an, denumire: birou.denumire })}</p>
      <p>
        <a class="subsol__link" href={confidentialitate.href} hreflang={confidentialitate.altaLimba ? 'ro' : undefined}>
          {confidentialitate.text}
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .subsol {
    padding-block: var(--section-y-sm);
    background: var(--c-paper-2);
    border-top: 1px solid var(--c-line);
    color: var(--c-ink);
    font-size: var(--fs-sm);
  }

  .subsol__grila {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .subsol__grila {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .subsol__grila {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .subsol__coloana {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .subsol__titlu {
    color: var(--c-ink);
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.4;
  }

  .subsol__denumire {
    color: var(--c-muted);
  }

  .subsol__lista {
    display: grid;
    gap: calc(var(--space-1) / 2);
    padding: 0;
    list-style: none;
  }

  .subsol__lista li {
    max-width: none;
  }

  .subsol__rand {
    display: flex;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .subsol__rand :global(.subsol__iconita) {
    flex: none;
    margin-top: calc(var(--space-1) * 0.75);
    color: var(--c-ink);
  }

  address {
    font-style: normal;
    padding-block: calc(var(--space-1) / 2);
  }

  .subsol__rand > span {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
  }

  /* Linkuri: 16 px, ink, subliniere îngroșată la hover. */
  .subsol__link {
    display: inline-flex;
    align-items: center;
    min-width: 48px;
    min-height: 48px;
    color: var(--c-ink);
    text-decoration: none;
  }

  .subsol__link:hover {
    color: var(--c-ink);
    text-decoration: underline;
    text-decoration-color: var(--c-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .subsol__email {
    overflow-wrap: anywhere;
  }

  .subsol__final {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-3);
    margin-top: var(--space-5);
    padding-top: var(--space-2);
    border-top: 1px solid var(--c-line);
    color: var(--c-muted);
  }

  .subsol__final p {
    max-width: none;
  }

  .subsol__final .subsol__link {
    color: var(--c-muted);
  }
</style>
