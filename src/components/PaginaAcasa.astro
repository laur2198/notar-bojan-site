---
/**
 * Pagina Acasă, aceeași pentru RO (/) și EN (/en/), după prototipul design-v2
 * (docs/design-v2/prototip-acasa.html; CLAUDE.md §5):
 *   hero → frazele mari (sticky) → servicii → cum lucrăm (+ slogan) → întrebări (+ încheiere).
 * Intro-ul cu semnătura și subsolul vin din BaseLayout. Textele vin din pagini/{limba}/acasa.yaml,
 * serviciile din servicii/ro (evidențiate, în ordinea din CMS) sau servicii-en/servicii.yaml,
 * întrebările din faq/{limba}.yaml (cele evidențiate, cel mult `faq.numarAfisat`).
 * Programul, recenziile și „Despre” rămân pe paginile lor (și programul în subsol).
 */
import { getCollection, getEntry } from 'astro:content';
import { cale, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { esteDraft } from '../lib/continut';
import { imagineOgHero, imagineOgImplicita } from '../lib/og';
import DraftBadge from './DraftBadge.astro';
import CumLucram from './acasa/CumLucram.astro';
import FaqAcasa from './acasa/FaqAcasa.astro';
import FrazeSticky from './acasa/FrazeSticky.astro';
import HeroAcasa from './acasa/HeroAcasa.astro';
import ServiciiAcasa, { type ServiciuRand } from './acasa/ServiciiAcasa.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const [acasa, birouIntrare, faq] = await Promise.all([
  getEntry('acasa', `${locale}/acasa`),
  getEntry('birou', 'birou'),
  getEntry('faq', locale),
]);
if (!acasa || !birouIntrare || !faq) {
  throw new Error(`Lipsesc fișiere de conținut pentru pagina Acasă (${locale}): acasa, birou sau faq.`);
}
const birou = birouIntrare.data;
const a = acasa.data;
/** Fotografia din hero: una singură, din pagina română (și pentru /en/); textul alternativ e al fiecărei limbi. */
const acasaRo = locale === 'ro' ? acasa : await getEntry('acasa', 'ro/acasa');
const heroImagine = acasaRo?.data.hero.imagine;
/** Fotografiile pașilor: tot din pagina română, după poziție; textul alternativ e al fiecărei limbi. */
const pasi = a.pasi.lista.map((p, i) => {
  const ro = acasaRo?.data.pasi.lista[i];
  return { ...p, imagine: ro?.imagine, imagineAlt: p.imagineAlt ?? '', provizorie: ro?.fotoProvizorie };
});

let servicii: ServiciuRand[];
let serviciiDraft: boolean;
if (locale === 'en') {
  const serviciiEn = await getEntry('serviciiEn', 'servicii');
  if (!serviciiEn) throw new Error('Lipsește src/content/servicii-en/servicii.yaml.');
  // Fotografiile vin din serviciile românești (după slug); textul alternativ e cel englez.
  const serviciiRo = new Map((await getCollection('servicii')).map((s) => [s.data.slug, s.data]));
  servicii = serviciiEn.data.lista.map((s) => {
    const ro = serviciiRo.get(s.slugRo);
    return {
      titlu: s.titlu,
      rezumat: s.text,
      etichete: s.etichete,
      imagine: ro?.imagine,
      imagineAlt: s.imagineAlt ?? '',
      provizorie: ro?.fotoProvizorie,
      href: `${cale('servicii', 'en')}#${s.slugRo}`,
    };
  });
  serviciiDraft = esteDraft(serviciiEn);
} else {
  const lista = (await getCollection('servicii', (s) => s.data.evidentiat)).sort((x, y) => x.data.ordine - y.data.ordine);
  servicii = lista.map((s) => ({
    titlu: s.data.titlu,
    rezumat: s.data.rezumat,
    etichete: s.data.etichete,
    imagine: s.data.imagine,
    imagineAlt: s.data.imagineAlt,
    provizorie: s.data.fotoProvizorie,
    href: `${cale('servicii', 'ro')}${s.data.slug}/`,
  }));
  serviciiDraft = lista.some((s) => esteDraft(s));
}

/** Întrebările de pe Acasă: cele evidențiate; dacă nu e niciuna, primele din listă. */
const evidentiate = faq.data.intrebari.filter((q) => q.evidentiat);
const intrebari = (evidentiate.length > 0 ? evidentiate : faq.data.intrebari).slice(0, a.faq.numarAfisat);

// og:image: fotografia din hero, dacă există; altfel imaginea implicită a limbii.
const hero = await imagineOgHero(locale);
const imagineOg = hero ? { ...imagineOgImplicita(locale, birou.denumire), ...hero, alt: hero.alt ?? imagineOgImplicita(locale, birou.denumire).alt } : undefined;
---

<BaseLayout locale={locale} title={a.seo.titlu} description={a.seo.descriere} imagineOg={imagineOg} semnaturaInPagina="hero">
  <HeroAcasa
    locale={locale}
    birou={birou}
    titlu={a.hero.titlu}
    subtitlu={a.hero.subtitlu}
    linie={a.hero.linie}
    imagine={heroImagine}
    imagineAlt={a.hero.imagineAlt}
    provizorie={acasaRo?.data.hero.fotoProvizorie}
  >
    <DraftBadge locale={locale} intrare={acasa} />
  </HeroAcasa>
  <FrazeSticky locale={locale} fraze={a.fraze} />
  <ServiciiAcasa locale={locale} titlu={a.servicii.titlu} text={a.servicii.intro} servicii={servicii} draft={serviciiDraft} />
  <CumLucram locale={locale} titlu={a.pasi.titlu} pasi={pasi} slogan={a.pasi.slogan} />
  <FaqAcasa
    locale={locale}
    birou={birou}
    titlu={a.faq.titlu}
    intrebari={intrebari}
    ctaTitlu={a.cta.titlu}
    ctaSubtitlu={a.cta.subtitlu}
  />
</BaseLayout>
