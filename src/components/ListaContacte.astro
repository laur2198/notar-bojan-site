---
/**
 * Lista de contacte directe: telefon, WhatsApp, email (și, opțional, emailul pentru acte și
 * adresa cu linkul spre Google Maps), fiecare cu iconiță și text. Folosită în meniul compact, pe
 * /programare/ și pe /contact/, în RO și EN. Sub listă, nota despre WhatsApp: acolo nu se trimit acte.
 * Varianta `mare` (V4, /contact/): rânduri mari separate prin linii, iconițele în --c-rosu,
 * valoarea în Funnel Display pe --fs-h3. Doar tokenuri.
 *
 * Datele încă necompletate («DE COMPLETAT», doar în preview) apar ca text marcat, fără link.
 * WhatsApp se deschide într-o filă nouă (anunțat pentru cititoarele de ecran).
 */
import { t, type CheieUI, type Locale } from '../i18n';
import { linkEmail, linkExtern, linkTelefon, linkWhatsapp, type LinkContact } from '../lib/contact';
import { marcheazaPlaceholder, type Birou } from '../lib/continut';
import Iconita from './Iconita.astro';

interface Props {
  locale: Locale;
  birou: Birou;
  /** Adaugă emailul pentru acte (pe /contact/). */
  emailActe?: boolean;
  /** Eticheta mică deasupra fiecărui contact („Telefon”, „WhatsApp”, „Email”). */
  etichete?: boolean;
  /** Nota despre WhatsApp și acte, sub listă. */
  nota?: boolean;
  /** Rândul cu adresa și linkul „Deschideți în Google Maps” (pe /contact/). */
  adresa?: boolean;
  /** Rânduri mari, separate prin linii (pe /contact/). */
  mare?: boolean;
  class?: string;
}

const { locale, birou, emailActe = false, etichete = true, nota = true, adresa = false, mare = false, class: clasa } = Astro.props;
const harta = linkExtern(birou.googleMapsUrl, t(locale, 'harta.deschide'));

interface Contact {
  iconita: 'telefon' | 'whatsapp' | 'email';
  eticheta: CheieUI;
  link: LinkContact;
  extern?: boolean;
}

const contacte: Contact[] = [
  { iconita: 'telefon', eticheta: 'contact.telefon', link: linkTelefon(birou) },
  { iconita: 'whatsapp', eticheta: 'whatsapp.nume', link: linkWhatsapp(birou, locale), extern: true },
  { iconita: 'email', eticheta: 'contact.email', link: linkEmail(birou.email) },
  ...(emailActe ? [{ iconita: 'email' as const, eticheta: 'contact.emailActe' as const, link: linkEmail(birou.emailActe) }] : []),
];
---

<div class:list={['contacte', { 'contacte--mare': mare }, clasa]}>
  <ul class="contacte__lista" role="list">
    {
      contacte.map((c) => (
        <li class="contacte__rand">
          <Iconita nume={c.iconita} class="contacte__iconita" />
          <span class="contacte__corp">
            <span class:list={['contacte__eticheta', { 'sr-only': !etichete }]}>
              {t(locale, c.eticheta)}
              {!etichete && ': '}
            </span>
            {c.link.valid ? (
              <a
                class="contacte__link"
                href={c.link.href}
                {...(c.extern && { target: '_blank', rel: 'noopener' })}
              >
                {c.link.text}
                {c.extern && <span class="sr-only"> {t(locale, 'link.filaNoua')}</span>}
              </a>
            ) : (
              <span class="contacte__link contacte__link--indisponibil">
                <span set:html={marcheazaPlaceholder(c.link.text)} />
                <span class="sr-only"> ({t(locale, 'link.indisponibil')})</span>
              </span>
            )}
          </span>
        </li>
      ))
    }
    {
      adresa && (
        <li class="contacte__rand">
          <Iconita nume="pin" class="contacte__iconita" />
          <span class="contacte__corp">
            <span class:list={['contacte__eticheta', { 'sr-only': !etichete }]}>
              {t(locale, 'contact.adresa')}
              {!etichete && ': '}
            </span>
            <address class="contacte__adresa">
              <span set:html={marcheazaPlaceholder(birou.adresa.strada)} />, <span set:html={marcheazaPlaceholder(birou.adresa.codPostal)} />{' '}
              {birou.adresa.oras}, {t(locale, 'contact.judet', { judet: birou.adresa.judet })}
            </address>
            {harta.valid && (
              <a class="sub contacte__harta" href={harta.href} target="_blank" rel="noopener noreferrer">
                {harta.text}
                <span class="sr-only"> {t(locale, 'link.filaNoua')}</span>
              </a>
            )}
          </span>
        </li>
      )
    }
  </ul>
  {nota && <p class="contacte__nota">{t(locale, 'whatsapp.nota')}</p>}
</div>

<style>
  .contacte {
    display: grid;
    gap: var(--space-2);
  }

  .contacte__lista {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .contacte__rand {
    display: flex;
    align-items: flex-start;
    gap: var(--space-1);
    max-width: none;
  }

  .contacte__rand :global(.contacte__iconita) {
    margin-top: calc(var(--space-1) * 0.75);
    color: var(--c-ink);
  }

  .contacte__corp {
    display: grid;
    min-width: 0;
  }

  .contacte__eticheta:not(.sr-only) {
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }

  .contacte__link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .contacte__nota {
    padding: var(--space-1) var(--space-2);
    border-left: 3px solid var(--c-ink);
    background: var(--c-paper-2);
    border-radius: var(--radius);
    color: var(--c-ink);
    font-size: var(--fs-sm);
  }

  /* Pe fundal închis (panoul meniului compact). */
  :global(.pe-inchis) .contacte__rand :global(.contacte__iconita) {
    color: var(--c-paper);
  }

  :global(.pe-inchis) .contacte__eticheta:not(.sr-only) {
    color: var(--c-rosu-300);
  }

  /* Varianta mare (/contact/): rânduri cu linii, iconițele roșii, valoarea mare. */
  .contacte--mare .contacte__lista {
    gap: 0;
    border-top: 1px solid var(--c-line);
  }

  .contacte--mare .contacte__rand {
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--c-line);
  }

  .contacte--mare .contacte__rand :global(.contacte__iconita) {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.15em;
    /* Roșul ca element de interfață (6.6:1 pe alb). */
    color: var(--c-rosu);
  }

  .contacte--mare .contacte__link,
  .contacte--mare .contacte__adresa {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-titlu);
    letter-spacing: -0.01em;
  }

  .contacte__adresa {
    font-style: normal;
  }

  .contacte__harta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    justify-self: start;
    font-weight: 500;
  }

  :global(.pe-inchis) .contacte__nota {
    border-left-color: var(--c-paper);
    background: var(--c-rosu-hover);
    color: var(--c-paper);
  }
</style>
