---
/**
 * /intrebari-frecvente/ și /en/faq/ (V4): AntetPagina, toate întrebările din faq/{ro,en}.yaml în
 * ListaIntrebari (același acordeon ca pe Acasă; aici se pot deschide mai multe; conținutul nu are
 * grupe), CtaFinal și JSON-LD FAQPage cu `inLanguage` al paginii.
 * Răspunsurile încă necompletate («DE COMPLETAT») sunt excluse din JSON-LD.
 */
import { getEntry } from 'astro:content';
import AntetPagina from './AntetPagina.astro';
import CtaFinal from './CtaFinal.astro';
import DraftBadge from './DraftBadge.astro';
import JsonLd from './JsonLd.astro';
import ListaIntrebari from './ListaIntrebari.astro';
import SectiunePagina from './SectiunePagina.astro';
import { caleLogica, t, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBirou } from '../lib/continut';
import { faqPage } from '../lib/jsonld';
import { url } from '../lib/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [faq, acasa, birou] = await Promise.all([getEntry('faq', locale), getEntry('acasa', `${locale}/acasa`), getBirou()]);
if (!faq || !acasa) throw new Error(`Lipsesc faq/${locale}.yaml sau pagini/${locale}/acasa.yaml.`);
const titlu = t(locale, 'faq.titlu');
const firimituri = [{ eticheta: t(locale, 'breadcrumbs.acasa'), href: url(caleLogica('acasa', locale)) }, { eticheta: titlu }];
---

<BaseLayout locale={locale} title={t(locale, 'pagina.seoTitlu', { titlu })} description={t(locale, 'faq.seoDescriere')}>
  <JsonLd date={faqPage(faq.data.intrebari, locale)} slot="head" />
  <AntetPagina locale={locale} titlu={titlu} breadcrumbs={firimituri}>
    <DraftBadge locale={locale} intrare={faq} />
  </AntetPagina>

  <SectiunePagina viu={4} eticheta={titlu}>
    <ListaIntrebari intrebari={faq.data.intrebari} class="faq-pagina__lista" />
  </SectiunePagina>

  <CtaFinal locale={locale} birou={birou} titlu={acasa.data.final.titlu} subtitlu={acasa.data.final.text} />
</BaseLayout>

<style>
  .sectiune-pagina :global(.faq-pagina__lista) {
    max-width: 52rem;
  }
</style>
