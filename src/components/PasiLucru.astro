---
/**
 * „Cum lucrăm”: pașii ca listă ordonată. Numerele 700, ink, într-un cerc subțire ink;
 * pe desktop, o linie ink leagă cercurile (decorativă). Cercul are fundalul secțiunii
 * (`fundal`), ca să acopere capătul liniei.
 */
interface Props {
  pasi: { titlu: string; text: string }[];
  fundal?: 'alb' | 'gri';
}

const { pasi, fundal = 'alb' } = Astro.props;
---

<ol class:list={['pasi', { 'pasi--gri': fundal === 'gri' }]} role="list">
  {
    pasi.map((pas, i) => (
      <li class="pas">
        <span class="pas__numar" aria-hidden="true">
          {i + 1}
        </span>
        <h3 class="pas__titlu">{pas.titlu}</h3>
        <p class="pas__text">{pas.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .pasi {
    --cerc: var(--space-5);
    --pasi-fundal: var(--c-paper);

    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .pasi--gri {
    --pasi-fundal: var(--c-paper-2);
  }

  @media (min-width: 64rem) {
    .pasi {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  .pas {
    position: relative;
    display: grid;
    gap: var(--space-1);
    max-width: none;
  }

  .pas__numar {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--cerc);
    height: var(--cerc);
    margin-bottom: var(--space-1);
    background: var(--pasi-fundal);
    color: var(--c-ink);
    border: 1.5px solid var(--c-ink);
    border-radius: var(--radius-pill);
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1;
  }

  /* Linia de legătură dintre cercuri, doar pe desktop (decorativă). */
  @media (min-width: 64rem) {
    .pas:not(:last-child)::after {
      content: '';
      position: absolute;
      top: calc(var(--cerc) / 2);
      left: calc(var(--cerc) + var(--space-2));
      right: calc(-1 * var(--space-4) + var(--space-2));
      height: 1px;
      background: var(--c-ink);
    }
  }

  .pas__titlu {
    font-size: var(--fs-lg);
  }

  .pas__text {
    color: var(--c-muted);
  }
</style>
