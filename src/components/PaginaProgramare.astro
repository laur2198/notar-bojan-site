---
/**
 * /programare/ și /en/appointments/ (CLAUDE.md §8), V4: AntetPagina (lead = introducerea din
 * programare.md); programarea online (Buton „Alegeți data și ora” spre pagina de programări
 * Google Calendar, în filă nouă, anunțată; inactiv cât `programareUrl` lipsește) și, alături,
 * telefonul, WhatsApp-ul, emailul, starea și programul săptămânal (logica existentă); pașii
 * („Cum lucrăm” din acasa.yaml, aceiași 3 pași ca pe Acasă) în ListaNumerotata; restul textului
 * (Înainte de programare, Anulare); CtaFinal. Fără iframe: calendarul nu se încarcă în pagină.
 */
import { getEntry, render } from 'astro:content';
import AntetPagina from './AntetPagina.astro';
import Buton from './Buton.astro';
import ContinutMarcat from './ContinutMarcat.astro';
import CtaFinal from './CtaFinal.astro';
import DraftBadge from './DraftBadge.astro';
import ListaContacte from './ListaContacte.astro';
import ListaNumerotata from './ListaNumerotata.astro';
import ProgramSaptamana from './ProgramSaptamana.astro';
import SectiunePagina from './SectiunePagina.astro';
import StareProgram from './StareProgram.astro';
import { caleLogica, t, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { linkExtern } from '../lib/contact';
import { getBirou, marcheazaPlaceholder } from '../lib/continut';
import { extrageIntro } from '../lib/markdown';
import { url } from '../lib/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [pagina, acasa] = await Promise.all([getEntry('pagini', `${locale}/programare`), getEntry('acasa', `${locale}/acasa`)]);
if (!pagina || !acasa) throw new Error(`Lipsesc pagini/${locale}/programare.md sau pagini/${locale}/acasa.yaml.`);
const birou = await getBirou();
const { Content } = await render(pagina);
const intro = extrageIntro(pagina.body);
const calendar = linkExtern(birou.programareUrl, '');
const firimituri = [{ eticheta: t(locale, 'breadcrumbs.acasa'), href: url(caleLogica('acasa', locale)) }, { eticheta: pagina.data.titlu }];
---

<BaseLayout locale={locale} title={t(locale, 'pagina.seoTitlu', { titlu: pagina.data.titlu })} description={pagina.data.seoDescriere}>
  <AntetPagina locale={locale} titlu={pagina.data.titlu} lead={intro || undefined} breadcrumbs={firimituri}>
    <DraftBadge locale={locale} intrare={pagina} />
  </AntetPagina>

  <SectiunePagina viu={2} eticheta={t(locale, 'programare.cardTitlu')}>
    <div class="programare__grila">
      <div class="programare__card">
        <h2 id="programare-card" class="programare__titlu">{t(locale, 'programare.cardTitlu')}</h2>
        <Buton
          text={t(locale, 'programare.alegeti')}
          href={calendar.valid ? calendar.href : undefined}
          dezactivat={!calendar.valid}
          target={calendar.valid ? '_blank' : undefined}
          rel={calendar.valid ? 'noopener noreferrer' : undefined}
          textSr={calendar.valid ? t(locale, 'link.filaNoua') : `(${t(locale, 'link.indisponibil')})`}
          class="programare__buton"
        />
        <p class="programare__nota">
          {t(locale, 'programare.nota')} <span aria-hidden="true">{t(locale, 'link.filaNoua')}</span>
        </p>
        {!calendar.valid && <p class="programare__nota" set:html={marcheazaPlaceholder(birou.programareUrl)} />}
      </div>

      <aside class="programare__alaturi" aria-labelledby="programare-altfel">
        <h2 id="programare-altfel" class="programare__titlu">{t(locale, 'programare.altfel')}</h2>
        <ListaContacte locale={locale} birou={birou} />
        <StareProgram locale={locale} program={birou.program} zileLibere={birou.zileLibere} />
        <ProgramSaptamana locale={locale} program={birou.program} captionVizibil />
      </aside>
    </div>
  </SectiunePagina>

  <SectiunePagina ton="paper-2" id="pasi-programare" titlu={acasa.data.pasi.titlu}>
    <ListaNumerotata locale={locale} prefix="pas" elemente={acasa.data.pasi.lista.map((p) => ({ titlu: p.titlu, text: p.text }))} />
  </SectiunePagina>

  <SectiunePagina eticheta={pagina.data.titlu}>
    <div class="continut-articol fara-intro">
      <ContinutMarcat><Content /></ContinutMarcat>
    </div>
  </SectiunePagina>

  <CtaFinal locale={locale} birou={birou} titlu={acasa.data.final.titlu} subtitlu={acasa.data.final.text} />
</BaseLayout>

<style>
  .programare__grila {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 64rem) {
    .programare__grila {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--space-6);
    }
  }

  /* Programarea online: paper-2, linia roșie sus (ca CasetaDosar), fără umbră. */
  .programare__card {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding: var(--space-4);
    background: var(--c-paper-2);
    border-top: 3px solid var(--c-rosu);
    border-radius: var(--radius);
  }

  .programare__titlu {
    font-size: var(--fs-titlu);
    line-height: var(--lh-titlu);
    letter-spacing: var(--ls-titlu);
  }

  .programare__nota {
    color: var(--c-muted);
  }

  .programare__alaturi {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  /* Introducerea e deja în capul paginii: paragrafele de dinaintea primului h2 nu se repetă. */
  .fara-intro :global(> p:not(h2 ~ p)) {
    display: none;
  }
</style>
