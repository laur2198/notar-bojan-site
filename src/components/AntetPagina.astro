---
/**
 * Capul paginilor interioare (CLAUDE.md §5, V4), după hero-ul de pe Acasă, la scară mai mică:
 *   - stânga: breadcrumbs, slotul (DraftBadge), h1 (--fs-h1, ca pe Acasă, niciodată mai mare),
 *     lead-ul opțional în --c-muted, apoi linia scurtă roșie (3 px), doar decorativă, fără text
 *     (V3e: ca linia de sub h1 din hero-ul de pe Acasă; rândul „Notar public · …” a fost scos);
 *   - dreapta, opțional (`fotografie`), fotografia 4:5 (4:3 sub 768 px), cu placeholder-ul
 *     componentei Fotografie dacă imaginea lipsește; de la 992 px pe două coloane, textul centrat
 *     vertical față de ea;
 *   - jos, dividerul pe toată lățimea (data-divider).
 * Fundal: --c-paper + FundalViu `puternic` (sau `discret`, prop-ul `intensitate`), seed 5 (garantat geometric de la 26rem în sus, deci
 * min-height: 26rem), fără urmărirea cursorului. Fără wordmark-ul gigant (doar pe Acasă și în
 * subsol). Tema navbar-ului: light. Mișcarea: [data-reveal] pe h1 și pe lead, [data-divider] pe
 * linii, ca pe Acasă; fără JS și la mișcare redusă, totul vizibil. Doar tokenuri.
 */
import type { ImageMetadata } from 'astro';
import type { Locale } from '../i18n';
import { marcheazaPlaceholder } from '../lib/continut';
import Breadcrumbs, { type Firimitura } from './Breadcrumbs.astro';
import FotoProvizorie from './FotoProvizorie.astro';
import Fotografie from './Fotografie.astro';
import FundalViu from './FundalViu.astro';

interface Props {
  locale: Locale;
  titlu: string;
  /** Lead-ul (trecut prin marcheazaPlaceholder). Doar dacă pagina are deja un astfel de text. */
  lead?: string;
  breadcrumbs?: Firimitura[];
  /** Coloana cu fotografia (placeholder dacă `imagine` lipsește). */
  fotografie?: boolean;
  imagine?: ImageMetadata;
  imagineAlt?: string;
  provizorie?: boolean;
  /** Intensitatea fundalului viu: puternic (implicit) sau discret (ex. Confidențialitate). */
  intensitate?: 'puternic' | 'discret';
}

const { locale, titlu, lead, breadcrumbs, fotografie = false, imagine, imagineAlt = '', provizorie = false, intensitate = 'puternic' } = Astro.props;
---

<section class:list={['antet', { 'antet--cu-foto': fotografie }]} data-tema-sectiune="light" aria-labelledby="antet-titlu" data-antet>
  <FundalViu intensitate={intensitate} seed={5} />
  <div class="container antet__interior">
    <div class="antet__text">
      {breadcrumbs && <Breadcrumbs locale={locale} elemente={breadcrumbs} />}
      <slot />
      <h1 class="antet__titlu" id="antet-titlu" data-reveal set:html={marcheazaPlaceholder(titlu)} />
      {lead && <p class="antet__lead" data-reveal set:html={marcheazaPlaceholder(lead)} />}
      <div class="antet__accent" data-divider aria-hidden="true"></div>
    </div>
    {
      fotografie && (
        <div class="antet__foto">
          <FotoProvizorie locale={locale} provizorie={provizorie && !!imagine} />
          <Fotografie
            locale={locale}
            imagine={imagine}
            alt={imagineAlt}
            raport="4 / 5"
            raportMobil="4 / 3"
            latimi={[480, 720, 960]}
            sizes="(min-width: 62rem) 26rem, 100vw"
            prioritar
            class="antet__img"
          />
        </div>
      )
    }
  </div>
  <div class="container">
    <div class="antet__divider" data-divider aria-hidden="true"></div>
  </div>
</section>

<style>
  .antet {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Seed 5 al fundalului viu e garantat geometric de la această înălțime (src/lib/fundal-viu.ts). */
    min-height: 26rem;
    /* Urcă sub navbar-ul transparent (global.css, main). */
    margin-top: calc(-1 * var(--h-antet));
    padding-top: calc(var(--h-antet) + var(--space-2));
    background: var(--c-paper);
    color: var(--c-ink);
  }

  .antet__interior {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .antet__text {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    align-content: center;
  }

  .antet__text :global(.breadcrumbs) {
    padding-block: 0;
  }

  .antet__titlu {
    max-width: 22em;
    margin: 0;
    font-size: var(--fs-h1);
    line-height: var(--lh-titlu-mare);
    letter-spacing: var(--ls-titlu-mare);
  }

  .antet__lead {
    max-width: 38em;
    margin: 0;
    color: var(--c-muted);
  }

  /* Linia scurtă roșie (ca .hero__accent de pe Acasă; decorativă, fără text). */
  .antet__accent {
    margin-top: var(--space-1);
    width: 4.5rem;
    height: 3px;
    background: var(--c-rosu);
    transform-origin: left center;
  }

  .antet__foto {
    position: relative;
    overflow: hidden;
    border-radius: 0.25em;
  }

  .antet__divider {
    height: 1px;
    background: var(--c-rosu);
    transform-origin: left center;
  }

  @media (min-width: 62rem) {
    .antet--cu-foto .antet__interior {
      grid-template-columns: minmax(0, 1fr) 26rem;
      column-gap: var(--space-6);
      align-items: center;
    }
  }
</style>
