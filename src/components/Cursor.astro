---
/**
 * Cursorul cu bulă (prototip, `.cursor`): un punct care urmărește mouse-ul cu întârziere
 * (lerp 0.22) și o bulă cu text care apare pe elementele cu data-cursor="<text>" (textul vine
 * din atribut, ex. „Vezi serviciul” în V3) și trece în stânga cursorului lângă marginea dreaptă.
 * Doar la (hover: hover) and (pointer: fine) și fără mișcare redusă (altfel nu se afișează și
 * scriptul nu pornește). Decorativ: aria-hidden, pointer-events: none; cursorul nativ rămâne.
 */
---

<div class="cursor" data-cursor-urmaritor aria-hidden="true">
  <span class="cursor__punct"></span>
  <span class="cursor__bula" data-cursor-bula></span>
</div>

<script>
  import { pornesteCursor } from '../scripts/cursor';

  pornesteCursor();
</script>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 150;
    display: none;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .cursor[data-activ] {
      display: block;
    }
  }

  .cursor__punct {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-ink);
    box-shadow: 0 0 0 1.5px var(--c-paper);
  }

  .cursor__bula {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0.3em 0 0 0.5em;
    padding: 0.3em 0.7em;
    border-radius: var(--radius);
    background: var(--c-ink);
    color: var(--c-paper);
    font-size: var(--fs-base);
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    transform: scale(0.9);
    transform-origin: top left;
    transition:
      transform 0.4s var(--ease-out),
      opacity 0.4s var(--ease-out);
  }

  .cursor[data-bula] .cursor__bula {
    opacity: 1;
    transform: scale(1);
  }

  /* Lângă marginea dreaptă, bula trece în stânga cursorului. */
  .cursor[data-margine] .cursor__bula {
    margin: 0.3em 0 0 -0.5em;
    transform: translateX(-100%) scale(1);
    transform-origin: top right;
  }
</style>
