---
/**
 * Hero-ul paginii Acasă, pe toată lățimea (structură după referința aleasă de clientă):
 * fotografie de fundal cu overlay închis sau, până vine fotografia, bloc wood-900 cu eticheta
 * „Fotografie clădire/birou – de completat”. Centrat, alb: h1 cu numele notarului (majuscule
 * prin CSS) și „Notar public în Brașov”, apoi două butoane. Jos, o pastilă cu ratingul Google,
 * doar dacă `rating` și `numarRecenzii` sunt completate (nu se afișează niciodată un rating inventat).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { cale, formateazaNumar, t, tPlural, type Locale } from '../i18n';
import { linkExtern, linkTelefon } from '../lib/contact';
import { marcheazaPlaceholder, type Birou } from '../lib/continut';
import Iconita from './Iconita.astro';
import LinkExtern from './LinkExtern.astro';
import LogoGoogle from './LogoGoogle.astro';
import Semnatura from './Semnatura.astro';
// Pornirea semnăturii: inline, imediat după SVG (înainte de primul paint); hash-ul în CSP.
import scriptDezvaluire from '../scripts/dezvaluire-semnatura.js?raw';
import scriptSemnaturaHero from '../scripts/semnatura-hero.js?raw';
import Stele from './Stele.astro';

interface Props {
  locale: Locale;
  birou: Birou;
  /** Al doilea rând al titlului, ex. „Notar public în Brașov” (din acasa.yaml). */
  profesie: string;
  /** Subtitlul de sub titlu (hero.subtitlu din acasa.yaml). */
  subtitlu?: string;
  imagine?: ImageMetadata;
  imagineAlt?: string;
}

const { locale, birou, profesie, subtitlu, imagine, imagineAlt = '' } = Astro.props;
const telefon = linkTelefon(birou);
const textSuna = t(locale, 'acasa.suna', { telefon: telefon.text });
const areRating = birou.rating !== null && birou.numarRecenzii !== null;
const profilGoogle = linkExtern(birou.googleProfilUrl, '');
---

<section class="hero pe-inchis" aria-labelledby="hero-titlu">
  <div class="hero__fundal">
    {
      imagine ? (
        <>
          <Image
            class="hero__imagine"
            src={imagine}
            alt={imagineAlt}
            widths={[640, 1024, 1600, 2400].filter((w) => w <= imagine.width)}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
          <span class="hero__overlay" aria-hidden="true" />
        </>
      ) : (
        <span class="hero__placeholder">{t(locale, 'hero.fotoDeCompletat')}</span>
      )
    }
  </div>

  <div class="container hero__continut">
    {/* Slot: eticheta „Text propus – în curs de validare”, în preview. */}
    <slot />
    <h1 id="hero-titlu" class="hero__titlu">
      <span class="hero__nume">{birou.notar}</span>
      <span class="hero__profesie" set:html={marcheazaPlaceholder(profesie)} />
    </h1>
    {subtitlu && <p class="hero__subtitlu" set:html={marcheazaPlaceholder(subtitlu)} />}
    <div class="hero__butoane">
      {/* Pe fundal închis: primarul e inversat (fundal alb, text wood-800), secundarul are contur alb. */}
      <a class="btn btn--invers" href={cale('programare', locale)}>{t(locale, 'acasa.programare')}</a>
      {
        telefon.valid ? (
          <a class="btn btn--contur-invers" href={telefon.href}>
            <Iconita nume="telefon" />
            {textSuna}
          </a>
        ) : (
          <a class="btn btn--contur-invers" role="link" aria-disabled="true">
            <Iconita nume="telefon" />
            <span set:html={marcheazaPlaceholder(textSuna)} />
            <span class="sr-only"> ({t(locale, 'actiune.indisponibil')})</span>
          </a>
        )
      }
    </div>
  </div>

  {/* Semnătura „pe rând”: jos-stânga, pe linia fină de la data-linie-y, cât containerul. */}
  <div class="container hero__semnatura">
    <div class="hero__rand">
      <Semnatura varianta="hero" ton="inchis" linie />
      <script is:inline set:html={`${scriptDezvaluire.trim()}\n${scriptSemnaturaHero.trim()}`} />
    </div>
  </div>

  {
    areRating && (
      <div class="container hero__jos">
        <LinkExtern locale={locale} link={profilGoogle} class="hero__rating">
          <LogoGoogle />
          <span class="hero__rating-nota">{formateazaNumar(locale, birou.rating!, 1)}</span>
          <Stele nota={birou.rating!} />
          <span class="sr-only">{t(locale, 'recenzii.notaStele', { nota: formateazaNumar(locale, birou.rating!, 1) })}</span>
          <span aria-hidden="true">·</span>
          <span>{tPlural(locale, 'recenzii.numar', birou.numarRecenzii!)}</span>
        </LinkExtern>
      </div>
    )
  }
</section>


<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto auto;
    /* ~70% din înălțimea ecranului pe mobil */
    min-height: 70svh;
    color: var(--c-white);
    background-color: var(--c-ink);
    overflow: hidden;
  }

  @media (min-width: 64rem) {
    .hero {
      /* Tot ecranul de sub header, dar nu mai mult de 800 px. */
      min-height: min(calc(100svh - var(--header-h)), 800px);
    }
  }

  .hero__fundal {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__imagine {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Overlay închis peste fotografie: textul alb trece AA (16.75:1 pe wood-900 opac). */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgb(42 26 16 / 0.55), rgb(42 26 16 / 0.55));
  }

  .hero__placeholder {
    position: absolute;
    right: var(--gutter);
    top: var(--space-2);
    padding: calc(var(--space-1) / 2) var(--space-1);
    border: 1px dashed var(--c-wood-300);
    border-radius: var(--radius);
    color: var(--c-gray-200);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .hero__continut {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding-block: var(--space-6);
    text-align: center;
  }

  .hero__titlu {
    display: grid;
    gap: var(--space-1);
    max-width: none;
    color: var(--c-white);
  }

  .hero__nume {
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .hero__profesie {
    font-size: var(--fs-base);
    font-weight: 500;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* 18 px, 400, alb 90% (pe wood-900: ~13:1), max. 40ch. */
  .hero__subtitlu {
    max-width: 40ch;
    margin-top: calc(-1 * var(--space-2));
    color: rgb(255 255 255 / 0.9);
    font-size: var(--fs-base);
    font-weight: 400;
    line-height: 1.5;
  }

  .hero__butoane {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
  }

  .hero__butoane .btn {
    flex: 1 1 100%;
  }

  @media (min-width: 30rem) {
    .hero__butoane .btn {
      flex: 0 1 auto;
    }
  }


  /*
   * Linia de semnătură: 1 px, gri deschis atenuat pe fundalul închis (decorativă).
   */
  /*
   * Lățimea semnăturii: 320 px la 375 px viewport → 600 px de la 1024 px, liniar (max-width: 100%
   * pe ecranele mai înguste). Cutia SVG-ului cuprinde tot desenul, inclusiv ce trece sub linie.
   */
  .hero__semnatura {
    --semnatura-latime: clamp(320px, 158.2px + 43.14vw, 600px);
    padding-bottom: var(--space-2);
  }

  /*
   * Când hero-ul are înălțime minimă mai mare decât conținutul, conținutul se centrează peste
   * rândurile 1–2, ca înainte de semnătură, deci titlul și butoanele nu se mută; semnătura ocupă
   * spațiul liber de sub butoane. Asta încape:
   *   - de la 64rem (hero = ecranul de sub header), dacă ecranul are cel puțin 45rem (720 px) înălțime;
   *   - între 48 și 64rem (hero = 70svh), doar pe ecranele înalte (tabletă portret, ≥ 60rem).
   * În rest (mobil, ecrane joase) semnătura rămâne în flux, sub butoane, fără să le atingă.
   * Verificat pe desen (nu doar pe cutia SVG-ului): 1280×720 → 19 px între butoane și semnătură;
   * 1024×700, 1100×690, 1366×700 → în flux, fără suprapunere.
   */
  @media (min-width: 64rem) and (min-height: 45rem), (min-width: 48rem) and (min-height: 60rem) {
    .hero__continut {
      grid-row: 1 / 3;
      grid-column: 1;
    }

    .hero__semnatura {
      grid-row: 2;
      grid-column: 1;
    }
  }

  /*
   * Linia de semnătură e desenată în SVG, la data-linie-y, prelungită spre dreapta; rândul o taie
   * la lățimea containerului (doar pe orizontală, ca desenul să rămână întreg pe verticală).
   */
  .hero__rand {
    overflow-x: clip;
  }

  .hero__jos {
    display: flex;
    justify-content: center;
    padding-bottom: var(--space-3);
  }

  @media (min-width: 48rem) {
    .hero__jos {
      justify-content: flex-start;
    }
  }

  /* Pastila e albă: specificitate peste `.pe-inchis a:not(.btn)` (care deschide linkurile pe fundal închis). */
  .hero .hero__jos :global(a.hero__rating) {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
    min-height: 48px;
    padding: var(--space-1) var(--space-2);
    background: var(--c-white);
    color: var(--c-gray-900);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .hero .hero__jos :global(a.hero__rating:hover) {
    color: var(--c-gray-900);
    text-decoration: underline;
    text-decoration-color: var(--c-red-700);
  }

  .hero__rating-nota {
    font-weight: 700;
  }
</style>
