---
/**
 * Tranziția shutter (prototip, `.shutter`): benzi --c-ink care acoperă secțiunea la ieșire, de
 * jos în sus. Se pune ca ultim copil al unei secțiuni (care trebuie să aibă position: relative);
 * benzile le creează src/scripts/miscare.ts ([data-shutter]): 16 pe desktop, 10 pe tabletă, 6 pe
 * mobil. Decorativă (aria-hidden, fără evenimente de pointer). La mișcare redusă sau fără JS
 * containerul rămâne gol: nu există nicio bandă.
 */
interface Props {
  class?: string;
}

const { class: clasa } = Astro.props;
---

<div class:list={['shutter', clasa]} data-shutter aria-hidden="true"></div>

<style>
  .shutter {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .shutter :global(i) {
    display: block;
    height: 3em;
    background: var(--c-ink);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    will-change: transform;
  }
</style>
