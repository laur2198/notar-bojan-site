---
/**
 * Caseta „Pregătiți dosarul” de pe pagina de serviciu (CLAUDE.md §8): butonul „Trimiteți
 * actele pe email” (mailto: cu subiect și corp precompletat) sus, apoi durata, onorariul (text
 * general din fișierul serviciului + trimiterea la Ordinul MJ nr. 177/C/2024; fără sume, §3.3),
 * actele necesare (listă numerotată 01–0N, numerele în --c-rosu), programarea și telefonul.
 * V4: fundal --c-paper-2, fără umbră, butoanele cu Buton.astro (plin: trimiterea; contur:
 * programarea); sticky pe desktop (poziționarea o dă pagina). Doar tokenuri.
 *
 * Dacă `emailActe` nu e completat (doar în preview), butonul rămâne vizibil, fără `href`,
 * cu `aria-disabled`, iar adresa apare marcată.
 */
import { cale, t, type Locale } from '../i18n';
import { linkActe, linkTelefon } from '../lib/contact';
import { marcheazaPlaceholder, type Birou } from '../lib/continut';
import Buton from './Buton.astro';
import Iconita from './Iconita.astro';

interface Props {
  locale: Locale;
  birou: Birou;
  durata: string;
  onorariu: string;
  acte: string[];
  subiectEmail: string;
  /** Id-ul titlului, pentru aria-labelledby. */
  titluId?: string;
}

const { locale, birou, durata, onorariu, acte, subiectEmail, titluId = 'dosar-titlu' } = Astro.props;

const email = linkActe(birou.emailActe, subiectEmail, {
  salut: t(locale, 'email.salut'),
  nume: t(locale, 'email.nume'),
  telefon: t(locale, 'email.telefon'),
  data: t(locale, 'email.data'),
  observatii: t(locale, 'email.observatii'),
  atasate: t(locale, 'email.atasate'),
});
const telefon = linkTelefon(birou);
---

<aside class="dosar" aria-labelledby={titluId}>
  <h2 id={titluId} class="dosar__titlu">{t(locale, 'dosar.titlu')}</h2>

  {/* Acțiunea principală sus: pe mobil se vede din primul ecran (criteriul etapei 4). */}
  <div class="dosar__trimite">
    <Buton
      text={t(locale, 'dosar.trimite')}
      href={email.valid ? email.href : undefined}
      dezactivat={!email.valid}
      textSr={email.valid ? undefined : `(${t(locale, 'link.indisponibil')})`}
      sageata={false}
      class="dosar__buton"
    />
    {
      !email.valid && (
        <p class="dosar__mic">
          {t(locale, 'dosar.adresa')} <span set:html={marcheazaPlaceholder(email.text)} />
        </p>
      )
    }
    <p class="dosar__mic">{t(locale, 'dosar.notaEmail')}</p>
  </div>

  <dl class="dosar__fapte">
    <div class="dosar__fapt">
      <dt><Iconita nume="ceas" />{t(locale, 'dosar.durata')}</dt>
      <dd set:html={marcheazaPlaceholder(durata)} />
    </div>
    <div class="dosar__fapt">
      <dt><Iconita nume="onorariu" />{t(locale, 'dosar.onorariu')}</dt>
      <dd>
        <span set:html={marcheazaPlaceholder(onorariu)} />
        {/* Trimiterea la norme, o singură dată, aici (nu în fiecare fișier de serviciu). */}
        <span class="dosar__norme">{t(locale, 'dosar.onorariuNorme')}</span>
      </dd>
    </div>
  </dl>

  <h3 class="dosar__subtitlu">{t(locale, 'dosar.acte')}</h3>
  <ol class="dosar__acte" role="list">
    {
      acte.map((act, i) => (
        <li>
          <span class="dosar__nr" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span set:html={marcheazaPlaceholder(act)} />
        </li>
      ))
    }
  </ol>
  <p class="dosar__nota">{t(locale, 'dosar.nota')}</p>

  <div class="dosar__actiuni">
    <Buton text={t(locale, 'acasa.programare')} href={cale('programare', locale)} varianta="contur" class="dosar__buton" />
    <p class="dosar__telefon">
      {t(locale, 'dosar.sunati')}{' '}
      {telefon.valid ? <a href={telefon.href}>{telefon.text}</a> : <span set:html={marcheazaPlaceholder(telefon.text)} />}
    </p>
  </div>
</aside>

<style>
  .dosar {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--c-paper-2);
    border-top: 3px solid var(--c-rosu);
    border-radius: var(--radius);
  }

  @media (min-width: 48rem) {
    .dosar {
      padding: var(--space-4);
    }
  }

  .dosar__titlu {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  .dosar__fapte {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-block: 1px solid var(--c-line);
  }

  .dosar__fapt dt {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--c-ink);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .dosar__fapt dt :global(.iconita) {
    color: var(--c-rosu);
  }

  .dosar__fapt dd {
    margin: calc(var(--space-1) / 2) 0 0;
    max-width: none;
  }

  .dosar__norme {
    display: block;
    margin-top: calc(var(--space-1) / 2);
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }

  .dosar__subtitlu {
    margin-top: var(--space-1);
    font-size: var(--fs-base);
  }

  .dosar__acte {
    display: grid;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-line);
  }

  .dosar__acte li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    max-width: none;
    padding-block: 0.6em;
    border-bottom: 1px solid var(--c-line);
  }

  /* Numărul: roșu, mono (6.2:1 pe paper-2); decorativ, ordinea e dată de <ol>. */
  .dosar__nr {
    flex-shrink: 0;
    color: var(--c-rosu);
    font-family: var(--font-mono);
  }

  .dosar__nota,
  .dosar__mic {
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }

  .dosar__trimite,
  .dosar__actiuni {
    display: grid;
    gap: var(--space-1);
  }

  .dosar__actiuni {
    margin-top: var(--space-1);
    padding-top: var(--space-2);
    border-top: 1px solid var(--c-line);
  }

  .dosar :global(.dosar__buton) {
    width: 100%;
    justify-content: center;
  }

  .dosar__telefon {
    font-weight: 600;
  }

  .dosar__telefon a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
  }
</style>
