---
/**
 * Antetul site-ului (CLAUDE.md §4, §5, §6): alb, fix sus (sticky), 80 px pe desktop,
 * 64 px pe mobil. Fără scroll: o linie gray-200 jos; după scroll: umbră fină (JS).
 *
 * - Desktop (≥ 80rem): wordmark | meniu | RO | EN | telefon | email | „Programare”.
 *   (măsurat: ~1.175 px de conținut; containerul are maximum 1.200 px).
 * - 768 px – 80rem: wordmark | telefon | „Programare” | comutator | „Meniu”
 *   (bara de jos apare doar sub 768 px, iar telefonul trebuie să fie vizibil pe orice ecran).
 * - < 768 px: wordmark | comutator | „Meniu”; telefonul și „Programare” stau în bara de jos.
 *
 * Meniul compact e un `<details>`: se deschide și fără JS. JS adaugă închiderea la
 * Escape (cu focus înapoi pe buton), la click în afara meniului și umbra după scroll.
 */
import { ariaCurent, cale, t, type CheieRuta, type CheieUI, type Locale } from '../i18n';
import { linkEmail, linkTelefon } from '../lib/contact';
import type { Birou } from '../lib/continut';
import ButonIconita from './ButonIconita.astro';
import ComutatorLimba from './ComutatorLimba.astro';
import Iconita from './Iconita.astro';

interface Props {
  locale: Locale;
  birou: Birou;
}

const { locale, birou } = Astro.props;
const pathname = Astro.url.pathname;
const telefon = linkTelefon(birou);
const email = linkEmail(birou.email);

const MENIU: Record<Locale, { cheie: CheieRuta; eticheta: CheieUI }[]> = {
  ro: [
    { cheie: 'servicii', eticheta: 'nav.servicii' },
    { cheie: 'programare', eticheta: 'nav.programare' },
    { cheie: 'faq', eticheta: 'nav.faq' },
    { cheie: 'despre', eticheta: 'nav.despre' },
    { cheie: 'contact', eticheta: 'nav.contact' },
  ],
  en: [
    { cheie: 'servicii', eticheta: 'nav.servicii' },
    { cheie: 'programare', eticheta: 'nav.programare' },
    { cheie: 'faq', eticheta: 'nav.faq' },
    { cheie: 'contact', eticheta: 'nav.contact' },
  ],
};

const linkuri = MENIU[locale].map(({ cheie, eticheta }) => {
  const href = cale(cheie, locale);
  return { href, text: t(locale, eticheta), curent: ariaCurent(href, pathname) };
});

const hrefProgramare = cale('programare', locale);
const programareCurenta = ariaCurent(hrefProgramare, pathname) === 'page' ? 'page' : undefined;
const etichetaTelefon = t(locale, 'acasa.suna', { telefon: telefon.text });
const etichetaEmail = t(locale, 'antet.email', { email: email.text });
---

<header class="antet" data-antet>
  <div class="container antet__interior">
    <a class="wordmark" href={cale('acasa', locale)}>
      <span class="wordmark__nume">{birou.notar}</span>
      <span class="wordmark__profesie">{t(locale, 'wordmark.profesie')} · {birou.adresa.oras}</span>
    </a>

    <!-- Desktop -->
    <div class="antet__desktop">
      <nav aria-label={t(locale, 'nav.principal')}>
        <ul class="meniu" role="list">
          {
            linkuri.map((l) => (
              <li>
                <a href={l.href} aria-current={l.curent}>
                  {l.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ComutatorLimba locale={locale} />
      <ButonIconita locale={locale} iconita="telefon" link={telefon} eticheta={etichetaTelefon} />
      <ButonIconita locale={locale} iconita="email" link={email} eticheta={etichetaEmail} />
      <a class="btn btn--primar" href={hrefProgramare} aria-current={programareCurenta}>
        {t(locale, 'actiune.programare')}
      </a>
    </div>

    <!-- Compact -->
    <div class="antet__compact">
      <div class="antet__tableta">
        <ButonIconita locale={locale} iconita="telefon" link={telefon} eticheta={etichetaTelefon} />
        <a class="btn btn--primar" href={hrefProgramare} aria-current={programareCurenta}>
          {t(locale, 'actiune.programare')}
        </a>
      </div>
      <ComutatorLimba locale={locale} compact />
      <details class="meniu-compact" data-meniu-compact>
        <summary class="meniu-compact__buton">
          <span class="meniu-compact__stare meniu-compact__stare--inchis">
            <Iconita nume="meniu" />
            {t(locale, 'meniu.deschide')}
          </span>
          <span class="meniu-compact__stare meniu-compact__stare--deschis">
            <Iconita nume="inchide" />
            {t(locale, 'meniu.inchide')}
          </span>
        </summary>
        <div class="meniu-compact__panou">
          <nav class="container" aria-label={t(locale, 'nav.principal')}>
            <ul class="meniu-compact__lista" role="list">
              {
                linkuri.map((l) => (
                  <li>
                    <a href={l.href} aria-current={l.curent}>
                      {l.text}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const antet = document.querySelector<HTMLElement>('[data-antet]');
  if (antet) {
    const actualizeaza = () => antet.toggleAttribute('data-derulat', window.scrollY > 0);
    actualizeaza();
    window.addEventListener('scroll', actualizeaza, { passive: true });
  }

  for (const meniu of document.querySelectorAll<HTMLDetailsElement>('[data-meniu-compact]')) {
    const buton = meniu.querySelector('summary');

    meniu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && meniu.open) {
        meniu.open = false;
        buton?.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (meniu.open && e.target instanceof Node && !meniu.contains(e.target)) meniu.open = false;
    });

    // Trecerea la desktop închide meniul compact (ar rămâne deschis, ascuns).
    window.matchMedia('(min-width: 80rem)').addEventListener('change', (e) => {
      if (e.matches) meniu.open = false;
    });
  }
</script>

<style>
  .antet {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--c-white);
    color: var(--c-gray-900);
    box-shadow: 0 1px 0 var(--c-gray-200);
    transition: box-shadow 150ms ease;
  }

  .antet[data-derulat] {
    box-shadow:
      0 1px 0 var(--c-gray-200),
      var(--shadow);
  }

  .antet__interior {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--header-h-sm);
  }

  /* Wordmark pe două rânduri, cu majuscule (prin CSS: textul rămâne normal pentru cititoarele de ecran). */
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 48px;
    color: var(--c-wood-900);
    text-decoration: none;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .wordmark:hover {
    color: var(--c-wood-900);
  }

  .wordmark__nume {
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .wordmark__profesie {
    font-size: calc(var(--fs-sm) * 0.75);
    font-weight: 500;
    color: var(--c-gray-600);
  }

  .wordmark:hover .wordmark__nume {
    text-decoration: underline;
    text-decoration-color: var(--c-red-700);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  /* Sub 480 px numele se poate rupe pe două rânduri; de acolo în sus rămâne pe unul. */
  @media (min-width: 30rem) {
    .wordmark {
      white-space: nowrap;
    }

    .wordmark__nume {
      font-size: var(--fs-lg);
    }
  }

  /* --- Compact (< 80rem) --- */
  .antet__compact {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .antet__tableta {
    display: none;
  }

  @media (min-width: 48rem) {
    .antet__tableta {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      margin-right: var(--space-1);
    }
  }

  .meniu-compact__buton {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-1);
    border: 1px solid var(--c-gray-200);
    border-radius: var(--radius);
    color: var(--c-gray-900);
    font-size: var(--fs-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .meniu-compact__buton::-webkit-details-marker {
    display: none;
  }

  .meniu-compact__buton:hover {
    background: var(--c-gray-50);
  }

  .meniu-compact__buton :global(.iconita) {
    color: var(--c-wood-800);
  }

  .meniu-compact__stare {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-1) * 0.75);
  }

  .meniu-compact__stare--deschis,
  .meniu-compact[open] .meniu-compact__stare--inchis {
    display: none;
  }

  .meniu-compact[open] .meniu-compact__stare--deschis {
    display: inline-flex;
  }

  .meniu-compact__panou {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--c-white);
    border-top: 1px solid var(--c-gray-200);
    box-shadow: var(--shadow);
  }

  .meniu-compact__lista {
    display: grid;
    padding: var(--space-1) 0 var(--space-2);
    list-style: none;
  }

  .meniu-compact__lista li {
    max-width: none;
  }

  .meniu-compact__lista li + li {
    border-top: 1px solid var(--c-gray-200);
  }

  .meniu-compact__lista a {
    display: flex;
    align-items: center;
    min-height: 56px;
    color: var(--c-gray-900);
    font-size: var(--fs-lg);
    font-weight: 600;
    text-decoration: none;
  }

  .meniu-compact__lista a:hover {
    color: var(--c-red-700);
    text-decoration: underline;
  }

  .meniu-compact__lista a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--c-red-700);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.3em;
  }

  /* --- Desktop (≥ 80rem) --- */
  .antet__desktop {
    display: none;
  }

  @media (min-width: 80rem) {
    .antet__interior {
      min-height: var(--header-h);
      gap: var(--space-2);
    }

    .wordmark__nume {
      font-size: var(--fs-base);
    }

    .antet__compact {
      display: none;
    }

    .antet__desktop {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .meniu {
      display: flex;
      padding: 0;
      list-style: none;
    }

    .meniu li {
      max-width: none;
    }

    .meniu a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 48px;
      min-height: 48px;
      padding: calc(var(--space-2) * 1.25) var(--space-2);
      color: var(--c-gray-900);
      font-size: var(--fs-sm);
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
    }

    .meniu a:hover {
      color: var(--c-red-700);
    }

    .meniu a[aria-current] {
      text-decoration: underline;
      text-decoration-color: var(--c-red-700);
      text-decoration-thickness: 3px;
      text-underline-offset: 0.4em;
    }
  }
</style>
