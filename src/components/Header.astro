---
/**
 * Antetul site-ului (CLAUDE.md §4, §5, §6): alb, fix sus (sticky), 80 px pe desktop,
 * 64 px pe mobil. Fără scroll: o linie line jos; după scroll: umbră fină (JS).
 *
 * - Desktop (≥ 67rem = 1072 px): wordmark | meniu | RO | EN | telefon | WhatsApp | „Programare”,
 *   în container (max. 1.200 px). Telefonul e doar iconiță (numărul în aria-label); emailul nu
 *   apare pe desktop (e în /contact/, în footer și în meniul compact).
 *   Pragul e măsurat: header-ul RO cere 1.012 px de conținut, deci încape de la 1.069 px de ecran
 *   (EN, cu meniul mai scurt, de la 1.024 px). Sub prag: varianta compactă.
 * - 768 px – 67rem: wordmark | telefon | „Programare” | comutator | „Meniu”
 *   (bara de jos apare doar sub 768 px, iar telefonul trebuie să fie vizibil pe orice ecran).
 * - < 768 px: wordmark | comutator | „Meniu”; telefonul și „Programare” stau în bara de jos.
 *
 * Meniul compact are, după linkuri, contactele directe (telefon, WhatsApp, email) și nota
 * despre WhatsApp (ListaContacte).
 *
 * Meniul compact e un `<details>`: se deschide și fără JS. JS adaugă închiderea la
 * Escape (cu focus înapoi pe buton), la click în afara meniului și umbra după scroll.
 */
import { ariaCurent, cale, t, type CheieRuta, type CheieUI, type Locale } from '../i18n';
import { linkTelefon, linkWhatsapp } from '../lib/contact';
import type { Birou } from '../lib/continut';
import ButonIconita from './ButonIconita.astro';
import ComutatorLimba from './ComutatorLimba.astro';
import Iconita from './Iconita.astro';
import ListaContacte from './ListaContacte.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
  birou: Birou;
}

const { locale, birou } = Astro.props;
const pathname = Astro.url.pathname;
const telefon = linkTelefon(birou);
const whatsapp = linkWhatsapp(birou, locale);

/** `scurt`: eticheta din meniul de desktop, unde spațiul e limitat (ex. „Întrebări”). */
const MENIU: Record<Locale, { cheie: CheieRuta; eticheta: CheieUI; scurt?: CheieUI }[]> = {
  ro: [
    { cheie: 'servicii', eticheta: 'nav.servicii' },
    { cheie: 'programare', eticheta: 'nav.programare' },
    { cheie: 'faq', eticheta: 'nav.faq', scurt: 'nav.faqScurt' },
    { cheie: 'despre', eticheta: 'nav.despre' },
    { cheie: 'contact', eticheta: 'nav.contact' },
  ],
  en: [
    { cheie: 'servicii', eticheta: 'nav.servicii' },
    { cheie: 'programare', eticheta: 'nav.programare' },
    { cheie: 'faq', eticheta: 'nav.faq' },
    { cheie: 'contact', eticheta: 'nav.contact' },
  ],
};

const linkuri = MENIU[locale].map(({ cheie, eticheta, scurt }) => {
  const href = cale(cheie, locale);
  return { href, text: t(locale, eticheta), textScurt: t(locale, scurt ?? eticheta), curent: ariaCurent(href, pathname) };
});

const hrefProgramare = cale('programare', locale);
const programareCurenta = ariaCurent(hrefProgramare, pathname) === 'page' ? 'page' : undefined;
const etichetaTelefon = t(locale, 'acasa.suna', { telefon: telefon.text });
---

<header class="antet" data-antet>
  <div class="container antet__interior">
    <Wordmark locale={locale} birou={birou} />

    {/* Desktop */}
    <div class="antet__desktop">
      <nav aria-label={t(locale, 'nav.principal')}>
        <ul class="meniu" role="list">
          {
            linkuri.map((l) => (
              <li>
                <a href={l.href} aria-current={l.curent}>
                  {l.textScurt}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ComutatorLimba locale={locale} />
      <ButonIconita locale={locale} iconita="telefon" link={telefon} eticheta={etichetaTelefon} />
      <ButonIconita locale={locale} iconita="whatsapp" link={whatsapp} eticheta={t(locale, 'whatsapp.scrieti')} extern />
      <a class="btn btn--primar" href={hrefProgramare} aria-current={programareCurenta}>
        {t(locale, 'actiune.programare')}
      </a>
    </div>

    {/* Compact */}
    <div class="antet__compact">
      <div class="antet__tableta">
        <ButonIconita locale={locale} iconita="telefon" link={telefon} eticheta={etichetaTelefon} />
        <a class="btn btn--primar" href={hrefProgramare} aria-current={programareCurenta}>
          {t(locale, 'actiune.programare')}
        </a>
      </div>
      <ComutatorLimba locale={locale} compact />
      <details class="meniu-compact" data-meniu-compact>
        <summary class="meniu-compact__buton">
          <span class="meniu-compact__stare meniu-compact__stare--inchis">
            <Iconita nume="meniu" />
            {t(locale, 'meniu.deschide')}
          </span>
          <span class="meniu-compact__stare meniu-compact__stare--deschis">
            <Iconita nume="inchide" />
            {t(locale, 'meniu.inchide')}
          </span>
        </summary>
        <div class="meniu-compact__panou">
          <nav class="container" aria-label={t(locale, 'nav.principal')}>
            <ul class="meniu-compact__lista" role="list">
              {
                linkuri.map((l) => (
                  <li>
                    <a href={l.href} aria-current={l.curent}>
                      {l.text}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="container meniu-compact__contacte">
            <ListaContacte locale={locale} birou={birou} />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const antet = document.querySelector<HTMLElement>('[data-antet]');
  if (antet) {
    const actualizeaza = () => antet.toggleAttribute('data-derulat', window.scrollY > 0);
    actualizeaza();
    window.addEventListener('scroll', actualizeaza, { passive: true });
  }

  for (const meniu of document.querySelectorAll<HTMLDetailsElement>('[data-meniu-compact]')) {
    const buton = meniu.querySelector('summary');

    meniu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && meniu.open) {
        meniu.open = false;
        buton?.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (meniu.open && e.target instanceof Node && !meniu.contains(e.target)) meniu.open = false;
    });

    // Trecerea la desktop închide meniul compact (ar rămâne deschis, ascuns).
    window.matchMedia('(min-width: 67rem)').addEventListener('change', (e) => {
      if (e.matches) meniu.open = false;
    });
  }
</script>

<style>
  .antet {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--c-paper);
    color: var(--c-ink);
    box-shadow: 0 1px 0 var(--c-line);
    transition: box-shadow 150ms ease;
  }

  .antet[data-derulat] {
    box-shadow:
      0 1px 0 var(--c-line),
      var(--shadow);
  }

  .antet__interior {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--header-h-sm);
  }

  /* --- Compact (< 67rem) --- */
  .antet__compact {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .antet__tableta {
    display: none;
  }

  @media (min-width: 48rem) {
    .antet__tableta {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      margin-right: var(--space-1);
    }
  }

  .meniu-compact__buton {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-1);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    color: var(--c-ink);
    font-size: var(--fs-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .meniu-compact__buton::-webkit-details-marker {
    display: none;
  }

  .meniu-compact__buton:hover {
    background: var(--c-paper-2);
  }

  .meniu-compact__buton :global(.iconita) {
    color: var(--c-ink);
  }

  .meniu-compact__stare {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-1) * 0.75);
  }

  .meniu-compact__stare--deschis,
  .meniu-compact[open] .meniu-compact__stare--inchis {
    display: none;
  }

  .meniu-compact[open] .meniu-compact__stare--deschis {
    display: inline-flex;
  }

  .meniu-compact__panou {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--c-paper);
    border-top: 1px solid var(--c-line);
    box-shadow: var(--shadow);
  }

  .meniu-compact__lista {
    display: grid;
    padding: var(--space-1) 0 var(--space-2);
    list-style: none;
  }

  .meniu-compact__lista li {
    max-width: none;
  }

  .meniu-compact__contacte {
    padding-block: var(--space-2) var(--space-3);
    border-top: 1px solid var(--c-line);
  }

  /* Pe tabletă, contactele stau pe un rând (cât încap); pe telefon, unul sub altul. */
  @media (min-width: 48rem) {
    .meniu-compact__contacte :global(.contacte__lista) {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--space-4);
    }

    .meniu-compact__contacte :global(.contacte__link) {
      overflow-wrap: normal;
    }
  }

  /* Meniul compact derulează dacă nu încape (telefon în poziție orizontală). */
  .meniu-compact__panou {
    max-height: calc(100svh - var(--header-h-sm));
    overflow-y: auto;
  }

  .meniu-compact__lista li + li {
    border-top: 1px solid var(--c-line);
  }

  .meniu-compact__lista a {
    display: flex;
    align-items: center;
    min-height: 56px;
    color: var(--c-ink);
    font-size: var(--fs-lg);
    font-weight: 600;
    text-decoration: none;
  }

  .meniu-compact__lista a:hover {
    color: var(--c-ink);
    text-decoration: underline;
  }

  .meniu-compact__lista a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--c-ink);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.3em;
  }

  /* --- Desktop (≥ 67rem) --- */

  .antet__desktop {
    display: none;
  }

  @media (min-width: 67rem) {
    .antet__interior {
      min-height: var(--header-h);
      gap: var(--space-2);
    }

    .antet__compact {
      display: none;
    }

    .antet__desktop {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .meniu {
      display: flex;
      padding: 0;
      list-style: none;
    }

    .meniu li {
      max-width: none;
    }

    .meniu a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 48px;
      min-height: 48px;
      /* 16 px, 500, 12 px stânga–dreapta: meniul complet încape de la 1024 px. */
      padding: 0 calc(var(--space-1) * 1.5);
      color: var(--c-ink);
      font-size: var(--fs-sm);
      font-weight: 500;
      text-decoration: none;
      white-space: nowrap;
    }

    .meniu a:hover {
      color: var(--c-ink);
    }

    .meniu a[aria-current] {
      text-decoration: underline;
      text-decoration-color: var(--c-ink);
      text-decoration-thickness: 3px;
      text-underline-offset: 0.4em;
    }
  }

</style>
