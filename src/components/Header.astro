---
/**
 * Navbar-ul (prototip, `.nav`; CLAUDE.md §4, §5, §6): fix sus, TRANSPARENT, fără umbră și fără
 * linie. Culoarea vine din data-tema (light / dark), pusă de src/scripts/tema-navbar.ts după
 * secțiunea de sub el ([data-tema-sectiune]), cu tranziție de 0.4 s. Excepție aprobată de la
 * „header plin” (CLAUDE.md §5): textul paginii poate trece pe sub navbar la derulare.
 *
 * - Desktop (≥ PRAG, vezi stilurile): wordmark | Servicii · Programare · Întrebări · Contact |
 *   RO|EN · telefon · WhatsApp · Buton „Programare”. Linkurile au linia care se trage la hover
 *   (.sub); pagina curentă (aria-current) o are trasă permanent.
 * - Sub prag: wordmark | telefon | (Programare, de la 768 px: §4 cere butonul vizibil pe orice
 *   ecran, iar bara de jos apare doar sub 768 px) | „Meniu”.
 * - „Meniu” e un <details> (merge fără JS) care se deschide ca panou pe tot ecranul, --c-ink:
 *   linkurile mari (Funnel Display, rânduri din mască la deschidere, doar cu mișcare permisă),
 *   contactele (ListaContacte) și comutatorul de limbă. Cât e deschis, derularea paginii e
 *   blocată (CSS :has) și navbar-ul trece pe tema închisă. JS: Escape închide și readuce
 *   focusul pe buton, Tab rămâne în panou, trecerea la desktop închide meniul.
 */
import { ariaCurent, cale, t, type CheieRuta, type CheieUI, type Locale } from '../i18n';
import { linkTelefon, linkWhatsapp } from '../lib/contact';
import type { Birou } from '../lib/continut';
import Buton from './Buton.astro';
import ButonIconita from './ButonIconita.astro';
import ComutatorLimba from './ComutatorLimba.astro';
import Iconita from './Iconita.astro';
import ListaContacte from './ListaContacte.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
  birou: Birou;
  /** Tema la încărcare (secțiunea de sus a paginii); apoi o actualizează tema-navbar.ts. */
  tema?: 'light' | 'dark';
}

const { locale, birou, tema = 'light' } = Astro.props;
const pathname = Astro.url.pathname;
const telefon = linkTelefon(birou);
const whatsapp = linkWhatsapp(birou, locale);

interface Legatura {
  cheie: CheieRuta;
  eticheta: CheieUI;
  /** Eticheta din bara de desktop, unde spațiul e limitat. */
  scurt?: CheieUI;
  /** Doar în meniul compact (pe desktop e în subsol). */
  doarCompact?: boolean;
}

const MENIU: Record<Locale, Legatura[]> = {
  ro: [
    { cheie: 'servicii', eticheta: 'nav.servicii' },
    { cheie: 'programare', eticheta: 'nav.programare' },
    { cheie: 'faq', eticheta: 'nav.faq', scurt: 'nav.faqScurt' },
    { cheie: 'despre', eticheta: 'nav.despre', doarCompact: true },
    { cheie: 'contact', eticheta: 'nav.contact' },
  ],
  en: [
    { cheie: 'servicii', eticheta: 'nav.servicii' },
    { cheie: 'programare', eticheta: 'nav.programare' },
    { cheie: 'faq', eticheta: 'nav.faq', scurt: 'nav.faqScurt' },
    { cheie: 'contact', eticheta: 'nav.contact' },
  ],
};

const linkuri = MENIU[locale].map(({ cheie, eticheta, scurt, doarCompact }) => {
  const href = cale(cheie, locale);
  return {
    href,
    text: t(locale, eticheta),
    textScurt: t(locale, scurt ?? eticheta),
    doarCompact: !!doarCompact,
    curent: ariaCurent(href, pathname),
  };
});

const hrefProgramare = cale('programare', locale);
const programareCurenta = ariaCurent(hrefProgramare, pathname) === 'page' ? 'page' : undefined;
const etichetaTelefon = t(locale, 'acasa.suna', { telefon: telefon.text });
---

<header class="antet" data-navbar data-tema={tema}>
  <div class="container antet__bara">
    <Wordmark locale={locale} birou={birou} />

    <nav class="antet__linkuri" aria-label={t(locale, 'nav.principal')}>
      <ul role="list">
        {
          linkuri
            .filter((l) => !l.doarCompact)
            .map((l) => (
              <li>
                <a class="sub" href={l.href} aria-current={l.curent}>
                  {l.textScurt}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>

    <div class="antet__dreapta">
      <ComutatorLimba locale={locale} class="antet__limba" compact />
      <span class="antet__iconita">
        <ButonIconita locale={locale} iconita="telefon" link={telefon} eticheta={etichetaTelefon} />
      </span>
      <span class="antet__iconita antet__whatsapp">
        <ButonIconita locale={locale} iconita="whatsapp" link={whatsapp} eticheta={t(locale, 'whatsapp.scrieti')} extern />
      </span>
      <Buton
        class="antet__programare"
        text={t(locale, 'actiune.programareScurt')}
        href={hrefProgramare}
        aria-current={programareCurenta}
      />

      <details class="meniu-compact" data-meniu-compact>
        <summary class="meniu-compact__buton">
          <span class="meniu-compact__stare meniu-compact__stare--inchis">
            <Iconita nume="meniu" />
            {t(locale, 'meniu.deschide')}
          </span>
          <span class="meniu-compact__stare meniu-compact__stare--deschis">
            <Iconita nume="inchide" />
            {t(locale, 'meniu.inchide')}
          </span>
        </summary>
        <div class="meniu-compact__panou pe-inchis" data-tema-sectiune="dark">
          <div class="container meniu-compact__interior">
            <nav aria-label={t(locale, 'nav.principal')}>
              <ul class="meniu-compact__lista" role="list">
                {
                  linkuri.map((l) => (
                    <li>
                      <a href={l.href} aria-current={l.curent}>
                        <span class="meniu-compact__rand">{l.text}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
            <div class="meniu-compact__contacte">
              <ListaContacte locale={locale} birou={birou} />
              <ComutatorLimba locale={locale} />
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  import { pornesteTemaNavbar } from '../scripts/tema-navbar';

  pornesteTemaNavbar();

  const SELECTOR_FOCALIZABIL = 'a[href], button:not([disabled]), summary, [tabindex]:not([tabindex="-1"])';

  for (const meniu of document.querySelectorAll<HTMLDetailsElement>('[data-meniu-compact]')) {
    const buton = meniu.querySelector('summary');

    meniu.addEventListener('keydown', (e) => {
      if (!meniu.open) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        meniu.open = false;
        buton?.focus();
        return;
      }
      // Focusul rămâne în panou: Tab de pe ultimul element revine la „Închide” și invers.
      if (e.key !== 'Tab') return;
      const elemente = [...meniu.querySelectorAll<HTMLElement>(SELECTOR_FOCALIZABIL)].filter((el) => el.getClientRects().length > 0);
      const primul = elemente[0];
      const ultimul = elemente[elemente.length - 1];
      if (!primul || !ultimul) return;
      if (e.shiftKey && document.activeElement === primul) {
        e.preventDefault();
        ultimul.focus();
      } else if (!e.shiftKey && document.activeElement === ultimul) {
        e.preventDefault();
        primul.focus();
      }
    });

    // Trecerea la desktop închide meniul compact (ar rămâne deschis, ascuns).
    const desktop = window.matchMedia('(min-width: 74rem)');
    desktop.addEventListener('change', (e) => {
      if (e.matches) meniu.open = false;
    });
  }
</script>

<style>
  .antet {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    color: var(--c-ink);
    transition: color 0.4s ease;
  }

  .antet[data-tema='dark'] {
    color: var(--c-paper);
  }

  .antet[data-fara-tranzitie] {
    transition: none;
  }

  /*
   * Fără JS, tema nu se poate actualiza la derulare: navbar-ul primește fundal plin, în tema
   * de la încărcare, ca textul să nu ajungă niciodată pe un fundal de aceeași culoare.
   */
  :global(html:not(.js)) .antet {
    background: var(--c-paper);
  }

  :global(html:not(.js)) .antet[data-tema='dark'] {
    background: var(--c-ink);
  }

  /* Meniul deschis: panoul e închis la culoare, deci navbar-ul trece pe tema închisă. */
  .antet:has(.meniu-compact[open]) {
    color: var(--c-paper);
    --buton-plin-bg: var(--c-paper);
    --buton-plin-fg: var(--c-ink);
    --buton-plin-hover: var(--c-paper-hover);
    --buton-contur-fg: var(--c-paper);
    --buton-contur-hover: var(--c-ink-3);
    --buton-focus: var(--c-paper);
    --buton-dezactivat: var(--c-muted-dark);
  }

  .antet :focus-visible {
    outline-color: var(--buton-focus);
  }

  .antet__bara {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--header-h-sm);
  }

  .antet__dreapta {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }

  .antet__iconita {
    display: inline-flex;
  }

  /* Ce apare doar pe desktop. */
  .antet__linkuri,
  .antet__dreapta :global(.antet__limba),
  .antet__whatsapp {
    display: none;
  }

  /* Programare: de la 768 px (sub, e în bara de jos). */
  .antet__dreapta :global(.antet__programare) {
    display: none;
  }

  @media (min-width: 48rem) {
    .antet__dreapta :global(.antet__programare) {
      display: inline-flex;
    }
  }

  /* --- Meniul compact --- */
  .meniu-compact__buton {
    display: inline-flex;
    align-items: center;
    min-height: max(48px, 2.6em);
    padding: 0 0.8em;
    border: 1px solid currentColor;
    border-radius: var(--radius);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color 0.2s ease;
  }

  .meniu-compact__buton::-webkit-details-marker {
    display: none;
  }

  .meniu-compact__buton:hover {
    background: var(--buton-contur-hover);
  }

  .meniu-compact__stare {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .meniu-compact__stare--deschis,
  .meniu-compact[open] .meniu-compact__stare--inchis {
    display: none;
  }

  .meniu-compact[open] .meniu-compact__stare--deschis {
    display: inline-flex;
  }

  /* Panoul: tot ecranul, sub bara navbar-ului (care rămâne deasupra, cu „Închide”). */
  .meniu-compact__panou {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-top: var(--header-h-sm);
    background: var(--c-ink);
    color: var(--c-paper);
  }

  :global(html:has(.meniu-compact[open])) {
    overflow: hidden;
  }

  .meniu-compact__interior {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-4) calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
  }

  .meniu-compact__lista {
    display: grid;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-line-dark);
  }

  .meniu-compact__lista li {
    max-width: none;
    border-bottom: 1px solid var(--c-line-dark);
  }

  .meniu-compact__lista a {
    display: block;
    overflow: hidden;
    padding-block: 0.25em;
    color: var(--c-paper);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: var(--fw-titlu);
    letter-spacing: var(--ls-h2);
    line-height: 1.2;
    text-decoration: none;
  }

  .meniu-compact__rand {
    display: inline-block;
  }

  .meniu-compact__lista a:hover .meniu-compact__rand,
  .meniu-compact__lista a[aria-current] .meniu-compact__rand {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.15em;
  }

  .meniu-compact__lista a[aria-current] .meniu-compact__rand {
    text-decoration-thickness: 0.1em;
  }

  .meniu-compact__contacte {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  /* Rânduri din mască la deschidere, doar cu mișcare permisă. */
  @media (prefers-reduced-motion: no-preference) {
    .meniu-compact[open] .meniu-compact__rand {
      animation: meniu-rand 0.8s var(--ease-out) both;
    }

    .meniu-compact[open] li:nth-child(2) .meniu-compact__rand {
      animation-delay: 80ms;
    }

    .meniu-compact[open] li:nth-child(3) .meniu-compact__rand {
      animation-delay: 160ms;
    }

    .meniu-compact[open] li:nth-child(4) .meniu-compact__rand {
      animation-delay: 240ms;
    }

    .meniu-compact[open] li:nth-child(5) .meniu-compact__rand {
      animation-delay: 320ms;
    }
  }

  @keyframes meniu-rand {
    from {
      transform: translateY(110%);
    }
  }

  /*
   * --- Desktop (≥ 74rem = 1184 px) ---
   * Pragul e măsurat cu fonturile încărcate, la textul de bază de 18 px (grila 1fr auto 1fr cere
   * 2 × max(stânga, dreapta) + centru + spații): RO are nevoie de ~1.151 px, EN de ~1.035 px.
   * Peste 1440 px totul crește proporțional cu textul de bază, deci încape și acolo. 1184 px lasă
   * o marjă de ~16 px pe fiecare parte; laptopurile de 1280 px au meniul complet.
   */
  @media (min-width: 74rem) {
    .antet__bara {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      min-height: var(--header-h);
    }

    .antet__linkuri {
      display: block;
    }

    .antet__linkuri ul {
      display: flex;
      gap: 2em;
      padding: 0;
      list-style: none;
    }

    .antet__linkuri li {
      max-width: none;
    }

    .antet__linkuri a {
      display: inline-flex;
      align-items: center;
      min-height: 48px;
      color: inherit;
      white-space: nowrap;
    }

    .antet__dreapta {
      justify-self: end;
    }

    .antet__dreapta :global(.antet__limba),
    .antet__whatsapp {
      display: inline-flex;
    }

    .meniu-compact {
      display: none;
    }
  }
</style>
