---
/**
 * „Despre notar” pe Acasă: continuă vizual banda de informații (tot paper-2).
 * Stânga portretul 2:3 (pe mobil, deasupra, lat: 4:3), dreapta titlul, textul și linkul.
 * Fără etichetă cu majuscule deasupra titlului.
 *
 * `caseta` (pe /en/): textul e o notă importantă (limba actului, interpretul autorizat) și
 * apare într-o casetă de informare: fundal alb, contur line, radius-lg, iconiță „i” ink.
 * Linkul spre /despre/ duce la o pagină în română: primește hreflang="ro".
 */
import type { ImageMetadata } from 'astro';
import { cale, esteInAltaLimba, t, type Locale } from '../i18n';
import { marcheazaPlaceholder } from '../lib/continut';
import Fotografie from './Fotografie.astro';
import Iconita from './Iconita.astro';

interface Props {
  locale: Locale;
  titlu: string;
  text: string;
  imagine?: ImageMetadata;
  imagineAlt?: string;
  caseta?: boolean;
}

const { locale, titlu, text, imagine, imagineAlt, caseta = false } = Astro.props;
const paragrafe = text.split('\n\n');
const linkAltaLimba = esteInAltaLimba('despre', locale);
---

<section class="despre" aria-labelledby="despre-titlu">
  <div class="container despre__interior">
    <div class="despre__foto">
      <Fotografie
        locale={locale}
        imagine={imagine}
        alt={imagineAlt}
        raport="2 / 3"
        raportMobil="4 / 3"
        latimi={[400, 700, 1000]}
        sizes="(min-width: 48rem) 21rem, 100vw"
      />
    </div>
    <div class="despre__text">
      <h2 id="despre-titlu">{titlu}</h2>
      {
        caseta ? (
          <div class="despre__caseta" role="note" aria-label={t(locale, 'despre.nota')}>
            <Iconita nume="info" class="despre__caseta-iconita" />
            <div class="despre__caseta-text">
              {paragrafe.map((p) => <p set:html={marcheazaPlaceholder(p)} />)}
            </div>
          </div>
        ) : (
          paragrafe.map((p) => <p set:html={marcheazaPlaceholder(p)} />)
        )
      }
      <p>
        <a class="despre__link" href={cale('despre', locale)} hreflang={linkAltaLimba ? 'ro' : undefined}>
          {t(locale, 'acasa.despreLink')}
          <Iconita nume="sageata" />
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .despre {
    padding-bottom: var(--section-y);
    background: var(--c-paper-2);
  }

  .despre__interior {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .despre__interior {
      flex-direction: row;
      align-items: center;
      gap: var(--space-5);
    }

    .despre__foto {
      flex: 0 0 21rem;
    }
  }

  .despre__text {
    display: grid;
    gap: var(--space-2);
  }

  .despre__text h2 {
    margin-bottom: calc(var(--space-1) / 2);
  }

  .despre__caseta {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
  }

  .despre__caseta :global(.despre__caseta-iconita) {
    flex: none;
    width: var(--space-4);
    height: var(--space-4);
    color: var(--c-ink);
  }

  .despre__caseta-text {
    display: grid;
    gap: var(--space-1);
    font-weight: 500;
  }

  .despre__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 48px;
    font-weight: 700;
  }

  .despre__link :global(.iconita) {
    color: var(--c-ink);
  }
</style>
