---
/**
 * Card cu o recenzie reală de pe Google (CLAUDE.md §3.4, §7): nota, textul trunchiat la
 * ~5 rânduri (cu „Citiți tot” spre /recenzii/), autorul, data și sursa. Nu se folosește
 * niciodată cu recenzii generate.
 *
 * `limba` (implicit „ro”): dacă diferă de limba paginii, textul recenziei și autorul primesc
 * atributul `lang` (cititoarele de ecran pronunță corect; `verifica:en` le ignoră).
 */
import { esteInAltaLimba, formateazaNumar, LOCALE_INTL, t, type Locale } from '../i18n';
import LogoGoogle from './LogoGoogle.astro';
import Stele from './Stele.astro';

interface Props {
  locale: Locale;
  autor: string;
  data: string;
  nota: number;
  text: string;
  /** Linkul „Citiți tot” (spre /recenzii/); lipsește pe pagina /recenzii/. */
  hrefToate?: string;
  /** Textul întreg, fără trunchiere (pe /recenzii/). */
  complet?: boolean;
  /** Limba în care e scrisă recenzia (recenzii.yaml); lipsă = română. */
  limba?: 'ro' | 'en' | 'de' | 'fr' | 'hu' | 'it' | 'es';
}

const { locale, autor, data, nota, text, hrefToate, complet = false, limba = 'ro' } = Astro.props;
const lang = limba !== locale ? limba : undefined;
const dataAfisata = new Intl.DateTimeFormat(LOCALE_INTL[locale], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
  new Date(`${data}T00:00:00Z`),
);
const notaText = formateazaNumar(locale, nota, 0);
---

<article class="card-recenzie">
  <p class="card-recenzie__nota">
    <Stele nota={nota} />
    <span class="sr-only">{t(locale, 'recenzii.notaStele', { nota: notaText })}</span>
  </p>
  <blockquote class:list={['card-recenzie__text', { 'card-recenzie__text--complet': complet }]} lang={lang}>
    <p>{text}</p>
  </blockquote>
  {
    !complet && hrefToate && (
      <a class="card-recenzie__tot" href={hrefToate} hreflang={esteInAltaLimba('recenzii', locale) ? 'ro' : undefined}>
        {t(locale, 'recenzii.citestiTot')}
      </a>
    )
  }
  <footer class="card-recenzie__subsol">
    <LogoGoogle />
    <span>
      <strong lang={lang}>{autor}</strong>
      <span class="card-recenzie__meta"><time datetime={data}>{dataAfisata}</time> · {t(locale, 'recenzii.sursa')}</span>
    </span>
  </footer>
</article>

<style>
  .card-recenzie {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--c-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .card-recenzie__text p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    overflow: hidden;
  }

  .card-recenzie__text--complet p {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: none;
    overflow: visible;
  }

  .card-recenzie__tot {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-weight: 700;
  }

  .card-recenzie__subsol {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--c-gray-200);
  }

  .card-recenzie__meta {
    display: block;
    color: var(--c-gray-600);
    font-size: var(--fs-sm);
  }
</style>
