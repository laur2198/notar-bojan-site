---
/**
 * Wordmark-ul gigant din prototip (docs/design-v2/prototip-acasa.html, `.wordmark`): numele
 * notarului pe un singur rând, pe toată lățimea cutiei lui: tot containerul părinte sau, cu
 * latime="62" (hero-ul și subsolul, V3b), 62% din el de la 768 px (pe mobil tot).
 * Cu `sus` (V3c, hero și subsol), deasupra apare forma juridică „Birou Individual Notarial”
 * (Funnel Display 500, clamp(1.1rem, 1.6vw, 1.6rem)), în culoarea blocului (brand-900 pe deschis,
 * alb pe închis), iar blocul e o imagine cu numele accesibil `eticheta` (denumirea oficială).
 * Fără ele, decorativ (aria-hidden), ca pe /stil/.
 *
 * Doar CSS: părintele (.wordmark-gigant) e container de dimensiune (container-type: inline-size),
 * iar mărimea fontului = 100cqi / --wordmark-k, unde k e lățimea textului în em, măsurată cu
 * fontul încărcat (Funnel Display 600, letter-spacing -0.045em; tokens.css). Fără JS, fără
 * salt de layout după încărcarea fontului (lățimea cutiei e fixă; se schimbă doar glifele).
 * Abaterea față de lățimea containerului se verifică în /stil/ (scripts/verifica-wordmark.mjs).
 */
interface Props {
  /** Textul: numele notarului, din src/content/setari/birou.yaml. */
  text: string;
  /** Lățimea cutiei, în procente din container, de la 768 px în sus (pe mobil e mereu 100%). */
  latime?: '100' | '62';
  /** Rândul de deasupra, ex. „Birou Individual Notarial” (forma juridică din denumirea oficială). */
  sus?: string;
  /** Numele accesibil al blocului (denumirea oficială completă); fără el, blocul e decorativ. */
  eticheta?: string;
  class?: string;
}

const { text, latime = '100', sus, eticheta, class: clasa } = Astro.props;
---

<div
  class:list={['wordmark-gigant', { 'wordmark-gigant--62': latime === '62' }, clasa]}
  role={eticheta ? 'img' : undefined}
  aria-label={eticheta}
  aria-hidden={eticheta ? undefined : 'true'}
>
  {sus && <span class="wordmark-gigant__sus" data-wordmark-sus>{sus}</span>}
  <span class="wordmark-gigant__text" data-wordmark-gigant>{text}</span>
</div>

<style>
  .wordmark-gigant {
    --wordmark-fractie: 1;

    container-type: inline-size;
    width: calc(100% * var(--wordmark-fractie));
  }

  @media (min-width: 48rem) {
    .wordmark-gigant--62 {
      --wordmark-fractie: 0.62;
    }
  }

  /* Rândul de sus (prototip, `.wordmark-sus`): lipit de wordmark, distanța de deasupra o dă locul (hero / subsol). */
  .wordmark-gigant__sus {
    display: block;
    margin: var(--wordmark-sus-sus, 0) 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.6vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .wordmark-gigant__text {
    display: block;
    width: max-content;
    font-family: var(--font-display);
    font-weight: var(--fw-wordmark);
    /* Fără container queries: lățimea ferestrei minus marginile containerului (aproximare). */
    font-size: calc((100vw - 2 * var(--gutter)) * var(--wordmark-fractie) / var(--wordmark-k));
    line-height: var(--lh-wordmark);
    letter-spacing: var(--ls-wordmark);
    white-space: nowrap;
    /* Spațiu sub linia de bază pentru descendente (ț, j), ca în prototip. */
    padding-bottom: 0.12em;
  }

  @supports (width: 1cqi) {
    .wordmark-gigant__text {
      font-size: calc(100cqi / var(--wordmark-k));
    }
  }
</style>
