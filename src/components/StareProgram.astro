---
/**
 * „Deschis acum · până la 17:00” / „Închis acum · deschidem luni la 09:00” /
 * „Închis astăzi – Crăciunul · …” (CLAUDE.md §8). Calculat în browser, pe fusul
 * Europe/Bucharest; fără JS nu afișează nimic (elementul rămâne `hidden`).
 */
import { LOCALE_INTL, t, zileSaptamana, type Locale } from '../i18n';
import { ziLiberaPentru, type EticheteStare, type ZiLibera, type ZiProgram } from '../lib/program';

interface Props {
  locale: Locale;
  program: readonly ZiProgram[];
  zileLibere: readonly ZiLibera[];
  class?: string;
}

const { locale, program, zileLibere, class: clasa } = Astro.props;

const etichete: EticheteStare = {
  deschisAcum: t(locale, 'program.deschisAcum'),
  panaLa: t(locale, 'program.panaLa'),
  inchisAcum: t(locale, 'program.inchisAcum'),
  inchisAstazi: t(locale, 'program.inchisAstazi'),
  deschidem: t(locale, 'program.deschidem'),
  azi: t(locale, 'program.azi'),
  maine: t(locale, 'program.maine'),
  inZiua: t(locale, 'program.inZiua'),
  laData: t(locale, 'program.laData'),
  zile: zileSaptamana(locale),
  localeData: LOCALE_INTL[locale],
};

const date = JSON.stringify({
  program: program.map(({ zi, deschidere, inchidere, inchis }) => ({ zi, deschidere, inchidere, inchis })),
  zileLibere: zileLibere.map((z) => ziLiberaPentru(z, locale)),
  etichete,
});
---

{/* Textul stă într-un singur span: un motiv marcat lang="ro" nu devine element flex separat. */}
<p class:list={['stare-program', clasa]} data-stare-program={date} hidden><span class="stare-program__text"></span></p>

<script>
  import { calculeazaStare, mesajStare, scrieCuFragmentRo, type EticheteStare, type ZiLibera, type ZiProgram } from '../lib/program';

  interface Date_ {
    program: ZiProgram[];
    zileLibere: ZiLibera[];
    etichete: EticheteStare;
  }

  const elemente = [...document.querySelectorAll<HTMLElement>('[data-stare-program]')];

  function actualizeaza() {
    const acum = new Date();
    for (const el of elemente) {
      const { program, zileLibere, etichete } = JSON.parse(el.dataset.stareProgram ?? '{}') as Date_;
      const stare = calculeazaStare(acum, program, zileLibere);
      const motivRo = stare.tip === 'inchis' && zileLibere.some((z) => z.motivRo && z.motiv === stare.motiv) ? stare.motiv : undefined;
      scrieCuFragmentRo(el.querySelector<HTMLElement>('.stare-program__text') ?? el, mesajStare(stare, etichete), motivRo);
      el.dataset.tip = stare.tip;
      el.hidden = false;
    }
  }

  if (elemente.length > 0) {
    actualizeaza();
    setInterval(actualizeaza, 60_000);
  }
</script>

<style>
  /*
   * Starea se transmite prin text și prin forma iconiței, nu prin culoare (CLAUDE.md §5):
   * deschis = disc plin, în culoarea textului (ink pe deschis); închis = cerc gol, în --c-muted
   * (6.7:1 pe paper, 6.1:1 pe paper-2) sau --c-muted-dark pe fundal închis (7.9:1).
   */
  .stare-program {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
    font-weight: 600;
  }

  .stare-program[hidden] {
    display: none;
  }

  .stare-program::before {
    content: '';
    flex: none;
    width: 0.65em;
    height: 0.65em;
    border: 0.12em solid currentColor;
    border-radius: 50%;
    transform: translateY(-0.05em);
  }

  .stare-program[data-tip='deschis']::before {
    background: currentColor;
  }

  .stare-program[data-tip='inchis'] {
    color: var(--c-muted);
  }

  :global(.pe-inchis) .stare-program[data-tip='inchis'] {
    color: var(--c-muted-dark);
  }
</style>
