---
/**
 * Metadate SEO (CLAUDE.md §9): title, description, canonical, Open Graph,
 * hreflang pe perechile din routeMap și `noindex` în preview.
 * og:image: imaginea dată (ex. fotografia din hero pe Acasă) sau cea implicită, /og/{limba}.png.
 */
import { localeDinCale, normalizeazaCale, perecheLimbi, type Locale } from '../i18n';
import { estePreview } from '../lib/continut';
import { imagineOgImplicita, type ImagineOg } from '../lib/og';
import { url } from '../lib/url';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  numeSite: string;
  /** Pagini care nu se indexează în niciun mod (ex. 404): `noindex`, fără canonical. */
  noindex?: boolean;
  /** Denumirea oficială a biroului, pentru textul alternativ al imaginii implicite. */
  denumire: string;
  imagine?: ImagineOg;
}

const { locale, title, description, numeSite, noindex = false, denumire, imagine = imagineOgImplicita(locale, denumire) } = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
/** Calea logică (fără bază); adresele absolute o primesc înapoi prin `url()`. */
const caleCurenta = normalizeazaCale(Astro.url.pathname);
const absolut = (cale: string) => new URL(url(cale), site).href;
const canonical = absolut(caleCurenta);
const pereche = perecheLimbi(caleCurenta);

const OG_LOCALE: Record<Locale, string> = { ro: 'ro_RO', en: 'en_US' };
const alternativ: Locale = locale === 'ro' ? 'en' : 'ro';

if (localeDinCale(caleCurenta) !== locale) {
  throw new Error(`Pagina ${caleCurenta} are locale="${locale}", dar calea indică „${localeDinCale(caleCurenta)}”.`);
}
---

<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{(estePreview || noindex) && <meta name="robots" content="noindex, nofollow" />}

{
  pereche && !noindex && (
    <>
      <link rel="alternate" hreflang="ro" href={absolut(pereche.ro)} />
      <link rel="alternate" hreflang="en" href={absolut(pereche.en)} />
      <link rel="alternate" hreflang="x-default" href={absolut(pereche.ro)} />
    </>
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={numeSite} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={OG_LOCALE[locale]} />
{pereche && <meta property="og:locale:alternate" content={OG_LOCALE[alternativ]} />}
<meta property="og:image" content={new URL(imagine.src, site).href} />
<meta property="og:image:type" content={imagine.tip} />
<meta property="og:image:width" content={String(imagine.latime)} />
<meta property="og:image:height" content={String(imagine.inaltime)} />
<meta property="og:image:alt" content={imagine.alt} />
<meta name="twitter:card" content="summary_large_image" />
