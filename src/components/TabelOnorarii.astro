---
/**
 * Tabelul „Onorarii orientative” (serviciu / onorariu). Pe ecrane late e tabel; pe mobil
 * fiecare rând devine o pereche „serviciu – onorariu”, fără scroll orizontal. Rolurile ARIA
 * explicite păstrează semantica de tabel și când CSS-ul schimbă afișarea (Safari o pierde altfel).
 * Onorariile vin exclusiv din preturi/ro.yaml; marcajele «DE COMPLETAT» se afișează marcate.
 */
import { t, type Locale } from '../i18n';
import { marcheazaPlaceholder } from '../lib/continut';

interface Props {
  locale: Locale;
  titluId: string;
  randuri: { serviciu: string; href?: string; onorariu: string }[];
}

const { locale, titluId, randuri } = Astro.props;
---

<table class="onorarii" role="table" aria-labelledby={titluId}>
  <thead role="rowgroup">
    <tr role="row">
      <th scope="col" role="columnheader">{t(locale, 'servicii.coloanaServiciu')}</th>
      <th scope="col" role="columnheader">{t(locale, 'servicii.coloanaOnorariu')}</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {
      randuri.map((r) => (
        <tr role="row">
          <th scope="row" role="rowheader">
            {r.href ? <a href={r.href}>{r.serviciu}</a> : r.serviciu}
          </th>
          <td role="cell" set:html={marcheazaPlaceholder(r.onorariu)} />
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .onorarii {
    width: 100%;
    border-collapse: collapse;
    background: var(--c-paper);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  th,
  td {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--c-line);
  }

  thead th {
    background: var(--c-paper-2);
    color: var(--c-ink);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  tbody th {
    width: 40%;
    font-weight: 700;
  }

  tbody th a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-block: calc(-1 * var(--space-1));
    color: var(--c-ink);
  }

  /* Mobil: fiecare rând e o pereche, una sub alta; antetul rămâne pentru cititoarele de ecran. */
  @media (max-width: 47.99rem) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    table,
    tbody,
    tr,
    th,
    td {
      display: block;
      width: 100%;
    }

    tbody tr {
      padding: var(--space-2);
      border-bottom: 1px solid var(--c-line);
    }

    tbody tr:last-child {
      border-bottom: 0;
    }

    tbody th,
    tbody td {
      width: 100%;
      padding: 0;
      border: 0;
    }

    tbody td {
      margin-top: calc(var(--space-1) / 2);
    }
  }
</style>
