---
/**
 * Întrebările frecvente pe Acasă (prototip, `.faq`; CLAUDE.md §4): secțiune deschisă, --c-paper
 * (V3d: alternanța paper / paper-2 a secțiunilor deschise); iconița +/− în --c-rosu. Stânga titlul
 * mare (rânduri din mască, data-reveal), dreapta acordeonul cu întrebările evidențiate din
 * faq/{limba}.yaml, în ListaIntrebari (același acordeon ca pe /intrebari-frecvente/), cu un
 * singur răspuns deschis odată (`exclusiv`).
 * Apoi CtaFinal (banda roșie vie, aceeași ca la finalul paginilor interioare), cu textele `cta`.
 */
import { t, type Locale } from '../../i18n';
import { marcheazaPlaceholder, type Birou } from '../../lib/continut';
import CtaFinal from '../CtaFinal.astro';
import FundalViu from '../FundalViu.astro';
import ListaIntrebari from '../ListaIntrebari.astro';
import Eticheta from './Eticheta.astro';

interface Props {
  locale: Locale;
  birou: Birou;
  titlu: string;
  intrebari: { intrebare: string; raspuns: string }[];
  ctaTitlu: string;
  ctaSubtitlu: string;
}

const { locale, birou, titlu, intrebari, ctaTitlu, ctaSubtitlu } = Astro.props;
---

<section class="faq" id="faq" data-tema-sectiune="light" aria-labelledby="faq-titlu">
  <FundalViu intensitate="discret" seed={4} />
  <div class="container">
    <Eticheta text={t(locale, 'nav.faq')} nivel="p" />
    <div class="faq__grila">
      <h2 class="faq__titlu" id="faq-titlu" data-reveal set:html={marcheazaPlaceholder(titlu)} />
      <ListaIntrebari intrebari={intrebari} exclusiv="faq-acasa" class="faq__lista" />
    </div>
  </div>
</section>
<CtaFinal locale={locale} birou={birou} titlu={ctaTitlu} subtitlu={ctaSubtitlu} />

<style>
  .faq {
    position: relative;
    padding-bottom: var(--section-y);
    background: var(--c-paper);
    color: var(--c-ink);
  }

  .faq__grila {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3em;
  }

  .faq__titlu {
    margin: 0;
    color: var(--c-ink);
    font-size: var(--fs-titlu);
    line-height: var(--lh-titlu);
    letter-spacing: var(--ls-titlu);
  }

  @media (max-width: 61.99rem) {
    .faq__grila {
      grid-template-columns: 1fr;
    }
  }
</style>
