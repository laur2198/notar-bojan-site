---
/**
 * Serviciile de pe Acasă (prototip, `.servicii`): eticheta + linie, apoi serviciile evidențiate în
 * ListaNumerotata, varianta `mare` (fotografie 16:10 cu parallax, numărul în roșu, titlul cu
 * săgeată, rezumatul și etichetele; aceeași componentă ca pe /servicii/). La final, textul despre
 * paginile serviciilor și Buton „Toate serviciile”.
 */
import type { ImageMetadata } from 'astro';
import { cale, t, type Locale } from '../../i18n';
import { marcheazaPlaceholder } from '../../lib/continut';
import Buton from '../Buton.astro';
import DraftBadge from '../DraftBadge.astro';
import FundalViu from '../FundalViu.astro';
import ListaNumerotata from '../ListaNumerotata.astro';
import Eticheta from './Eticheta.astro';

export interface ServiciuRand {
  titlu: string;
  rezumat: string;
  href: string;
  etichete?: string[];
  imagine?: ImageMetadata;
  imagineAlt?: string;
  /** Fotografie de stoc provizorie (eticheta „Fotografie provizorie” în preview). */
  provizorie?: boolean;
}

interface Props {
  locale: Locale;
  titlu: string;
  text: string;
  servicii: ServiciuRand[];
  draft: boolean;
}

const { locale, titlu, text, servicii, draft } = Astro.props;
---

<section class="servicii" id="servicii" data-tema-sectiune="light" aria-labelledby="servicii-titlu">
  <FundalViu intensitate="discret" seed={2} />
  <div class="container">
    <Eticheta text={titlu} id="servicii-titlu" />
    <DraftBadge locale={locale} draft={draft} />
    <ListaNumerotata
      locale={locale}
      varianta="mare"
      prefix="serv"
      elemente={servicii.map((s) => ({
        titlu: s.titlu,
        text: s.rezumat,
        href: s.href,
        etichete: s.etichete,
        imagine: s.imagine,
        imagineAlt: s.imagineAlt,
        provizorie: s.provizorie,
      }))}
    />
    <div class="servicii__toate">
      <p set:html={marcheazaPlaceholder(text)} />
      <Buton text={t(locale, 'acasa.toateServiciileScurt')} href={cale('servicii', locale)} />
    </div>
  </div>
</section>

<style>
  .servicii {
    position: relative;
    overflow: hidden;
    padding-bottom: calc(var(--section-y) * 1.4);
    background: var(--c-paper);
    color: var(--c-ink);
  }

  .servicii__toate {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    padding-top: 2.5em;
    border-top: 1px solid var(--c-line);
  }

  .servicii__toate p {
    max-width: 30em;
    margin: 0;
    color: var(--c-muted);
  }

</style>
