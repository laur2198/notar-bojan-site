---
/**
 * Hero-ul paginii Acasă (CLAUDE.md §5; V3b, V3d): deschis, pe tot ecranul de la încărcare.
 *   - sus, de la 992 px pe două coloane: stânga blocul de titlu (h1 + subtitlul <p> în --c-muted,
 *     amândouă inline, ca textul să curgă într-un singur paragraf; max. ~50% din lățime; h1-ul
 *     conține doar titlul, pentru SEO) și sub el linia roșie scurtă (3 px), centrate vertical față
 *     de fotografie (V3d: fără semnătură, coloana nu mai are gol jos); dreapta fotografia biroului
 *     (4:5, înălțimea limitată ca wordmark-ul să rămână vizibil complet la 1280×720 și 1440×900).
 *     Sub 992 px: h1 → linia roșie → fotografia (4:3, pe toată lățimea).
 *   - jos, pe toată lățimea: linia (dividerul roșu) și wordmark-ul gigant (V3e: fără rândul
 *     „Notar public · …” și adresa de deasupra liniei; fotografia crește cu spațiul eliberat)
 *     (62% din lățime de la 768 px). Blocul de jos are parallax la ieșire (yPercent 0 → 40).
 *   - fundal: FundalViu puternic (seed 1, cu cursor): pete difuze roșu / piersică / auriu, mișcate
 *     doar de scroll și de cursor, niciodată singure (WCAG 2.2.2).
 * Fotografia: astro:assets (<Picture>, AVIF/WebP, srcset, width/height), încărcată imediat, cu
 * prioritate mare (e LCP). Până vine fotografia reală: placeholder cald cu eticheta „Fotografie
 * birou – urmează” (marcat «DE COMPLETAT» în preview). Pe /en/ se folosește aceeași fotografie,
 * cu textul alternativ din pagina engleză.
 * Mișcarea o pornește src/scripts/miscare.ts ([data-hero]) la încărcare: titlul pe rânduri, liniile
 * trase, fotografia descoperită de jos în sus (clip-path, 1 s, expo.out) și
 * parallax-ul ei interior la ieșire (yPercent 0 → 8). Fără JS și la mișcare redusă totul e vizibil.
 * Fără butoane: telefonul și „Programare” sunt în navbar și în bara de jos (§4).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { t, type Locale } from '../../i18n';
import { estePreview, marcheazaPlaceholder, textAlt, type Birou } from '../../lib/continut';
import FotoProvizorie from '../FotoProvizorie.astro';
import FundalViu from '../FundalViu.astro';
import { imparteDenumirea } from '../../lib/denumire';
import WordmarkGigant from '../WordmarkGigant.astro';

interface Props {
  locale: Locale;
  birou: Birou;
  titlu: string;
  subtitlu: string;
  imagine?: ImageMetadata;
  imagineAlt: string;
  /** Fotografie de stoc provizorie (eticheta „Fotografie provizorie” în preview). */
  provizorie?: boolean;
}

const { locale, birou, titlu, subtitlu, imagine, imagineAlt, provizorie = false } = Astro.props;
/** Textul alternativ fără marcajele «DE COMPLETAT» / «DE VALIDAT» (atributul alt nu poate conține HTML). */
const alt = textAlt(imagineAlt);
---

<section class="hero" id="sus" data-hero data-tema-sectiune="light" aria-labelledby="hero-titlu">
  <FundalViu intensitate="puternic" seed={1} cursor />
  <div class="container hero__interior">
    <div class="hero__sus">
      <div class="hero__text">
        <slot />
        {/* h1 și subtitlul sunt inline în același bloc: arată ca un singur paragraf în două tonuri. */}
        <div class="hero__titlu-bloc" data-hero-titlu>
          <h1 class="hero__titlu" id="hero-titlu" set:html={marcheazaPlaceholder(titlu)} />
          <p class="hero__subtitlu" set:html={marcheazaPlaceholder(subtitlu)} />
        </div>
        <div class="hero__accent" data-hero-accent aria-hidden="true"></div>
      </div>
      <div class="hero__foto" data-hero-foto>
        <FotoProvizorie locale={locale} provizorie={provizorie && !!imagine} />
        <div class="hero__foto-cadru" data-parallax-iesire="8">
          {
            imagine ? (
              <Picture
                src={imagine}
                alt={alt}
                formats={['avif', 'webp']}
                widths={[480, 720, 960, 1280, 1600].filter((w) => w <= imagine.width)}
                sizes="(min-width: 62rem) 32vw, 100vw"
                loading="eager"
                fetchpriority="high"
                class="hero__img"
              />
            ) : (
              <div class="hero__placeholder">
                {estePreview ? (
                  <mark class="todo">{t(locale, 'acasa.fotoHero')}</mark>
                ) : (
                  <span>{t(locale, 'acasa.fotoHero')}</span>
                )}
              </div>
            )
          }
        </div>
      </div>
    </div>
    <div class="hero__jos" data-parallax-iesire="40">
      <div class="hero__divider" data-hero-divider aria-hidden="true"></div>
      <div data-hero-wordmark>
        <WordmarkGigant
          text={birou.notar}
          sus={imparteDenumirea(birou.denumire, birou.notar).sus}
          eticheta={birou.denumire}
          latime="62"
          class="hero__wordmark"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* Urcă sub navbar-ul transparent (global.css, main). */
    margin-top: calc(-1 * var(--h-antet));
    background: var(--c-paper);
    color: var(--c-ink);
  }

  .hero__interior {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    /* Tot ecranul; pe mobil fără bara de jos. */
    min-height: calc(100svh - var(--inaltime-bara) - env(safe-area-inset-bottom, 0px));
    padding-top: calc(var(--h-antet) + var(--space-3));
    /*
     * V5: sub wordmark-ul maro rămâne mereu alb înainte de frazele roșii (maroul nu stă lipit de
     * roșu): cel puțin deplasarea maximă a parallax-ului de ieșire (40% din blocul de jos, care e
     * ~7.2% din container + ~2rem) plus ~1rem de alb.
     */
    padding-bottom: calc(0.03 * min(100vw, 78rem) + 2.5rem);
  }

  @media (min-width: 48rem) {
    .hero__interior {
      min-height: 100svh;
    }
  }

  /* Mobil și tabletă: h1 (+ linia roșie) → fotografie (4:3). */
  .hero__sus {
    display: grid;
    grid-template-areas:
      'text'
      'foto';
    gap: var(--space-3);
    align-items: start;
  }

  .hero__text {
    grid-area: text;
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  /* Tipografia de h1 stă pe bloc; h1 și <p> o moștenesc și curg inline, unul după altul. */
  .hero__titlu-bloc {
    max-width: 24em;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: var(--fw-titlu);
    line-height: var(--lh-titlu-mare);
    letter-spacing: var(--ls-titlu-mare);
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  .hero__titlu,
  .hero__subtitlu {
    display: inline;
    max-width: none;
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
  }

  .hero__subtitlu {
    color: var(--c-muted);
  }

  .hero__foto {
    grid-area: foto;
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 0.25em;
    background: var(--c-rosu-50);
  }

  /* Cadrul e mai înalt decât fereastra fotografiei, ca parallax-ul (yPercent 0 → 8) să nu lase gol. */
  .hero__foto-cadru {
    position: absolute;
    inset: -12% 0 0 0;
  }

  /* <picture> e inline: fără înălțime, imaginea ar rămâne la raportul ei și ar lăsa gol jos. */
  .hero__foto-cadru :global(picture) {
    display: block;
    height: 100%;
  }

  .hero__foto-cadru :global(.hero__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Placeholder cald până la fotografia reală, din tokenuri: text --c-ink ≥ 11:1 și pe capătul cel mai închis. */
  .hero__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 12% var(--space-3) 0;
    background: linear-gradient(160deg, var(--c-rosu-50) 0%, color-mix(in srgb, var(--c-rosu-50), var(--c-rosu-300) 45%) 100%);
    color: var(--c-ink);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-align: center;
  }

  /*
   * Desktop: titlul în stânga, fotografia în dreapta. Fără semnătură (V3d), blocul de titlu stă
   * centrat vertical față de fotografie, ca stânga să nu rămână goală jos.
   */
  @media (min-width: 62rem) {
    .hero__sus {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'text foto';
      column-gap: var(--space-5);
    }

    .hero__text {
      align-self: center;
      gap: var(--space-3);
    }

    /*
     * Înălțimea fotografiei: ce rămâne din ecran după navbar, spațiile și blocul de jos (linia și
     * wordmark-ul, care e ~7% din lățimea containerului; V3e: fără rândul de deasupra liniei; V5: plus
     * spațiul alb de sub wordmark, ~3% din container + 2.5rem), ca wordmark-ul să rămână vizibil
     * complet la încărcare (1280×720, 1440×900). Lățimea urmează din raportul 4:5.
     */
    .hero__foto {
      justify-self: end;
      width: auto;
      height: clamp(15rem, calc(100svh - var(--h-antet) - 9rem - 0.102 * min(100vw, 78rem)), 40rem);
      aspect-ratio: 4 / 5;
    }
  }

  .hero__jos {
    position: relative;
  }

  .hero__divider {
    height: 1px;
    background: var(--c-rosu);
    transform-origin: left center;
  }

  /* Linia de sub h1: roșul, 3 px, scurtă (V3d; decorativă). */
  .hero__accent {
    width: 4.5rem;
    height: 3px;
    background: var(--c-rosu);
    transform-origin: left center;
  }

  /* Distanța linie → „Birou Individual Notarial”: 1.1em din rândul de sus, ca în prototip. */
  .hero :global(.hero__wordmark) {
    --wordmark-sus-sus: 1.1em;
    /* V5: numele biroului în maro-lemn (12.3:1 pe alb). */
    color: var(--c-wordmark);
  }

  /*
   * Starea dinaintea intrării (doar cu JS și fără mișcare redusă, până pornește miscare.ts):
   * titlul și wordmark-ul ascunse, liniile la 0, fotografia acoperită
   * (mască de jos în sus). Plasa de siguranță din cap-pagina.js scoate `miscare` dacă modulele nu
   * pornesc.
   */
  :global(html.miscare:not(.hero-pornit)) :is([data-hero-titlu], [data-hero-wordmark]) {
    visibility: hidden;
  }

  :global(html.miscare:not(.hero-pornit)) :is([data-hero-divider], [data-hero-accent]) {
    transform: scaleX(0);
  }

  :global(html.miscare:not(.hero-pornit)) [data-hero-foto] {
    clip-path: inset(100% 0 0 0);
  }

</style>
