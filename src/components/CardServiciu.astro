---
/**
 * Card de serviciu: alb, radius-lg, umbră. Sus imaginea 16:10 (dacă serviciul are una)
 * sau o bandă paper-2 cu o linie ink de accent. Tot cardul e clicabil, cu un singur
 * link real: titlul (pseudo-element întins peste card). „Vedeți serviciul →” e doar
 * vizual (aria-hidden), ca numele accesibil al linkului să fie numele serviciului.
 *
 * Varianta cu `linkRo` (/en/services/): cardul nu e clicabil în întregime; titlul e text,
 * iar jos e un link real „Details in Romanian →” spre pagina RO a serviciului (hreflang="ro").
 */
import type { ImageMetadata } from 'astro';
import { t, type Locale } from '../i18n';
import { marcheazaPlaceholder } from '../lib/continut';
import FotoProvizorie from './FotoProvizorie.astro';
import Fotografie from './Fotografie.astro';
import Iconita from './Iconita.astro';

interface Props {
  locale: Locale;
  titlu: string;
  /** Linkul întregului card (lipsește în varianta cu `linkRo`). */
  href?: string;
  /** Ancora cardului (ex. slugul RO pe /en/services/, ținta linkurilor de pe /en/). */
  id?: string;
  /** Pagina RO a serviciului, ca link secundar explicit (pe /en/services/). */
  linkRo?: string;
  rezumat: string;
  imagine?: ImageMetadata;
  imagineAlt?: string;
  /** Fotografie de stoc provizorie (eticheta „Fotografie provizorie” în preview). */
  provizorie?: boolean;
  /** Nivelul titlului: h3 sub un h2 de secțiune. */
  nivel?: 'h2' | 'h3';
}

const { locale, titlu, href, id, linkRo, rezumat, imagine, imagineAlt, provizorie = false, nivel = 'h3' } = Astro.props;
const Titlu = nivel;
---

<article id={id} class:list={['card-serviciu', { 'card-serviciu--static': !href }]}>
  <FotoProvizorie locale={locale} provizorie={provizorie && !!imagine} />
  {
    imagine ? (
      <Fotografie
        locale={locale}
        imagine={imagine}
        alt={imagineAlt}
        raport="16 / 10"
        latimi={[400, 600, 800]}
        sizes="(min-width: 75rem) 18rem, (min-width: 48rem) 45vw, 100vw"
        class="card-serviciu__imagine"
      />
    ) : (
      <div class="card-serviciu__accent" aria-hidden="true" />
    )
  }
  <div class="card-serviciu__corp">
    <Titlu class="card-serviciu__titlu">
      {href ? <a class="card-serviciu__link" href={href}>{titlu}</a> : titlu}
    </Titlu>
    <p class="card-serviciu__rezumat" set:html={marcheazaPlaceholder(rezumat)} />
    {
      linkRo ? (
        <p class="card-serviciu__detalii">
          <a href={linkRo} hreflang="ro">
            {t(locale, 'servicii.detaliiRo')}
            <Iconita nume="sageata" />
          </a>
        </p>
      ) : (
        href && (
          <p class="card-serviciu__mai-mult" aria-hidden="true">
            {t(locale, 'servicii.vedeti')}
            <Iconita nume="sageata" />
          </p>
        )
      )
    }
  </div>
</article>

<style>
  .card-serviciu {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--c-paper);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    transition: box-shadow 150ms ease;
  }

  .card-serviciu:not(.card-serviciu--static):hover {
    box-shadow:
      var(--shadow),
      0 0 0 1px var(--c-line);
  }

  .card-serviciu :global(.card-serviciu__imagine) {
    border-radius: 0;
  }

  /* Bandă paper-2 de 8 px, cu o linie ink de 40 px ca accent. */
  .card-serviciu__accent {
    position: relative;
    height: var(--space-1);
    background: var(--c-paper-2);
  }

  .card-serviciu__accent::before {
    content: '';
    position: absolute;
    left: calc(var(--space-2) * 1.25);
    bottom: 0;
    width: calc(var(--space-4) * 1.25);
    height: 3px;
    background: var(--c-ink);
  }

  .card-serviciu__corp {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-1);
    padding: calc(var(--space-2) * 1.25);
  }

  .card-serviciu__titlu {
    font-size: var(--fs-base);
    font-weight: 700;
    line-height: 1.3;
  }

  .card-serviciu__link {
    color: var(--c-ink);
    text-decoration: none;
  }

  /* Tot cardul e zona de click a linkului. */
  .card-serviciu__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .card-serviciu__link:hover {
    color: var(--c-ink);
  }

  .card-serviciu:hover .card-serviciu__link {
    text-decoration: underline;
    text-decoration-color: var(--c-ink);
  }

  /*
   * Focus: conturul înconjoară tot cardul, nu doar titlul. Se pune pe card (prin :has),
   * pentru că `overflow: hidden` ar tăia un contur desenat în afara pseudo-elementului.
   * Rezervă fără :has: inel în interiorul cardului, pe pseudo-element.
   */
  .card-serviciu__link:focus-visible {
    outline: none;
  }

  .card-serviciu:has(.card-serviciu__link:focus-visible) {
    outline: 3px solid var(--c-ink);
    outline-offset: 3px;
  }

  @supports not selector(:has(*)) {
    .card-serviciu__link:focus-visible::after {
      outline: 3px solid var(--c-ink);
      outline-offset: -3px;
    }
  }

  .card-serviciu__rezumat {
    flex: 1;
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }

  .card-serviciu__mai-mult {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-1) * 0.75);
    margin-top: var(--space-1);
    color: var(--c-ink);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .card-serviciu__detalii {
    margin-top: var(--space-1);
  }

  .card-serviciu__detalii a {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-1) * 0.75);
    min-height: 48px;
    color: var(--c-ink);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .card-serviciu__detalii :global(.iconita) {
    color: var(--c-ink);
  }

  /* Cardul are overflow: hidden; conturul de focus se desenează în interior, ca să nu fie tăiat. */
  .card-serviciu__detalii a:focus-visible {
    outline-offset: -3px;
  }

  .card-serviciu__mai-mult :global(.iconita) {
    color: var(--c-ink);
  }
</style>
