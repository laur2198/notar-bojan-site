---
/**
 * Card de serviciu: alb, radius-lg, umbră. Sus imaginea 16:10 (dacă serviciul are una)
 * sau o bandă gray-50 cu o linie bordo de accent. Tot cardul e clicabil, cu un singur
 * link real: titlul (pseudo-element întins peste card). „Vedeți serviciul →” e doar
 * vizual (aria-hidden), ca numele accesibil al linkului să fie numele serviciului.
 */
import type { ImageMetadata } from 'astro';
import { t, type Locale } from '../i18n';
import { marcheazaPlaceholder } from '../lib/continut';
import Fotografie from './Fotografie.astro';
import Iconita from './Iconita.astro';

interface Props {
  locale: Locale;
  titlu: string;
  href: string;
  rezumat: string;
  imagine?: ImageMetadata;
  imagineAlt?: string;
  /** Nivelul titlului: h3 sub un h2 de secțiune. */
  nivel?: 'h2' | 'h3';
  /** Textul de onorariu din preturi/ro.yaml (pe /servicii/). */
  onorariu?: string;
}

const { locale, titlu, href, rezumat, imagine, imagineAlt, nivel = 'h3', onorariu } = Astro.props;
const Titlu = nivel;
---

<article class="card-serviciu">
  {
    imagine ? (
      <Fotografie
        locale={locale}
        imagine={imagine}
        alt={imagineAlt}
        raport="16 / 10"
        latimi={[400, 600, 800]}
        sizes="(min-width: 75rem) 18rem, (min-width: 48rem) 45vw, 100vw"
        class="card-serviciu__imagine"
      />
    ) : (
      <div class="card-serviciu__accent" aria-hidden="true" />
    )
  }
  <div class="card-serviciu__corp">
    <Titlu class="card-serviciu__titlu">
      <a class="card-serviciu__link" href={href}>{titlu}</a>
    </Titlu>
    <p class="card-serviciu__rezumat" set:html={marcheazaPlaceholder(rezumat)} />
    {
      onorariu && (
        <p class="card-serviciu__onorariu">
          <Iconita nume="onorariu" />
          <span>
            <span class="card-serviciu__onorariu-eticheta">{t(locale, 'servicii.onorariuCard')}</span>{' '}
            <span set:html={marcheazaPlaceholder(onorariu)} />
          </span>
        </p>
      )
    }
    <p class="card-serviciu__mai-mult" aria-hidden="true">
      {t(locale, 'servicii.vedeti')}
      <Iconita nume="sageata" />
    </p>
  </div>
</article>

<style>
  .card-serviciu {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--c-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    transition: box-shadow 150ms ease;
  }

  .card-serviciu:hover {
    box-shadow:
      var(--shadow),
      0 0 0 1px var(--c-gray-200);
  }

  .card-serviciu :global(.card-serviciu__imagine) {
    border-radius: 0;
  }

  /* Bandă gray-50 de 8 px, cu o linie bordo de 40 px ca accent. */
  .card-serviciu__accent {
    position: relative;
    height: var(--space-1);
    background: var(--c-gray-50);
  }

  .card-serviciu__accent::before {
    content: '';
    position: absolute;
    left: calc(var(--space-2) * 1.25);
    bottom: 0;
    width: calc(var(--space-4) * 1.25);
    height: 3px;
    background: var(--c-red-700);
  }

  .card-serviciu__corp {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-1);
    padding: calc(var(--space-2) * 1.25);
  }

  .card-serviciu__titlu {
    font-size: var(--fs-base);
    font-weight: 700;
    line-height: 1.3;
  }

  .card-serviciu__link {
    color: var(--c-wood-900);
    text-decoration: none;
  }

  /* Tot cardul e zona de click a linkului. */
  .card-serviciu__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .card-serviciu__link:hover {
    color: var(--c-wood-900);
  }

  .card-serviciu:hover .card-serviciu__link {
    text-decoration: underline;
    text-decoration-color: var(--c-red-700);
  }

  /*
   * Focus: conturul înconjoară tot cardul, nu doar titlul. Se pune pe card (prin :has),
   * pentru că `overflow: hidden` ar tăia un contur desenat în afara pseudo-elementului.
   * Rezervă fără :has: inel în interiorul cardului, pe pseudo-element.
   */
  .card-serviciu__link:focus-visible {
    outline: none;
  }

  .card-serviciu:has(.card-serviciu__link:focus-visible) {
    outline: 3px solid var(--c-focus);
    outline-offset: 3px;
  }

  @supports not selector(:has(*)) {
    .card-serviciu__link:focus-visible::after {
      outline: 3px solid var(--c-focus);
      outline-offset: -3px;
    }
  }

  .card-serviciu__rezumat {
    flex: 1;
    color: var(--c-gray-600);
    font-size: var(--fs-sm);
  }

  .card-serviciu__onorariu {
    display: flex;
    align-items: flex-start;
    gap: var(--space-1);
    padding-top: var(--space-1);
    border-top: 1px solid var(--c-gray-200);
    color: var(--c-gray-900);
    font-size: var(--fs-sm);
  }

  .card-serviciu__onorariu :global(.iconita) {
    margin-top: calc(var(--space-1) / 4);
    color: var(--c-wood-800);
  }

  .card-serviciu__onorariu-eticheta {
    font-weight: 700;
  }

  .card-serviciu__mai-mult {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-1) * 0.75);
    margin-top: var(--space-1);
    color: var(--c-wood-800);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .card-serviciu__mai-mult :global(.iconita) {
    color: var(--c-red-700);
  }
</style>
