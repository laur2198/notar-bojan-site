---
/** Litera „G” a Google, decorativă (aria-hidden), lângă ratingul și linkul spre recenzii. */
interface Props {
  class?: string;
}
const { class: clasa } = Astro.props;
---

<svg class:list={['logo-google', clasa]} viewBox="0 0 48 48" width="24" height="24" aria-hidden="true" focusable="false">
  <path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8c-.5 2.8-2.1 5.1-4.4 6.7v5.6h7.1c4.2-3.8 6.6-9.5 6.6-16.3z"></path>
  <path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.3l-7.1-5.6c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.5-3.8-12.2-9H4.5v5.8C8.1 41.1 15.5 46 24 46z"></path>
  <path fill="#FBBC05" d="M11.8 28.2c-.4-1.3-.7-2.7-.7-4.2s.3-2.9.7-4.2V14H4.5C3 17 2.2 20.4 2.2 24s.8 7 2.3 10l7.3-5.8z"></path>
  <path fill="#EA4335" d="M24 10.8c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3C34.9 4.2 29.9 2 24 2 15.5 2 8.1 6.9 4.5 14l7.3 5.8c1.7-5.2 6.5-9 12.2-9z"></path>
</svg>

<style>
  .logo-google {
    flex: none;
    width: 1.5em;
    height: 1.5em;
  }
</style>
