---
/**
 * Banda de titlu a paginilor interioare: pe paper-2, cu breadcrumbs (opțional),
 * slot pentru DraftBadge, h1 și lead. Conținutul paginii urmează pe alb.
 * Fără imagine mare în antet.
 */
import type { Locale } from '../i18n';
import Breadcrumbs, { type Firimitura } from './Breadcrumbs.astro';

interface Props {
  locale: Locale;
  titlu: string;
  /** Lead-ul ca HTML sigur (deja trecut prin `marcheazaPlaceholder`). */
  leadHtml?: string;
  breadcrumbs?: Firimitura[];
}

const { locale, titlu, leadHtml, breadcrumbs } = Astro.props;
---

<div class="banda-titlu" data-tema-sectiune="light">
  <div class="container">
    {breadcrumbs && <Breadcrumbs locale={locale} elemente={breadcrumbs} />}
    <slot />
    <h1 class="banda-titlu__h1">{titlu}</h1>
    {leadHtml && <p class="banda-titlu__lead" set:html={leadHtml} />}
  </div>
</div>

<style>
  .banda-titlu {
    /* Urcă sub navbar-ul transparent (global.css, main). */
    margin-top: calc(-1 * var(--h-antet));
    padding-block: calc(var(--h-antet) + var(--space-3)) var(--section-y-sm);
    background: var(--c-paper-2);
    border-bottom: 1px solid var(--c-line);
  }

  .banda-titlu__h1 {
    margin-top: var(--space-2);
  }

  .banda-titlu__lead {
    margin-top: var(--space-2);
    color: var(--c-muted);
    font-size: var(--fs-base);
  }
</style>
