---
/**
 * Ratingul Google (/recenzii/), V4: logo, cifra mare, stelele în --c-rosu și textul ratingului
 * vizibil („Nota: 4,8 din 5 stele · N recenzii pe Google”), doar dacă `rating` și `numarRecenzii`
 * sunt completate. Altfel, doar
 * „Vedeți recenziile noastre pe Google”. Nu se afișează niciodată un rating inventat.
 */
import { formateazaNumar, t, tPlural, type Locale } from '../i18n';
import type { Birou } from '../lib/continut';
import LogoGoogle from './LogoGoogle.astro';
import Stele from './Stele.astro';

interface Props {
  locale: Locale;
  birou: Birou;
}

const { locale, birou } = Astro.props;
const areRating = birou.rating !== null && birou.numarRecenzii !== null;
const nota = areRating ? formateazaNumar(locale, birou.rating!, 1) : '';
---

<div class="card-rating">
  <LogoGoogle class="card-rating__google" />
  {
    areRating ? (
      <>
        <p class="card-rating__nota">
          <span class="card-rating__cifra" aria-hidden="true">
            {nota}
          </span>
          <Stele nota={birou.rating!} class="card-rating__stele" />
        </p>
        <p class="card-rating__text">
          {t(locale, 'recenzii.notaStele', { nota })} · {tPlural(locale, 'recenzii.numar', birou.numarRecenzii!)}
        </p>
      </>
    ) : (
      <p>{t(locale, 'recenzii.vedetiNoastre')}</p>
    )
  }
</div>

<style>
  /* V4: fără card și fără umbră; cifra mare (Funnel Display), stelele în roșu, textul ratingului vizibil. */
  .card-rating {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
  }

  .card-rating :global(.card-rating__google) {
    width: 2rem;
    height: 2rem;
  }

  .card-rating__nota {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--c-ink);
  }

  .card-rating__cifra {
    font-family: var(--font-display);
    font-size: var(--fs-statement);
    font-weight: var(--fw-titlu);
    line-height: 1;
    letter-spacing: var(--ls-titlu-mare);
  }

  .card-rating__nota :global(.card-rating__stele) {
    font-size: var(--fs-h2);
  }

  .card-rating__text {
    color: var(--c-muted);
  }
</style>
