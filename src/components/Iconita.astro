---
/**
 * Iconițe SVG inline, decorative (aria-hidden). Textul accesibil stă lângă ele.
 * Contur simplu, 24×24, culoarea textului (currentColor).
 */
interface Props {
  nume: 'telefon' | 'meniu' | 'inchide' | 'email' | 'calendar' | 'ceas' | 'pin' | 'plus' | 'sageata' | 'bifa' | 'onorariu' | 'extern' | 'info' | 'whatsapp';
  class?: string;
}

const { nume, class: clasa } = Astro.props;

const trasee: Record<Props['nume'], string> = {
  telefon:
    'M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z',
  meniu: 'M4 6h16M4 12h16M4 18h16',
  inchide: 'M6 6l12 12M18 6L6 18',
  email: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 7l9 6 9-6',
  calendar: 'M5 5h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM16 3v4M8 3v4M4 10h16M8 14h2M14 14h2M8 17h2',
  ceas: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2',
  pin: 'M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  plus: 'M12 7v10M7 12h10',
  sageata: 'M5 12h14M13 6l6 6-6 6',
  bifa: 'M5 12.5l4.5 4.5L19 7.5',
  onorariu: 'M6 3h9l4 4v14H6zM15 3v4h4M9 12h7M9 16h7M9 8h3',
  extern: 'M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5',
  info: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 11v6M12 7.5v.5',
  // Gliful oficial WhatsApp (Simple Icons, CC0), monocrom: e plin, nu contur (vezi PLINE).
  whatsapp:
    'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z',
};

/** Iconițele desenate plin (glife de marcă), nu cu contur. */
const PLINE: ReadonlySet<Props['nume']> = new Set(['whatsapp']);
const plin = PLINE.has(nume);
---

<svg
  class:list={['iconita', { 'iconita--plina': plin }, clasa]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill={plin ? 'currentColor' : 'none'}
  stroke={plin ? 'none' : 'currentColor'}
  stroke-width={plin ? undefined : 2}
  stroke-linecap={plin ? undefined : 'round'}
  stroke-linejoin={plin ? undefined : 'round'}
  aria-hidden="true"
  focusable="false"
>
  <path d={trasee[nume]}></path>
</svg>

<style>
  .iconita {
    flex: none;
    width: 1.25em;
    height: 1.25em;
  }
</style>
