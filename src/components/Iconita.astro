---
/**
 * Iconițe SVG inline, decorative (aria-hidden). Textul accesibil stă lângă ele.
 * Contur simplu, 24×24, culoarea textului (currentColor).
 */
interface Props {
  nume: 'telefon' | 'meniu' | 'inchide';
  class?: string;
}

const { nume, class: clasa } = Astro.props;

const trasee: Record<Props['nume'], string> = {
  telefon:
    'M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z',
  meniu: 'M4 6h16M4 12h16M4 18h16',
  inchide: 'M6 6l12 12M18 6L6 18',
};
---

<svg
  class:list={['iconita', clasa]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={trasee[nume]}></path>
</svg>

<style>
  .iconita {
    flex: none;
    width: 1.25em;
    height: 1.25em;
  }
</style>
