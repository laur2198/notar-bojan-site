---
/**
 * Iconițe SVG inline, decorative (aria-hidden). Textul accesibil stă lângă ele.
 * Contur simplu, 24×24, culoarea textului (currentColor).
 */
interface Props {
  nume: 'telefon' | 'meniu' | 'inchide' | 'email' | 'calendar' | 'ceas' | 'pin' | 'plus' | 'sageata' | 'bifa' | 'onorariu' | 'extern' | 'info';
  class?: string;
}

const { nume, class: clasa } = Astro.props;

const trasee: Record<Props['nume'], string> = {
  telefon:
    'M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z',
  meniu: 'M4 6h16M4 12h16M4 18h16',
  inchide: 'M6 6l12 12M18 6L6 18',
  email: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 7l9 6 9-6',
  calendar: 'M5 5h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM16 3v4M8 3v4M4 10h16M8 14h2M14 14h2M8 17h2',
  ceas: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2',
  pin: 'M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  plus: 'M12 7v10M7 12h10',
  sageata: 'M5 12h14M13 6l6 6-6 6',
  bifa: 'M5 12.5l4.5 4.5L19 7.5',
  onorariu: 'M6 3h9l4 4v14H6zM15 3v4h4M9 12h7M9 16h7M9 8h3',
  extern: 'M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5',
  info: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 11v6M12 7.5v.5',
};
---

<svg
  class:list={['iconita', clasa]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={trasee[nume]}></path>
</svg>

<style>
  .iconita {
    flex: none;
    width: 1.25em;
    height: 1.25em;
  }
</style>
