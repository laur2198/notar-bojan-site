---
/**
 * Semnătura decorativă „Notar 🤝 Bojan” (aria-hidden; numele biroului rămâne în h1).
 * src/assets/semnatura.svg e pus de birou / designer și se include ca atare (?raw), fără să i se
 * modifice geometria: literele (Imperial Script) și mâinile (Vecteezy) sunt contururi umplute
 * cu currentColor, descoperite de măști (#m-notar, #m-maini, #m-bojan) ale căror path-uri .rev
 * se desenează (licențe în docs/licente.md). Citirea și pregătirea: src/lib/semnatura.ts.
 *
 * Două SVG-uri pe instanță, alese din CSS:
 *   - ≥ 640 px: semnătura întreagă;
 *   - < 640 px: doar mâinile (viewBox decupat pe ele), animate; fără litere.
 * Id-urile măștilor primesc sufixul instanței (`id`), pentru că semnătura apare de două ori pe
 * pagină (intro + hero). Pe Acasă e scrisă în HTML o singură dată (hero); intro-ul o clonează la
 * pornire și redenumește id-urile (IntroSemnatura.astro, src/scripts/intro-semnatura.ts).
 *
 * Culoarea: currentColor, din `ton`: pe deschis maroul de brand (--c-brand, CLAUDE.md §5),
 * pe închis alb (--c-paper).
 *
 * Animația (src/scripts/desen-semnatura.ts): un progres global P 0 → 1, fiecare .rev în intervalul
 * lui [data-a, data-b]. Starea din HTML e cea finală: stroke-dashoffset 0, semnătura completă.
 * Fără JS și la prefers-reduced-motion rămâne așa; scriptul o ascunde (101) doar când chiar animă.
 */
import svgSemnatura from '../assets/semnatura.svg?raw';
import { randeazaSemnatura } from '../lib/semnatura';

interface Props {
  /** Identificator unic în pagină (sufixul id-urilor și valoarea lui data-semnatura). */
  id: string;
  /** Fundalul pe care stă: deschis (maro) sau închis (alb). */
  ton?: 'deschis' | 'inchis';
  class?: string;
}

const { id, ton = 'deschis', class: clasa } = Astro.props;
const r = randeazaSemnatura(svgSemnatura, id);
---

<div class:list={['semnatura', `semnatura--${ton}`, clasa]} data-semnatura={id} aria-hidden="true">
  <svg
    class="semnatura__intreaga"
    xmlns="http://www.w3.org/2000/svg"
    viewBox={r.viewBox}
    width={r.latime}
    height={r.inaltime}
    focusable="false"
    set:html={r.intreaga}
  />
  <svg
    class="semnatura__maini"
    xmlns="http://www.w3.org/2000/svg"
    viewBox={r.viewBoxMaini}
    width={r.viewBoxMaini.split(' ')[2]}
    height={r.viewBoxMaini.split(' ')[3]}
    focusable="false"
    set:html={r.maini}
  />
</div>

<style>
  .semnatura {
    display: block;
    color: var(--c-brand);
  }

  .semnatura--inchis {
    color: var(--c-paper);
  }

  .semnatura svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .semnatura .semnatura__maini {
    display: none;
  }

  /* < 640 px: doar mâinile. */
  @media (max-width: 39.99rem) {
    .semnatura .semnatura__intreaga {
      display: none;
    }

    .semnatura .semnatura__maini {
      display: block;
    }
  }

  /* Starea din HTML: desenată complet. Scriptul pune dashoffset-ul la 101 doar când animă. */
  .semnatura :global(path[data-a]) {
    stroke-dasharray: 100 101;
    stroke-dashoffset: 0;
  }
</style>
