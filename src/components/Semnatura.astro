---
/**
 * SVG provizoriu. Se înlocuiește cu desenul final al ilustratorului (un singur path cu stroke);
 * atunci animația revine la stroke-dashoffset (helperul păstrat în src/lib/semnatura-stroke.ts).
 *
 * Semnătura decorativă (aria-hidden): src/assets/semnatura.svg, făcut manual, inclus ca atare
 * (nu se regenerează, nu se modifică). Forme UMPLUTE (fără stroke): literele din Lavishly Yours
 * și mâinile din Canva (vezi docs/licente.md). Culoarea vine din token-uri, după fundal:
 * `ton="deschis"` → --c-wood-800, `ton="inchis"` → --c-wood-300.
 *
 * Animația: dezvăluire secvențială, nu stroke. Fiecare segment (<g data-segment clip-path>) are
 * în clipPath un <rect class="wipe" data-len data-w>; un singur progres global P (0 → 1,
 * cubic-bezier(0.77, 0, 0.175, 1) pe tot gestul) dă lățimea fiecărui dreptunghi, pe intervale
 * consecutive proporționale cu data-len (src/scripts/dezvaluire-semnatura.js, requestAnimationFrame,
 * fără librării). Hero: 3.5 s, pornit de IntersectionObserver (Hero.astro). Intro: 1.8 s
 * (IntroSemnatura.astro).
 *
 * Starea din HTML e cea finală: toate dreptunghiurile au width = data-w. Fără JS și la
 * prefers-reduced-motion semnătura e complet vizibilă; JS-ul le aduce la 0 doar când animația
 * chiar rulează, înainte de primul paint (scripturi inline, fără flash).
 *
 * Id-urile clipPath-urilor se prefixează cu `semnatura-{varianta}-`, ca intro-ul și hero-ul să
 * poată fi în pagină în același timp. Cu `linie`, se adaugă linia de dedesubt la data-linie-y,
 * prelungită spre dreapta (Hero.astro o taie la lățimea containerului).
 */
import svgSemnatura from '../assets/semnatura.svg?raw';
import { citesteSemnatura, prefixeazaId } from '../lib/semnatura';

interface Props {
  varianta: 'hero' | 'intro';
  /** Fundalul pe care stă semnătura. */
  ton?: 'deschis' | 'inchis';
  /** Linia de dedesubt, la data-linie-y, pe toată lățimea containerului. */
  linie?: boolean;
}

const { varianta, ton = 'deschis', linie = false } = Astro.props;
const { viewBox, latime, inaltime, linieY, interior } = citesteSemnatura(svgSemnatura);
const continut =
  (linie
    ? `<line class="semnatura__linie" x1="0" y1="${linieY}" x2="100000" y2="${linieY}" vector-effect="non-scaling-stroke"/>`
    : '') + prefixeazaId(interior, `semnatura-${varianta}-`);
---

<svg
  class:list={['semnatura', `semnatura--${varianta}`, `semnatura--${ton}`]}
  data-semnatura={varianta}
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  width={latime}
  height={inaltime}
  aria-hidden="true"
  focusable="false"
  set:html={continut}
/>

<style>
  .semnatura {
    display: block;
    height: auto;
    max-width: 100%;
    overflow: visible;
    fill: var(--c-wood-800);
    stroke: none;
  }

  .semnatura--inchis {
    fill: var(--c-wood-300);
  }

  /* Lățimea în hero vine din Hero.astro (--semnatura-latime: 320 → 600 px). */
  .semnatura--hero {
    width: var(--semnatura-latime, 320px);
  }

  .semnatura--intro {
    width: 260px;
  }

  @media (min-width: 48rem) {
    .semnatura--intro {
      width: 420px;
    }
  }

  /* Linia de semnătură: 1 px, gri deschis atenuat (decorativă), pe fundal închis. */
  .semnatura :global(.semnatura__linie) {
    fill: none;
    stroke: color-mix(in srgb, var(--c-gray-200) 40%, transparent);
    stroke-width: 1px;
  }

  .semnatura--deschis :global(.semnatura__linie) {
    stroke: var(--c-cream-2);
  }
</style>
