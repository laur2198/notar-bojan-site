---
/**
 * Semnătura decorativă (aria-hidden): src/assets/semnatura.svg, făcut manual, inclus ca atare
 * (nu se regenerează, nu se modifică). O singură linie cu stroke: literele din Mr De Haviland și
 * un gest abstract pentru mâini (vezi docs/licente.md). Culoarea vine din token-uri, prin CSS pe
 * <svg>, după fundal: `ton="deschis"` → --c-wood-800, `ton="inchis"` → --c-wood-300.
 *
 * Animația: stroke-dashoffset 100 → 0 pe fiecare path (pathLength="100", dasharray 100 101),
 * strict secvențial de la stânga la dreapta, pe intervale consecutive proporționale cu data-len
 * (calculate la build cu src/lib/semnatura-stroke.ts și scrise pe path-uri ca data-a / data-b).
 * Un singur progres pe tot gestul, cubic-bezier(0.77, 0, 0.175, 1), requestAnimationFrame, fără
 * librării (src/scripts/desen-semnatura.js). Hero: 3.5 s, pornit de IntersectionObserver
 * (Hero.astro). Intro: 1.8 s (IntroSemnatura.astro).
 *
 * Starea din HTML e cea finală: dashoffset 0, semnătura completă. Fără JS și la
 * prefers-reduced-motion rămâne așa; scripturile inline pun dashoffset-ul la 100 doar când
 * animația chiar rulează, înainte de primul paint (fără flash).
 *
 * Id-urile din SVG (dacă desenul le are) se prefixează cu `semnatura-{varianta}-`, ca intro-ul și
 * hero-ul să poată fi în pagină în același timp. Cu `linie`, se adaugă linia de dedesubt la
 * data-linie-y, prelungită spre dreapta (Hero.astro o taie la lățimea containerului).
 */
import svgSemnatura from '../assets/semnatura.svg?raw';
import { adaugaIntervale, citesteSemnatura, prefixeazaId } from '../lib/semnatura';
import { intervaleStroke } from '../lib/semnatura-stroke';

interface Props {
  varianta: 'hero' | 'intro';
  /** Fundalul pe care stă semnătura. */
  ton?: 'deschis' | 'inchis';
  /** Linia de dedesubt, la data-linie-y, pe toată lățimea containerului. */
  linie?: boolean;
}

const { varianta, ton = 'deschis', linie = false } = Astro.props;
const { viewBox, latime, inaltime, linieY, grosime, interior, lungimi } = citesteSemnatura(svgSemnatura);
const continut =
  (linie
    ? `<line class="semnatura__linie" x1="0" y1="${linieY}" x2="100000" y2="${linieY}" vector-effect="non-scaling-stroke"/>`
    : '') + prefixeazaId(adaugaIntervale(interior, intervaleStroke(lungimi)), `semnatura-${varianta}-`);
---

<svg
  class:list={['semnatura', `semnatura--${varianta}`, `semnatura--${ton}`]}
  data-semnatura={varianta}
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  width={latime}
  height={inaltime}
  fill="none"
  stroke-width={grosime}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={continut}
/>

<style>
  .semnatura {
    display: block;
    height: auto;
    max-width: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--c-wood-800);
  }

  .semnatura--inchis {
    stroke: var(--c-wood-300);
  }

  /* Starea din HTML: desenată complet. Scripturile pun dashoffset-ul la 100 doar când animă. */
  .semnatura :global(path[data-a]) {
    stroke-dasharray: 100 101;
    stroke-dashoffset: 0;
  }

  /* Lățimea în hero vine din Hero.astro (--semnatura-latime: 320 → 600 px). */
  .semnatura--hero {
    width: var(--semnatura-latime, 320px);
  }

  .semnatura--intro {
    width: 260px;
  }

  @media (min-width: 48rem) {
    .semnatura--intro {
      width: 420px;
    }
  }

  /* Linia de semnătură: 1 px, gri deschis atenuat (decorativă), pe fundal închis. */
  .semnatura :global(.semnatura__linie) {
    fill: none;
    stroke: color-mix(in srgb, var(--c-gray-200) 40%, transparent);
    stroke-width: 1px;
  }

  .semnatura--deschis :global(.semnatura__linie) {
    stroke: var(--c-cream-2);
  }
</style>
