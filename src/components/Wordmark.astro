---
/**
 * Wordmark-ul text (logo-ul grafic vine mai târziu), folosit în header și în footer:
 * numele notarului (700) și dedesubt „Notar public · Brașov” (13 px, 500), ambele cu
 * majuscule prin CSS (textul rămâne normal pentru cititoarele de ecran).
 * Rândul de 13 px e una dintre cele două excepții sub 16 px permise de CLAUDE.md §4.
 */
import { cale, t, type Locale } from '../i18n';
import type { Birou } from '../lib/continut';

interface Props {
  locale: Locale;
  birou: Birou;
}

const { locale, birou } = Astro.props;
---

<a class="wordmark" href={cale('acasa', locale)}>
  <span class="wordmark__nume">{birou.notar}</span>
  <span class="wordmark__profesie">{t(locale, 'wordmark.profesie')} · {birou.adresa.oras}</span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 48px;
    color: var(--c-wood-900);
    text-decoration: none;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .wordmark:hover {
    color: var(--c-wood-900);
  }

  .wordmark__nume {
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .wordmark__profesie {
    /* 12 px (excepția din CLAUDE.md §4) */
    font-size: calc(var(--fs-sm) * 0.75);
    font-weight: 500;
    color: var(--c-gray-600);
  }

  .wordmark:hover .wordmark__nume {
    text-decoration: underline;
    text-decoration-color: var(--c-red-700);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  /* Sub 480 px numele se poate rupe pe două rânduri; de acolo în sus rămâne pe unul. */
  @media (min-width: 30rem) {
    .wordmark {
      white-space: nowrap;
    }

    .wordmark__nume {
      font-size: var(--fs-lg);
    }
  }

  /* Pe desktop (≥ 67rem, pragul meniului complet din Header), 17 px. */
  @media (min-width: 67rem) {
    .wordmark__nume {
      font-size: calc(var(--fs-sm) * 1.0625);
    }
  }
</style>
