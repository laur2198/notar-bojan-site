---
/**
 * Wordmark-ul text din navbar (prototip, `.nav__logo`): numele notarului cu minuscule,
 * Funnel Display 600, spațiere -0.03em, 1.15 × textul de bază. E linkul spre pagina principală;
 * numele accesibil e denumirea oficială a biroului (aria-label), nu forma stilizată.
 * Culoarea vine din tema navbar-ului (currentColor). Sub 25rem numele se poate rupe pe două rânduri.
 */
import { cale, t, type Locale } from '../i18n';
import type { Birou } from '../lib/continut';

interface Props {
  locale: Locale;
  birou: Birou;
}

const { locale, birou } = Astro.props;
---

<a class="wordmark" href={cale('acasa', locale)} aria-label={t(locale, 'wordmark.acasa', { denumire: birou.denumire })}>
  {birou.notar.toLocaleLowerCase('ro')}
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: inherit;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: inherit;
  }

  @media (max-width: 30rem) {
    .wordmark {
      font-size: var(--fs-base);
    }
  }

  @media (max-width: 25rem) {
    .wordmark {
      white-space: normal;
      max-width: 9.5em;
    }
  }
</style>
