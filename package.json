    "verifica:seo": "node scripts/verifica-seo.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/funnel-display": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "cross-env": "^10.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
